<%- include('partials/header') %>

<main class="page-main-content single-post-page">
  <div class="site-container article-layout-grid">
    <!-- Main Article Column (70%) -->
    <article class="article-main">
      <div class="article-card-box">
        <!-- Article Header -->
        <header class="article-header">
          <div class="article-meta-top">
            <a href="/author/<%= encodeURIComponent(post.author_slug || '') %>" class="article-author-name">
              <%= author ? author.display_name : (post.author_name || 'পয়স্তি লেখক') %>
            </a>
            <span class="header-meta-sep">•</span>
            <span class="article-reading-time" title="আনুমানিক পাঠের সময়">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <%= typeof readingTime !== 'undefined' ? readingTime : calculateReadingTime(post.content) %>
            </span>
          </div>
          <h1 class="article-title"><%= post.title %></h1>
        </header>

        <!-- Reader Controls Toolbar -->
        <div class="reader-toolbar" id="readerToolbar" aria-label="পড়ার সুবিধা ও কন্ট্রোল">
          <div class="reader-toolbar-left">
            <span class="reader-toolbar-label">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
              পড়ার সুবিধা
            </span>
          </div>
          <div class="reader-toolbar-right">
            <span class="reader-toolbar-label">হরফের আকার:</span>
            <div class="reader-font-controls">
              <button type="button" class="reader-font-btn" id="btnFontDec" title="ফন্ট ছোট করুন" aria-label="Decrease font size">A-</button>
              <button type="button" class="reader-font-btn" id="btnFontReset" title="স্বাভাবিক আকার" aria-label="Reset font size">A</button>
              <button type="button" class="reader-font-btn" id="btnFontInc" title="ফন্ট বড় করুন" aria-label="Increase font size">A+</button>
            </div>
          </div>
        </div>

        <!-- Featured Image -->
        <% if (post.featured_image) { %>
          <div class="article-featured-image-wrap">
            <img src="<%= post.featured_image %>" alt="<%= post.title %>" class="article-featured-img">
          </div>
        <% } %>

        <!-- Article Body Text -->
        <div class="article-content-body single-article-content-body">
          <%- renderArticleContent(post.content) %>
        </div>

        <!-- Comments Area -->
        <section class="article-comments-area" id="comments">
          <h3 class="comments-title">মন্তব্য (<%= toBengaliNumber(comments.length) %>)</h3>
          
          <% if (comments && comments.length) { %>
            <div class="comments-stream">
              <% comments.forEach(comment => { %>
                <div class="comment-item-box">
                  <div class="comment-item-header">
                    <strong class="comment-item-author"><%= comment.author_name %></strong>
                    <span class="comment-item-date"><%= formatBengaliDate(comment.created_at) %></span>
                  </div>
                  <div class="comment-item-body"><%= comment.content %></div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="no-comments-yet">এখনও কোনো মন্তব্য করা হয়নি। আপনার মূল্যবান মতামত জানান।</p>
          <% } %>

          <% if (typeof user !== 'undefined' && user) { %>
            <form action="/post/<%= encodeURIComponent(post.slug) %>/comment" method="POST" class="comment-submit-form" id="comment-form">
              <h4 class="comment-form-heading">একটি মন্তব্য লিখুন</h4>
              
              <div class="comment-logged-in-user-badge">
                <div class="comment-user-avatar">
                  <% if (user.avatar) { %>
                    <img src="<%= user.avatar %>" alt="<%= user.display_name %>">
                  <% } else { %>
                    <span><%= (user.display_name || user.username || 'প').charAt(0) %></span>
                  <% } %>
                </div>
                <div class="comment-user-info">
                  <span class="comment-user-label">মন্তব্য করছেন:</span>
                  <strong class="comment-user-name"><%= user.display_name || user.username %></strong>
                  <span class="comment-user-email">(<%= user.email %>)</span>
                </div>
              </div>

              <input type="hidden" name="author_name" value="<%= user.display_name || user.username %>">
              <input type="hidden" name="author_email" value="<%= user.email %>">

              <div class="comment-field-group">
                <textarea name="content" rows="4" placeholder="আপনার মূল্যবান মন্তব্য বা পর্যালোচনা লিখুন..." required class="comment-textarea-input"></textarea>
              </div>
              <button type="submit" class="comment-btn-submit">
                <span>💬 মন্তব্য প্রকাশ করুন</span>
              </button>
            </form>
          <% } else { %>
            <div class="comment-login-required-card" id="comment-form">
              <div class="comment-login-lock-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </div>
              <h4 class="comment-login-title">মন্তব্য করতে লগইন করুন</h4>
              <p class="comment-login-desc">এই লেখাটিতে মন্তব্য বা মতামত প্রকাশ করার জন্য আপনার অ্যাকাউন্টে লগইন থাকা আবশ্যক।</p>
              <div class="comment-login-btn-group">
                <a href="/login?redirect=<%= encodeURIComponent('/post/' + post.slug + '#comments') %>" class="comment-login-btn-primary">
                  🔑 লগইন করুন
                </a>
                <a href="/register?redirect=<%= encodeURIComponent('/post/' + post.slug + '#comments') %>" class="comment-login-btn-secondary">
                  📝 নতুন একাউন্ট খুলুন
                </a>
              </div>
            </div>
          <% } %>
        </section>
      </div>
    </article>

    <!-- Sidebar Column (30%) -->
    <aside class="article-sidebar">
      <div class="sidebar-card-widget">
        <!-- Author Profile -->
        <div class="sidebar-author-profile">
          <div class="sidebar-author-avatar-wrap">
            <% if (author && author.avatar) { %>
              <img src="<%= author.avatar %>" alt="<%= author.display_name %>" class="sidebar-author-avatar-img">
            <% } else { %>
              <div class="sidebar-author-avatar-placeholder">
                <%= author && author.display_name ? author.display_name.charAt(0) : 'প' %>
              </div>
            <% } %>
          </div>
          <div class="sidebar-author-info-wrap">
            <a href="/author/<%= encodeURIComponent(author.slug || author.username || '') %>" class="sidebar-author-name-link">
              <%= author.display_name %>
            </a>
            <% if (author.bio) { %>
              <div class="sidebar-author-bio-text">
                <%= author.bio %>
              </div>
            <% } %>
          </div>
        </div>

        <div class="sidebar-divider"></div>

        <!-- Category -->
        <div class="sidebar-meta-item">
          <a href="/category/<%= encodeURIComponent(post.category_slug || '') %>" class="sidebar-category-link">
            <%= post.category_name || 'অন্য সাহিত্য' %>
          </a>
        </div>

        <!-- Views Count -->
        <div class="sidebar-meta-item sidebar-views-row">
          <svg class="sidebar-meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" width="16" height="16" fill="currentColor">
            <path d="M288 32c-80.8 0-145.5 36.8-192.6 80.6C48.6 156 17.3 208 2.5 243.7c-3.3 7.9-3.3 16.7 0 24.6C17.3 304 48.6 356 95.4 399.4C142.5 443.2 207.2 480 288 480s145.5-36.8 192.6-80.6c46.9-43.5 78.1-95.4 93-131.1 3.3-7.9 3.3-16.7 0-24.6-14.8-35.7-46.1-87.7-93-131.1C433.5 68.8 368.8 32 288 32zM144 256a144 144 0 1 1 288 0 144 144 0 1 1 -288 0zm144-64c0 35.3-28.7 64-64 64c-7.1 0-13.9-1.2-20.3-3.3c-5.5-1.8-11.9 1.6-11.7 7.4c.3 6.9 1.3 13.8 3.2 20.7c13.7 48.4 63.6 77.2 112 63.5s77.2-63.6 63.5-112c-1.9-6.9-4.8-13.5-8.5-19.6c-3.2-5.1-9.9-6.6-14.6-3.1c-6.1 4.5-13.5 7.4-21.6 7.4c-21 0-38-17-38-38z"/>
          </svg>
          <span class="sidebar-views-count"><%= toBengaliNumber(post.views || 1) %></span>
          <span class="sidebar-views-label">বার পড়া হয়েছে</span>
        </div>

        <!-- Published Date -->
        <div class="sidebar-meta-item sidebar-date-row">
          <span class="sidebar-date-label">প্রকাশিত :</span>
          <time class="sidebar-date-val"><%= formatBengaliDate(post.published_at || post.created_at) %></time>
        </div>

        <!-- Social Share Row -->
        <div class="sidebar-meta-item sidebar-share-row">
          <span class="sidebar-share-label">শেয়ার :</span>
          <div class="social-share-wrapper">
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(seo.canonical) %>" class="social-share-button social-share-button-fb" title="ফেসবুকে শেয়ার করুন" target="_blank" rel="nofollow noopener noreferrer" aria-label="Share on Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" width="16" height="16"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
            </a>
            <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent(seo.canonical) %>" class="social-share-button social-share-button-twitter" title="টুইটারে শেয়ার করুন" target="_blank" rel="nofollow noopener noreferrer" aria-label="Share on Twitter">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="16" height="16"><path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z"/></svg>
            </a>
            <a href="mailto:?subject=<%= encodeURIComponent(post.title) %>&body=<%= encodeURIComponent(seo.canonical) %>" class="social-share-button social-share-button-email" title="ইমেইলে শেয়ার করুন" target="_blank" rel="nofollow noopener noreferrer" aria-label="Share via Email">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="16" height="16"><path d="M0 128C0 92.65 28.65 64 64 64H448C483.3 64 512 92.65 512 128V384C512 419.3 483.3 448 448 448H64C28.65 448 0 419.3 0 384V128zM48 128V150.1L220.5 291.7C241.1 308.7 270.9 308.7 291.5 291.7L464 150.1V127.1C464 119.2 456.8 111.1 448 111.1H64C55.16 111.1 48 119.2 48 127.1L48 128zM48 212.2V384C48 392.8 55.16 400 64 400H448C456.8 400 464 392.8 464 384V212.2L322 328.8C283.6 360.3 228.4 360.3 189.1 328.8L48 212.2z"/></svg>
            </a>
          </div>
        </div>

        <div class="sidebar-divider"></div>

        <!-- Quick Links -->
        <div class="sidebar-quick-links">
          <a href="/লেখক-তালিকা" class="sidebar-link-pill">পয়স্তিতে যারা লিখেছেন</a>
          <a href="/bangla-spell" class="sidebar-link-pill">নির্দেশিকা</a>
          <a href="/terms-and-condition" class="sidebar-link-pill">শর্তাবলী</a>
        </div>

        <div class="sidebar-divider"></div>

        <!-- Magazine Ad Banner -->
        <div class="sidebar-ad-wrap">
          <img src="/images/Payasti-ads.png" alt="পয়স্তি সাহিত্য স্মারক" class="sidebar-ad-banner">
        </div>
      </div>
    </aside>
  </div>

  <!-- Related Posts Section -->
  <% if (relatedPosts && relatedPosts.length) { %>
    <section class="related-posts-section">
      <div class="site-container">
        <div class="section-header">
          <h2 class="section-title">একই বিভাগের আরও লেখা</h2>
        </div>
        <div class="posts-grid-4">
          <% relatedPosts.forEach(rPost => { %>
            <%- include('partials/post_card', { post: rPost, isSelected: false }) %>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Floating Selection Quote Toolbar -->
  <div id="quoteSelectionToolbar" class="quote-selection-toolbar" style="display: none;" role="toolbar">
    <button type="button" id="btnCopyQuote" class="quote-tool-btn" title="উদ্ধৃতি কপি করুন">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      কোট কপি
    </button>
    <button type="button" id="btnMakeQuoteCard" class="quote-tool-btn primary" title="সোশ্যাল কোট কার্ড বানান">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
      কোট কার্ড
    </button>
  </div>

  <!-- Quote Card Modal -->
  <div id="quoteCardModal" class="quote-card-modal" style="display: none;">
    <div class="quote-modal-overlay"></div>
    <div class="quote-modal-content">
      <div class="quote-modal-header">
        <h3 class="quote-modal-title">পয়স্তি সাহিত্য কোট কার্ড</h3>
        <button type="button" id="btnCloseQuoteCard" class="quote-modal-close" aria-label="Close">&times;</button>
      </div>
      <div class="quote-modal-body">
        <div id="quoteCardVisual" class="quote-card-preview-box">
          <div class="quote-card-watermark">পয়স্তি</div>
          <div class="quote-card-quote-mark">“</div>
          <div class="quote-card-text" id="quoteCardText"></div>
          <div class="quote-card-footer">
            <div class="quote-card-author" id="quoteCardAuthor">— <%= author ? author.display_name : (post.author_name || 'পয়স্তি লেখক') %></div>
            <div class="quote-card-source">লেখা: <%= post.title %> | payasti.com</div>
          </div>
        </div>
      </div>
      <div class="quote-modal-actions">
        <button type="button" id="btnDownloadQuoteCard" class="quote-btn-action btn-download">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          কার্ড ডাউনলোড (PNG)
        </button>
        <button type="button" id="btnCopyQuoteTextModal" class="quote-btn-action btn-copy">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          কোট কপি
        </button>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
