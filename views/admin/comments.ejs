<%- include('partials/admin_layout_start', { 
  pageTitle: 'Comments', 
  pageBreadcrumb: 'Comments'
}) %>

<div class="admin-card">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-info);">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      <span>All Comments</span>
      <span class="admin-card-badge"><%= comments ? comments.length : 0 %> <%= (comments && comments.length === 1) ? 'item' : 'items' %></span>
    </div>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Author</th>
          <th>Comment</th>
          <th>Post Title</th>
          <th>Date</th>
          <th>Status</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (comments && comments.length) { %>
          <% comments.forEach(c => { %>
            <tr>
              <td>
                <strong style="color: var(--admin-text-main); font-size: 18px;"><%= c.author_name %></strong>
                <% if (c.author_email) { %>
                  <div style="font-size: 14px; color: var(--admin-text-sub);"><%= c.author_email %></div>
                <% } %>
              </td>
              <td style="max-width: 320px; font-size: 17px; color: #374151; line-height: 1.6;">
                <%= c.content %>
              </td>
              <td>
                <% if (c.post_title) { %>
                  <a href="/post/<%= c.post_slug %>" target="_blank" style="color: var(--admin-primary); font-size: 16px; text-decoration: underline;">
                    <%= c.post_title %>
                  </a>
                <% } else { %>
                  <span style="color: #94a3b8;">-</span>
                <% } %>
              </td>
              <td style="white-space: nowrap; font-size: 16px; color: var(--admin-text-muted);">
                <%= new Date(c.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
              </td>
              <td>
                <% if (c.status === 'approved') { %>
                  <span class="status-badge published">Approved</span>
                <% } else { %>
                  <span class="status-badge pending">Pending</span>
                <% } %>
              </td>
              <td>
                <div class="actions-group" style="justify-content: flex-end;">
                  <% if (c.status !== 'approved') { %>
                    <form action="/admin/comments/<%= c.id %>/approve" method="POST" style="display: inline;">
                      <button type="submit" class="btn-table-action btn-approve" title="Approve">
                        ✓
                      </button>
                    </form>
                  <% } %>
                  <form action="/admin/comments/<%= c.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                    <button type="submit" class="btn-table-action btn-reject" title="Delete">
                      ✕
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6">
              <div class="admin-empty-state">
                <div class="empty-icon">💬</div>
                <div class="empty-title">No comments found</div>
                <div class="empty-desc">When visitors leave comments on your posts, they will appear here.</div>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin_layout_end') %>
