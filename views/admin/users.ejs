<%- include('partials/admin_layout_start', { 
  pageTitle: 'Users & Authors', 
  pageBreadcrumb: 'Authors',
  topbarButton: { text: '+ Add New Author', url: '/admin/users/new' }
}) %>

<!-- Status & Role Tabs & Search Filter -->
<div class="admin-card" style="margin-bottom: 20px;">
  <div style="padding: 16px 20px; display: flex; flex-direction: column; gap: 14px;">
    
    <!-- Top Row: Status Tabs & Quick Approval Access -->
    <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; border-bottom: 1px solid #edf2f7; padding-bottom: 14px;">
      <div style="display: flex; flex-wrap: wrap; gap: 6px;">
        <!-- All Users -->
        <a href="/admin/users?status=all&role=all&q=<%= searchQuery %>" 
           class="btn-view-site" 
           style="<%= (statusFilter === 'all' && roleFilter === 'all') ? 'background: var(--admin-primary); color: #fff; border-color: var(--admin-primary);' : '' %>">
          All Users (<%= userStats.total %>)
        </a>

        <!-- Pending Approval Tab (highlighted if any exists) -->
        <a href="/admin/users?status=pending_approval&q=<%= searchQuery %>" 
           class="btn-view-site" 
           style="<%= statusFilter === 'pending_approval' ? 'background: #d97706; color: #fff; border-color: #d97706;' : (userStats.pendingApproval > 0 ? 'background: #fffbeb; color: #b45309; border-color: #fde68a; font-weight: 700;' : '') %>">
          ⏳ Pending Approval (<%= userStats.pendingApproval %>)
        </a>

        <!-- Pending Verification Tab -->
        <a href="/admin/users?status=pending_verification&q=<%= searchQuery %>" 
           class="btn-view-site" 
           style="<%= statusFilter === 'pending_verification' ? 'background: #4b5563; color: #fff; border-color: #4b5563;' : '' %>">
          ✉️ Pending Verification (<%= userStats.pendingVerification %>)
        </a>

        <!-- Active Users -->
        <a href="/admin/users?status=active&q=<%= searchQuery %>" 
           class="btn-view-site" 
           style="<%= statusFilter === 'active' ? 'background: #16a34a; color: #fff; border-color: #16a34a;' : '' %>">
          ✓ Active Users
        </a>
      </div>

      <!-- Search Form -->
      <form action="/admin/users" method="GET" style="display: flex; gap: 8px;">
        <input type="hidden" name="role" value="<%= roleFilter %>">
        <input type="hidden" name="status" value="<%= statusFilter %>">
        <input 
          type="text" 
          name="q" 
          value="<%= searchQuery %>" 
          class="admin-form-input" 
          placeholder="Name, username, or email..." 
          style="width: 240px; padding: 7px 12px; font-size: 15px;"
        >
        <button type="submit" class="btn-view-site" style="padding: 7px 14px; font-size: 15px;">Search</button>
        <% if (searchQuery || roleFilter !== 'all' || statusFilter !== 'all') { %>
          <a href="/admin/users" class="btn-view-site" style="padding: 7px 12px; color: #dc2626; font-size: 15px;" title="Reset filters">✕ Reset</a>
        <% } %>
      </form>
    </div>

    <!-- Bottom Row: Role Sub-filters -->
    <div style="display: flex; gap: 6px; align-items: center; font-size: 14px; color: var(--admin-text-muted);">
      <span style="font-weight: 600;">By Role:</span>
      <a href="/admin/users?role=admin&status=<%= statusFilter %>&q=<%= searchQuery %>" 
         style="text-decoration: none; padding: 3px 10px; border-radius: 4px; font-size: 13px; <%= roleFilter === 'admin' ? 'background: #fef2f2; color: #dc2626; font-weight: 700;' : 'color: var(--admin-text-muted);' %>">
        Admin (<%= userStats.admins %>)
      </a>
      •
      <a href="/admin/users?role=editor&status=<%= statusFilter %>&q=<%= searchQuery %>" 
         style="text-decoration: none; padding: 3px 10px; border-radius: 4px; font-size: 13px; <%= roleFilter === 'editor' ? 'background: #f1f5f9; color: #334155; font-weight: 700;' : 'color: var(--admin-text-muted);' %>">
        Editor (<%= userStats.editors %>)
      </a>
      •
      <a href="/admin/users?role=author&status=<%= statusFilter %>&q=<%= searchQuery %>" 
         style="text-decoration: none; padding: 3px 10px; border-radius: 4px; font-size: 13px; <%= roleFilter === 'author' ? 'background: #eaf5e9; color: #075603; font-weight: 700;' : 'color: var(--admin-text-muted);' %>">
        Author (<%= userStats.authors %>)
      </a>
    </div>

  </div>
</div>

<!-- Users Table Card -->
<div class="admin-card">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <span>Registered Users & Authors</span>
      <span class="admin-card-badge"><%= users ? users.length : 0 %> <%= (users && users.length === 1) ? 'user shown' : 'users shown' %></span>
    </div>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width: 44px;">Avatar</th>
          <th>Full Name & Username</th>
          <th>Email</th>
          <th>Role</th>
          <th>Status</th>
          <th>Total Posts</th>
          <th>Registered Date</th>
          <th style="text-align: right; min-width: 170px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (users && users.length > 0) { %>
          <% users.forEach(u => { %>
            <% 
              const isPendingApproval = (u.status === 'pending_approval') || (u.role === 'author' && (!u.is_approved || u.is_approved == 0) && (u.email_verified == 1));
              const isPendingVerification = (u.status === 'pending_verification') || (u.role === 'author' && (!u.email_verified || u.email_verified == 0));
              const isSuspended = (u.status === 'suspended');
            %>
            <tr style="<%= isPendingApproval ? 'background-color: #fffdf5;' : '' %>">
              <td>
                <% if (u.avatar) { %>
                  <img src="<%= u.avatar %>" alt="" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 1px solid #e2e8f0;">
                <% } else { %>
                  <div style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #075603 0%, #068200 100%); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 18px;">
                    <%= u.display_name ? u.display_name.charAt(0) : 'U' %>
                  </div>
                <% } %>
              </td>
              <td>
                <div class="author-name">
                  <a href="/admin/users/<%= u.id %>/edit" style="color: var(--admin-text-main); text-decoration: none; font-weight: 600;">
                    <%= u.display_name || 'No Name' %>
                  </a>
                </div>
                <div class="author-email">@<%= u.username %></div>
              </td>
              <td style="color: var(--admin-text-muted); font-size: 15px;">
                <%= u.email %>
              </td>
              <td>
                <% if (u.role === 'admin') { %>
                  <span class="status-badge" style="background: #fef2f2; color: #dc2626; border: 1px solid #fecaca;">🛡️ Admin</span>
                <% } else if (u.role === 'editor') { %>
                  <span class="status-badge" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1;">🖋️ Editor</span>
                <% } else { %>
                  <span class="status-badge" style="background: #eaf5e9; color: #075603; border: 1px solid #c7e6c5;">Author</span>
                <% } %>
              </td>
              <td>
                <% if (isPendingApproval) { %>
                  <span class="status-badge" style="background: #fffbeb; color: #b45309; border: 1px solid #fde68a;">
                    ⏳ Pending Approval
                  </span>
                <% } else if (isPendingVerification) { %>
                  <span class="status-badge" style="background: #f3f4f6; color: #4b5563; border: 1px solid #e5e7eb;">
                    ✉️ Pending Verification
                  </span>
                <% } else if (isSuspended) { %>
                  <span class="status-badge" style="background: #fee2e2; color: #991b1b; border: 1px solid #fecaca;">
                    🚫 Suspended
                  </span>
                <% } else { %>
                  <span class="status-badge" style="background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0;">
                    ✓ Active
                  </span>
                <% } %>
              </td>
              <td>
                <strong style="color: var(--admin-text-main); font-size: 16px;">
                  <%= u.post_count || 0 %>
                </strong>
                <span style="font-size: 13px; color: var(--admin-text-sub);">
                  (<%= u.published_count || 0 %> published)
                </span>
              </td>
              <td style="white-space: nowrap; color: var(--admin-text-muted); font-size: 15px;">
                <%= new Date(u.registered_at || u.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
              </td>
              <td>
                <div class="actions-group" style="justify-content: flex-end; gap: 6px;">
                  
                  <!-- Quick Approve Button for Pending Users -->
                  <% if (isPendingApproval || isPendingVerification) { %>
                    <form action="/admin/users/<%= u.id %>/approve" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to approve and activate this author account?');">
                      <button type="submit" class="btn-table-action" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; font-weight: 600;" title="Approve Account">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Approve
                      </button>
                    </form>
                  <% } %>

                  <!-- Edit User -->
                  <a href="/admin/users/<%= u.id %>/edit" class="btn-table-action" style="background: #eaf5e9; color: #075603;" title="Edit User">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    Edit
                  </a>

                  <!-- Delete User (prevent deleting own account) -->
                  <% if (user.id !== u.id) { %>
                    <form action="/admin/users/<%= u.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                      <button type="submit" class="btn-table-action btn-reject" title="Delete">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                      </button>
                    </form>
                  <% } %>

                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8">
              <div class="admin-empty-state">
                <div class="empty-icon">👥</div>
                <div class="empty-title">No authors or users found</div>
                <div class="empty-desc">No records match your search or selected filter.</div>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin_layout_end') %>
