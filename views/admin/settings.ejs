<%- include('partials/admin_layout_start', { 
  pageTitle: 'সাইট সাধারণ সেটিংস (Settings)', 
  pageBreadcrumb: 'Settings'
}) %>

<div class="admin-card" style="max-width: 800px; margin: 0 auto;">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-primary);">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
      <span>পয়স্তি ম্যাগাজিন ওয়েবসাইট সেটিংস</span>
    </div>
  </div>

  <div class="admin-card-body">
    <% if (typeof success !== 'undefined' && success) { %>
      <div style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-weight: 500;">
        ✓ সেটিংস সফলভাবে সংরক্ষিত ও আপডেট হয়েছে!
      </div>
    <% } %>

    <form action="/admin/settings" method="POST">
      <div class="admin-form-group">
        <label class="admin-form-label">ওয়েবসাইট শিরোনাম (Site Title) *</label>
        <input type="text" name="site_title" value="<%= settings.site_title || '' %>" class="admin-form-input" required>
      </div>

      <div class="admin-form-group">
        <label class="admin-form-label">ট্যাগলাইন (Site Tagline)</label>
        <input type="text" name="site_tagline" value="<%= settings.site_tagline || '' %>" class="admin-form-input">
      </div>

      <div class="admin-form-group">
        <label class="admin-form-label">ওয়েবসাইট পরিচিতি / মেটা বিবরণ (Description)</label>
        <textarea name="site_description" class="admin-form-textarea" rows="3"><%= settings.site_description || '' %></textarea>
      </div>

      <div class="admin-form-grid">
        <div class="admin-form-group">
          <label class="admin-form-label">অফিসিয়াল ইমেইল</label>
          <input type="email" name="contact_email" value="<%= settings.contact_email || '' %>" class="admin-form-input">
        </div>

        <div class="admin-form-group">
          <label class="admin-form-label">যোগাযোগের মোবাইল নম্বর</label>
          <input type="text" name="contact_phone" value="<%= settings.contact_phone || '' %>" class="admin-form-input">
        </div>
      </div>

      <div class="admin-form-group">
        <label class="admin-form-label">ফেসবুক পেজ লিংক</label>
        <input type="url" name="facebook_url" value="<%= settings.facebook_url || '' %>" class="admin-form-input">
      </div>

      <div style="text-align: right; padding-top: 20px; border-top: 1px solid var(--admin-border);">
        <button type="submit" class="btn-new-action" style="padding: 11px 30px; font-size: 17px;">
          সেটিংস সংরক্ষণ করুন
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/admin_layout_end') %>
