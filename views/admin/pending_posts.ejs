<%- include('partials/admin_layout_start', { 
  pageTitle: 'Pending Posts Review Queue', 
  pageBreadcrumb: 'Review Queue'
}) %>

<div class="admin-card">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-warning);">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>Pending Review Articles</span>
      <span class="admin-card-badge"><%= pendingPosts.length %> posts</span>
    </div>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title & Excerpt</th>
          <th>Author & Email</th>
          <th>Category</th>
          <th>Submitted At</th>
          <th style="text-align: right; min-width: 200px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (pendingPosts && pendingPosts.length > 0) { %>
          <% pendingPosts.forEach(p => { %>
            <tr>
              <td>
                <div class="post-title-cell">
                  <a href="/admin/posts/<%= p.id %>/edit" title="Edit and review this post">
                    <%= p.title %>
                  </a>
                </div>
                <% if (p.excerpt) { %>
                  <div style="font-size: 14px; color: var(--admin-text-sub); margin-top: 4px; line-height: 1.5; max-width: 360px;">
                    <%= p.excerpt %>
                  </div>
                <% } %>
              </td>
              <td>
                <div class="author-cell">
                  <div class="author-mini-avatar">
                    <%= p.author_name ? p.author_name.charAt(0) : 'A' %>
                  </div>
                  <div class="author-cell-info">
                    <span class="author-name"><%= p.author_name %></span>
                    <span class="author-email"><%= p.author_email %></span>
                  </div>
                </div>
              </td>
              <td>
                <span class="category-pill"><%= p.category_name || 'General' %></span>
              </td>
              <td style="white-space: nowrap; color: var(--admin-text-muted); font-size: 13.5px;">
                <%= new Date(p.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </td>
              <td>
                <div class="actions-group" style="justify-content: flex-end;">
                  <!-- Edit link -->
                  <a href="/admin/posts/<%= p.id %>/edit" class="btn-table-action" style="background: #eaf5e9; color: #075603;" title="Edit Post">
                    Edit
                  </a>

                  <!-- Approve form -->
                  <form action="/admin/post/<%= p.id %>/approve" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to approve and publish this post?');">
                    <button type="submit" class="btn-table-action btn-approve">
                      ✓ Approve
                    </button>
                  </form>

                  <!-- Reject form -->
                  <form action="/admin/post/<%= p.id %>/reject" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to reject this post and move it to drafts?');">
                    <button type="submit" class="btn-table-action btn-reject">
                      ✕ Reject
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5">
              <div class="admin-empty-state">
                <div class="empty-icon" style="color: #10b981; background: #ecfdf5;">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <div class="empty-title">No posts awaiting review!</div>
                <div class="empty-desc">All submitted articles have been reviewed or approved.</div>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin_layout_end') %>
