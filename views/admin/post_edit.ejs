<%- include('partials/admin_layout_start', { 
  pageTitle: 'পোস্ট সম্পাদনা: ' + post.title, 
  pageBreadcrumb: 'পোস্ট সম্পাদনা',
  activeMenu: 'posts',
  topbarButton: { text: 'সকল পোস্টে ফিরে যান', url: '/admin/posts' }
}) %>

<!-- Official WordPress Gutenberg Core Styles -->
<link rel="stylesheet" href="/vendor/gutenberg/components.css">
<link rel="stylesheet" href="/vendor/gutenberg/block-editor.css">
<link rel="stylesheet" href="/vendor/gutenberg/core.css">
<link rel="stylesheet" href="/vendor/gutenberg/isolated-block-editor.css">
<link rel="stylesheet" href="/css/wp-gutenberg-editor.css?v=3.0">

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 14px 18px; border-radius: 10px; margin-bottom: 24px; font-size: 16px;">
    ⚠️ <%= error %>
  </div>
<% } %>

<form id="postEditForm" action="/admin/posts/<%= post.id %>/edit" method="POST" enctype="multipart/form-data" class="wp-gutenberg-container">
  
  <!-- 1. Sticky WordPress Top Header Bar -->
  <div class="wp-editor-top-bar">
    <div class="wp-top-left">
      <div id="wpGutenbergToolsSlot">
        <!-- Gutenberg Inserter (+), Undo, Redo tools dock here -->
      </div>

      <!-- Quick Review Inserters Toolbar -->
      <div class="wp-review-quick-tools">
        <button type="button" class="wp-tool-btn" onclick="window.insertProsConsBlock();" title="সুবিধা ও অসুবিধা বক্স যোগ করুন">
          <span>⚖️ সুবিধা/অসুবিধা</span>
        </button>
        <button type="button" class="wp-tool-btn" onclick="window.insertProductCardBlock();" title="প্রোডাক্ট রিভিউ কার্ড যোগ করুন">
          <span>📦 প্রোডাক্ট বক্স</span>
        </button>
        <button type="button" class="wp-tool-btn" onclick="window.insertRatingBlock();" title="স্টার রেটিং স্কোর যোগ করুন">
          <span>⭐ রেটিং</span>
        </button>
        <button type="button" class="wp-tool-btn" onclick="window.insertComparisonTableBlock();" title="তুলনামূলক টেবিল যোগ করুন">
          <span>📊 টেবিল</span>
        </button>
      </div>
    </div>

    <div class="wp-top-right">
      <% if (post.status === 'publish') { %>
        <a href="/post/<%= encodeURIComponent(post.slug) %>" target="_blank" class="wp-btn-secondary" style="padding: 7px 12px; font-size: 13px;">
          লাইভ দেখুন &nearr;
        </a>
      <% } %>

      <button type="button" class="wp-btn-secondary" id="btnSaveDraftEdit" onclick="window.saveAsDraftEdit();">
        ড্রাফট করুন
      </button>

      <button type="submit" class="wp-btn-publish" id="btnUpdatePost">
        <span>আপডেট সংরক্ষণ করুন</span>
      </button>
    </div>
  </div>

  <!-- 2. Main 2-Column Layout (Canvas + Sidebar) -->
  <div class="wp-editor-grid">
    
    <!-- Left Column: Document Canvas -->
    <div class="wp-canvas-card">
      <!-- Large WordPress Title -->
      <input 
        type="text" 
        name="title" 
        id="postTitleInput"
        value="<%= post.title %>"
        class="wp-title-input" 
        required 
        placeholder="পোস্টের শিরোনাম লিখুন বা পেস্ট করুন..." 
        autocomplete="off"
      >

      <!-- Live Permalink Preview -->
      <div class="wp-permalink-preview">
        <span>স্থায়ী লিংক (Permalink):</span>
        <span class="wp-permalink-url" id="wpPermalinkUrl">/post/<%= post.slug %></span>
      </div>

      <!-- Gutenberg Writing Flow -->
      <div class="gutenberg-mount-container">
        <textarea name="content" id="postContentInput" style="display: none;"><%- post.content || '' %></textarea>
      </div>

      <!-- Realtime Word Count & Status Footer -->
      <div class="wp-editor-footer-status">
        <div class="wp-status-stats">
          <span class="wp-status-stat-item">📝 মোট শব্দ: <strong id="wpWordCount">০</strong></span>
          <span class="wp-status-stat-item">⏱️ পড়ার সময়: <strong id="wpReadingTime">১</strong> মিনিট</span>
        </div>
        <div>
          <span style="color: #059669; font-weight: 600;">⚡ WordPress Gutenberg Canvas</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Document Settings Sidebar -->
    <div class="wp-inspector-sidebar">
      
      <!-- Panel 1: স্ট্যাটাস ও দৃশ্যমানতা -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>স্ট্যাটাস ও দৃশ্যমানতা</span>
        </div>
        <div class="wp-inspector-body">
          <div class="wp-form-group">
            <label class="wp-label">প্রকাশনা স্ট্যাটাস</label>
            <select name="status" id="statusSelect" class="wp-select">
              <option value="publish" <%= post.status === 'publish' ? 'selected' : '' %>>সরাসরি প্রকাশিত (Publish)</option>
              <option value="draft" <%= post.status === 'draft' ? 'selected' : '' %>>ড্রাফট (Draft)</option>
              <option value="pending" <%= post.status === 'pending' ? 'selected' : '' %>>রিভিউ পেন্ডিং (Pending)</option>
            </select>
          </div>

          <!-- Author Selector -->
          <% if (typeof authors !== 'undefined' && authors && authors.length) { %>
            <div class="wp-form-group">
              <label class="wp-label">পোস্টের লেখক</label>
              <select name="author_id" class="wp-select">
                <% authors.forEach(a => { %>
                  <option value="<%= a.id %>" <%= (post.author_id === a.id) ? 'selected' : '' %>>
                    <%= a.display_name || a.username %> (<%= a.role %>)
                  </option>
                <% }); %>
              </select>
            </div>
          <% } %>

          <% const hasRating = Number(post.rating_score || 0) > 0; %>
          <!-- Rating Enable / Disable Option -->
          <div class="wp-form-group">
            <label class="wp-checkbox-label" style="margin-bottom: 6px;">
              <input type="checkbox" name="enable_rating" id="enableRatingCheckbox" value="1" <%= hasRating ? 'checked' : '' %> onchange="document.getElementById('ratingScoreFieldWrap').style.display = this.checked ? 'block' : 'none';">
              <span>⭐ এই পোস্টে রেটিং যুক্ত করুন</span>
            </label>
            <div id="ratingScoreFieldWrap" style="display: <%= hasRating ? 'block' : 'none' %>; margin-top: 8px; padding: 10px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
              <label class="wp-label" style="font-size: 13px; margin-bottom: 4px;">রেটিং স্কোর (১.০ - ৫.০)</label>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 18px; color: #f59e0b;">★</span>
                <input type="number" name="rating_score" id="ratingScoreInput" class="wp-input" step="0.1" min="1.0" max="5.0" value="<%= hasRating ? parseFloat(post.rating_score).toFixed(1) : '4.8' %>" placeholder="যেমন: 4.8" style="font-weight: 700; width: 110px;">
                <span style="font-size: 13px; color: #64748b;">/ ৫.০</span>
              </div>
              <span style="font-size: 11.5px; color: #64748b; margin-top: 4px; display: block;">পোস্টে প্রদর্শিত সামগ্রিক রিভিউ রেটিং স্কোর।</span>
            </div>
          </div>

          <div class="wp-form-group">
            <label class="wp-checkbox-label">
              <input type="checkbox" name="is_featured" value="1" <%= post.is_featured ? 'checked' : '' %>>
              <span>প্রধান ফিচারে প্রদর্শন করুন</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Panel 2: ক্যাটাগরি -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>ক্যাটাগরি / বিভাগ *</span>
        </div>
        <div class="wp-inspector-body">
          <select name="category_id" id="categorySelect" class="wp-select" required>
            <% if (categories && categories.length) { 
                 const rootCats = categories.filter(c => !c.parent_id || c.parent_id === 0);
                 rootCats.forEach(c => {
                   const children = categories.filter(child => child.parent_id === c.id);
            %>
              <option value="<%= c.id %>" <%= post.category_id === c.id ? 'selected' : '' %> style="font-weight: 700;"><%= c.name %></option>
              <% children.forEach(child => { %>
                <option value="<%= child.id %>" <%= post.category_id === child.id ? 'selected' : '' %>>&nbsp;&nbsp;— <%= child.name %></option>
              <% }) %>
            <%   });
               } %>
          </select>
        </div>
      </div>

      <!-- Panel 3: ফিচার্ড ছবি -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>ফিচার্ড ছবি</span>
        </div>
        <div class="wp-inspector-body">
          <div class="payasti-image-dropzone" data-name="featured_image" data-initial-url="<%= post.featured_image || '' %>" data-prompt="ফিচার্ড ছবি ড্র্যাগ করে ছাড়ুন অথবা ক্লিক করুন" data-hint="ক্লিক করে মিডিয়া লাইব্রেরি থেকে ছবি বাছুন"></div>
        </div>
      </div>

      <!-- Panel 4: সারাংশ -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>উদ্ধৃতি / সারাংশ</span>
        </div>
        <div class="wp-inspector-body">
          <textarea name="excerpt" class="wp-input" rows="3" placeholder="পোস্টের সংক্ষিপ্ত সারাংশ লিখুন..." style="resize: vertical;"><%= post.excerpt || '' %></textarea>
        </div>
      </div>

    </div>
  </div>

</form>

<!-- Official WordPress Gutenberg JS Dependencies (Local Fast Loading) -->
<script src="/vendor/gutenberg/react.min.js"></script>
<script src="/vendor/gutenberg/react-dom.min.js"></script>
<script src="/vendor/gutenberg/isolated-block-editor.js"></script>
<script src="/js/wp-smart-clipboard.js?v=2.5"></script>

<script>
  // Robust Content Sync Helper across Gutenberg isolated and core stores
  function syncGutenbergContent() {
    const textarea = document.getElementById('postContentInput');
    if (!textarea) return '';

    let syncedContent = '';

    // 1. Check Gutenberg Isolated Block Editor Store
    if (window.wp && window.wp.data && window.wp.blocks && typeof window.wp.blocks.serialize === 'function') {
      try {
        const isoStore = window.wp.data.select('isolated/editor');
        if (isoStore && typeof isoStore.getBlocks === 'function') {
          const isoBlocks = isoStore.getBlocks();
          if (isoBlocks && isoBlocks.length > 0) {
            syncedContent = window.wp.blocks.serialize(isoBlocks);
          }
        }
      } catch (e) {
        console.warn('Isolated store serialize warning:', e);
      }

      // 2. Check Core Block Editor Store
      if (!syncedContent) {
        try {
          const coreStore = window.wp.data.select('core/block-editor');
          if (coreStore && typeof coreStore.getBlocks === 'function') {
            const coreBlocks = coreStore.getBlocks();
            if (coreBlocks && coreBlocks.length > 0) {
              syncedContent = window.wp.blocks.serialize(coreBlocks);
            }
          }
        } catch (e) {
          console.warn('Core store serialize warning:', e);
        }
      }
    }

    // 3. Fallback: Existing textarea value
    if (!syncedContent && textarea.value && textarea.value.trim().length > 0) {
      syncedContent = textarea.value.trim();
    }

    // 4. Fallback: DOM HTML Extraction if block store was empty
    if (!syncedContent) {
      const editorEl = document.querySelector('.block-editor-writing-flow') ||
                       document.querySelector('.editor-styles-wrapper') ||
                       document.querySelector('.iso-editor');
      if (editorEl && editorEl.innerHTML && editorEl.innerText.trim().length > 0) {
        syncedContent = editorEl.innerHTML;
      }
    }

    if (syncedContent) {
      textarea.value = syncedContent;
    }
    return syncedContent;
  }

  // Global draft saving helper for edit
  window.saveAsDraftEdit = function() {
    document.getElementById('statusSelect').value = 'draft';
    syncGutenbergContent();
    const form = document.getElementById('postEditForm');
    if (form.requestSubmit) {
      form.requestSubmit();
    } else {
      form.submit();
    }
  };

  document.addEventListener('DOMContentLoaded', function() {
    const textarea = document.getElementById('postContentInput');
    
    // Initialize Media Library hook
    if (window.initGutenbergMediaLibrary) {
      window.initGutenbergMediaLibrary();
    }

    // Attach Official WordPress Gutenberg Block Editor
    if (window.wp && window.wp.attachEditor) {
      window.wp.attachEditor(textarea, {
        iso: {
          moreMenu: false,
          toolbar: {
            inserter: true,
            undo: true,
            inspector: false,
            navigation: false,
            documentInspector: false,
            selectorTool: false
          }
        },
        editor: {
          hasFixedToolbar: false,
          hasInlineToolbar: true,
          mediaUpload: window.handleGutenbergMediaUpload
        }
      });

      // Safely dock Gutenberg tools into top header slot
      let attempts = 0;
      const dockInterval = setInterval(function() {
        attempts++;
        const tools = document.querySelector('.editor-document-tools') || document.querySelector('.edit-post-header__toolbar');
        const slot = document.getElementById('wpGutenbergToolsSlot');
        if (tools && slot && !slot.contains(tools)) {
          slot.appendChild(tools);
          clearInterval(dockInterval);
        }
        if (attempts > 30) clearInterval(dockInterval);
      }, 50);
    }

    // Initialize WordPress Smart Paste & Handlers
    if (window.setupWordPressSmartPaste) {
      window.setupWordPressSmartPaste('postTitleInput', 'postContentInput');
    }

    // Form Submission & Content Sync
    const form = document.getElementById('postEditForm');
    const submitBtn = document.getElementById('btnUpdatePost');
    const draftBtn = document.getElementById('btnSaveDraftEdit');
    
    form.addEventListener('submit', function(e) {
      const title = document.getElementById('postTitleInput').value.trim();
      if (!title) {
        if (window.showToast) {
          window.showToast('⚠️ অনুগ্রহ করে পোস্টের শিরোনাম যোগ করুন।', 'error');
        } else {
          alert('অনুগ্রহ করে পোস্টের শিরোনাম যোগ করুন।');
        }
        document.getElementById('postTitleInput').focus();
        e.preventDefault();
        return false;
      }

      let content = syncGutenbergContent();
      if (!content || !content.trim()) {
        if (textarea && !textarea.value) textarea.value = '<p>' + title + '</p>';
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>আপডেট হচ্ছে... ⏳</span>';
      }
      if (draftBtn) draftBtn.disabled = true;
    });
  });
</script>

<%- include('partials/admin_layout_end') %>
