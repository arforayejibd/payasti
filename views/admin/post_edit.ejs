<%- include('partials/admin_layout_start', { 
  pageTitle: 'লেখা সম্পাদনা', 
  pageBreadcrumb: 'লেখা এডিট',
  topbarButton: { text: 'সকল লেখায় ফিরে যান', url: '/admin/posts' }
}) %>

<!-- Quill Editor CSS -->
<link rel="stylesheet" href="/vendor/quill/quill.snow.css">
<link rel="stylesheet" href="/css/payasti-spellchecker.css?v=7.2">

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 14px 18px; border-radius: 10px; margin-bottom: 24px; font-size: 16px;">
    ⚠️ <%= error %>
  </div>
<% } %>

<form id="postEditForm" action="/admin/posts/<%= post.id %>/edit" method="POST" enctype="multipart/form-data">
  <div class="admin-editor-layout">
    <!-- বাম পাশের প্রধান কলাম (শিরোনাম ও মূল লেখা) -->
    <div class="admin-editor-main">
      <!-- শিরোনাম -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>লেখার শিরোনাম *</span>
          </div>
          <div>
            <% if (post.status === 'publish') { %>
              <a href="/post/<%= encodeURIComponent(post.slug) %>" target="_blank" class="btn-view-site" style="padding: 4px 10px; font-size: 13px;">
                লাইভ প্রিভিউ &nearr;
              </a>
            <% } %>
          </div>
        </div>
        <div class="admin-card-body">
          <input 
            type="text" 
            name="title" 
            value="<%= post.title %>" 
            class="admin-form-input" 
            required 
            placeholder="লেখার শিরোনাম দিন..." 
            style="font-size: 20px; font-weight: 600; padding: 12px 16px;"
          >
        </div>
      </div>

      <!-- মূল লেখা (WYSIWYG রিচ টেক্সট এডিটর) -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>মূল সাহিত্য / লেখা *</span>
          </div>
        </div>
        <div class="admin-card-body" style="padding: 16px;">
          <div class="payasti-editor-wrapper">
            <div id="quillEditor"></div>
          </div>
          <!-- Live Word Count & Paragraph Stats -->
          <div class="writing-stats-bar" style="margin-top: 10px; display: flex; gap: 16px; align-items: center; background: #f8fafc; padding: 7px 16px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 14px; color: #64748b;">
            <div>শব্দ: <strong id="statWordCount" style="color: #0f172a;">০</strong></div>
            <div>অক্ষর: <strong id="statCharCount" style="color: #0f172a;">০</strong></div>
            <div>অনুচ্ছেদ: <strong id="statParaCount" style="color: #0f172a;">০</strong></div>
          </div>
          <!-- Safe JSON data block for raw content initialization -->
          <script type="application/json" id="rawPostContentJson"><%- JSON.stringify(post.content || '') %></script>
          <!-- Hidden textarea holding the HTML content for form submission -->
          <textarea name="content" id="postContentInput" style="display: none;"></textarea>
        </div>
      </div>
    </div>

    <!-- ডান পাশের সাইডবার কলাম (মেটাডাটা ও অ্যাকশন বক্স) -->
    <div class="admin-editor-sidebar">
      <!-- প্রকাশনা নিয়ন্ত্রণ বক্স -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>প্রকাশনা নিয়ন্ত্রণ</span>
          </div>
          <div>
            <% if (post.status === 'publish') { %>
              <span class="status-badge published">প্রকাশিত</span>
            <% } else if (post.status === 'pending') { %>
              <span class="status-badge pending">পেন্ডিং</span>
            <% } else { %>
              <span class="status-badge" style="background: #f1f5f9; color: #475569;">ড্রাফট</span>
            <% } %>
          </div>
        </div>
        <div class="admin-card-body" style="display: flex; flex-direction: column; gap: 16px;">
          <div class="admin-form-group" style="margin-bottom: 0;">
            <label class="admin-form-label">স্ট্যাটাস</label>
            <select name="status" class="admin-form-select" required>
              <option value="publish" <%= post.status === 'publish' ? 'selected' : '' %>>প্রকাশিত (Publish)</option>
              <option value="pending" <%= post.status === 'pending' ? 'selected' : '' %>>পেন্ডিং (Pending Review)</option>
              <option value="draft" <%= post.status === 'draft' ? 'selected' : '' %>>ড্রাফট (Draft)</option>
            </select>
          </div>

          <div style="padding: 10px 0; border-top: 1px solid var(--admin-border); border-bottom: 1px solid var(--admin-border);">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 16px; font-weight: 500;">
              <input type="checkbox" name="is_featured" value="1" <%= post.is_featured ? 'checked' : '' %> style="width: 20px; height: 20px; accent-color: var(--admin-primary);">
              <span>প্রধান ফিচারে প্রদর্শন করুন</span>
            </label>
          </div>

          <div style="display: flex; flex-direction: column; gap: 10px; padding-top: 4px;">
            <button type="submit" class="btn-new-action" style="width: 100%; justify-content: center; padding: 12px; font-size: 17px;">
              পরিবর্তন সংরক্ষণ করুন
            </button>
            <a href="/admin/posts" class="btn-view-site" style="width: 100%; justify-content: center; padding: 10px; font-size: 16px;">
              বাতিল করুন
            </a>
          </div>
        </div>
      </div>

      <!-- সাহিত্য বিভাগ -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>সাহিত্য বিভাগ *</span>
          </div>
        </div>
        <div class="admin-card-body">
          <select name="category_id" class="admin-form-select" required style="width: 100%;">
            <% if (categories && categories.length) { 
                 const rootCats = categories.filter(c => !c.parent_id || c.parent_id === 0);
                 rootCats.forEach(c => {
                   const children = categories.filter(child => child.parent_id === c.id);
            %>
              <option value="<%= c.id %>" <%= post.category_id == c.id ? 'selected' : '' %> style="font-weight: 700;">
                <%= c.name %>
              </option>
              <% children.forEach(child => { %>
                <option value="<%= child.id %>" <%= (post.category_id == child.id || post.subcategory_id == child.id) ? 'selected' : '' %>>
                  &nbsp;&nbsp;&nbsp;— <%= child.name %>
                </option>
              <% }) %>
            <%   });
               } %>
          </select>
        </div>
      </div>

      <!-- প্রধান লেখক নির্বাচন (সার্চযোগ্য) -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>মূল/প্রধান লেখক *</span>
          </div>
        </div>
        <div class="admin-card-body">
          <% 
            let defaultAuthorName = '';
            let defaultAuthorId = post.author_id;
            if (authors && authors.length) {
              const def = authors.find(a => post.author_id == a.id) || authors[0];
              if (def) {
                defaultAuthorName = `${def.display_name} (@${def.username})`;
                defaultAuthorId = def.id;
              }
            }
          %>
          <div class="searchable-author-container" style="position: relative;">
            <div style="position: relative;">
              <input 
                type="text" 
                id="mainAuthorSearchInput" 
                class="admin-form-input" 
                placeholder="🔍 টাইপ করে কবি খুঁজুন..." 
                value="<%= defaultAuthorName %>" 
                onfocus="openMainAuthorDropdown()" 
                oninput="filterMainAuthorDropdown(this.value)" 
                autocomplete="off"
                style="padding-right: 30px; font-size: 14px;"
              >
              <span style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #94a3b8; font-size: 11px;">▼</span>
            </div>
            <!-- Hidden actual select for form submission -->
            <select name="author_id" id="mainAuthorSelect" style="display: none;" required>
              <% if (authors && authors.length) { %>
                <% authors.forEach(a => { %>
                  <option value="<%= a.id %>" data-name="<%= a.display_name %>" data-username="<%= a.username %>" data-nicename="<%= a.nicename || a.username %>" <%= a.id == defaultAuthorId ? 'selected' : '' %>>
                    <%= a.display_name %> (@<%= a.username %>)
                  </option>
                <% }) %>
              <% } %>
            </select>
            <!-- Dropdown Menu -->
            <div id="mainAuthorDropdownMenu" class="author-dropdown-menu" style="display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0; max-height: 220px; overflow-y: auto; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.12); z-index: 1050;"></div>
          </div>
        </div>
      </div>

      <!-- সহ-লেখক / অন্যান্য কবি নির্বাচন (সার্চযোগ্য মাল্টিপল অথর) -->
      <div class="admin-card" id="coAuthorsCard" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>সহ-লেখক / কবিবৃন্দ (সংকলন বা যৌথ লেখা)</span>
          </div>
        </div>
        <div class="admin-card-body">
          <p style="font-size: 13px; color: #64748b; margin-top: 0; margin-bottom: 8px;">
            সংকলন বা যৌথ লেখার ক্ষেত্রে অতিরিক্ত কবি বা লেখকদের নির্বাচন করুন। তাঁদের সবার প্রোফাইলেও এই লেখাটি প্রদর্শিত হবে:
          </p>
          <!-- লাইভ সার্চ ফিল্টার ইনপুট -->
          <div style="position: relative; margin-bottom: 8px;">
            <input 
              type="text" 
              id="coAuthorSearchInput" 
              class="admin-form-input" 
              placeholder="🔍 কবির নাম দিয়ে তালিকায় খুঁজুন..." 
              style="padding: 6px 10px 6px 30px; font-size: 13px; height: 34px; width: 100%; border-radius: 6px;"
              oninput="filterCoAuthorCheckboxes(this.value)"
            >
            <span style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 13px;">🔍</span>
          </div>
          <div id="coAuthorsCheckboxList" style="max-height: 180px; overflow-y: auto; border: 1px solid var(--admin-border); border-radius: 8px; padding: 8px 12px; background: #f8fafc;">
            <% if (authors && authors.length) { %>
              <% authors.forEach(a => { 
                   const isCoAuthor = (typeof coAuthorIds !== 'undefined' && coAuthorIds.includes(a.id)) || (post.author_id == a.id);
              %>
                <label class="coauthor-check-label" data-search="<%= (a.display_name + ' ' + a.username).toLowerCase() %>" style="display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: 14px; cursor: pointer; color: #334155;">
                  <input type="checkbox" name="co_author_ids" value="<%= a.id %>" class="coauthor-checkbox" id="coauthor_<%= a.id %>" <%= isCoAuthor ? 'checked' : '' %> style="accent-color: var(--admin-primary); width: 16px; height: 16px;">
                  <span><%= a.display_name %></span>
                  <span style="font-size: 12px; color: #94a3b8;">(@<%= a.username %>)</span>
                </label>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>

      <!-- ফিচার্ড ছবি -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>ফিচার্ড ছবি</span>
          </div>
        </div>
        <div class="admin-card-body">
          <div class="payasti-image-dropzone" data-name="featured_image" data-initial-url="<%= post.featured_image || '' %>" data-prompt="ফিচার্ড ছবি ড্র্যাগ করে ছাড়ুন অথবা ক্লিক করুন" data-hint="ক্লিক করে মিডিয়া লাইব্রেরি থেকে ছবি বাছুন"></div>
        </div>
      </div>
    </div>
  </div>
</form>

<!-- Safe Authors JSON data -->
<script type="application/json" id="availableAuthorsData"><%- JSON.stringify(authors || []) %></script>

<!-- Quill Editor JS & Initialization -->
<script src="/vendor/quill/quill.min.js"></script>
<script src="/js/payasti-quill.js?v=3.0"></script>
<script src="/js/payasti-spellchecker.js?v=7.2"></script>
<script>
  let availableAuthors = [];
  try {
    availableAuthors = JSON.parse(document.getElementById('availableAuthorsData').textContent || '[]');
  } catch (e) {
    availableAuthors = [];
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Filter co-authors checkboxes in sidebar
  function filterCoAuthorCheckboxes(query) {
    const q = (query || '').toLowerCase().trim();
    const labels = document.querySelectorAll('.coauthor-check-label');
    labels.forEach(lbl => {
      const searchKey = lbl.dataset.search || lbl.textContent.toLowerCase();
      if (!q || searchKey.includes(q)) {
        lbl.style.display = 'flex';
      } else {
        lbl.style.display = 'none';
      }
    });
  }

  // Main Author Dropdown Functions
  function openMainAuthorDropdown() {
    closeAllAuthorDropdowns();
    const menu = document.getElementById('mainAuthorDropdownMenu');
    const input = document.getElementById('mainAuthorSearchInput');
    renderAuthorDropdownItems(menu, '', (author) => {
      input.value = `${author.display_name} (@${author.username})`;
      const select = document.getElementById('mainAuthorSelect');
      if (select) {
        select.value = author.id;
        select.dispatchEvent(new Event('change'));
      }
      menu.style.display = 'none';
    });
    menu.style.display = 'block';
  }

  function filterMainAuthorDropdown(query) {
    const menu = document.getElementById('mainAuthorDropdownMenu');
    const input = document.getElementById('mainAuthorSearchInput');
    renderAuthorDropdownItems(menu, query, (author) => {
      input.value = `${author.display_name} (@${author.username})`;
      const select = document.getElementById('mainAuthorSelect');
      if (select) {
        select.value = author.id;
        select.dispatchEvent(new Event('change'));
      }
      menu.style.display = 'none';
    });
    menu.style.display = 'block';
  }

  function renderAuthorDropdownItems(menuEl, query, onSelect) {
    const q = (query || '').toLowerCase().trim();
    const filtered = availableAuthors.filter(a => {
      if (!q) return true;
      const name = (a.display_name || '').toLowerCase();
      const user = (a.username || '').toLowerCase();
      return name.includes(q) || user.includes(q);
    });

    if (filtered.length === 0) {
      menuEl.innerHTML = '<div style="padding: 12px; color: #94a3b8; font-size: 13px; text-align: center;">কোনো কবি পাওয়া যায়নি</div>';
      return;
    }

    menuEl.innerHTML = '';
    filtered.forEach(a => {
      const item = document.createElement('div');
      item.className = 'author-dropdown-item';
      item.style.cssText = 'padding: 8px 12px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f8fafc; font-size: 14px;';
      item.innerHTML = `
        <div>
          <strong style="color: #0f172a;">${escapeHtml(a.display_name)}</strong>
          <span style="color: #64748b; font-size: 12px; margin-left: 6px;">@${escapeHtml(a.username)}</span>
        </div>
        ${a.role === 'admin' ? '<span style="font-size: 11px; background: #fee2e2; color: #dc2626; padding: 2px 6px; border-radius: 4px;">এডমিন</span>' : ''}
      `;
      item.addEventListener('mouseenter', () => item.style.background = '#f0fdf4');
      item.addEventListener('mouseleave', () => item.style.background = 'transparent');
      item.addEventListener('mousedown', (e) => {
        e.preventDefault();
        onSelect(a);
      });
      menuEl.appendChild(item);
    });
  }

  function closeAllAuthorDropdowns() {
    document.querySelectorAll('.author-dropdown-menu').forEach(m => m.style.display = 'none');
  }

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.searchable-author-container')) {
      closeAllAuthorDropdowns();
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    const quill = window.createPayastiEditor('#quillEditor', {
      placeholder: 'সম্পূর্ণ সাহিত্যকর্ম, কবিতা, প্রবন্ধ বা গল্প এখানে লিখুন...'
    });

    const contentInput = document.getElementById('postContentInput');
    const wordCountEl = document.getElementById('statWordCount');
    const charCountEl = document.getElementById('statCharCount');
    const paraCountEl = document.getElementById('statParaCount');

    function toBn(num) {
      const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      return String(num).replace(/\d/g, d => bnDigits[d]);
    }

    function getSanitizedHtml() {
      let html = quill.root.innerHTML;
      if (html) {
        html = html.replace(/<span class="payasti-spell-error[^"]*"[^>]*>([\s\S]*?)<\/span>/gi, '$1');
      }
      return html;
    }

    function syncToInput() {
      if (contentInput) {
        contentInput.value = getSanitizedHtml();
      }

      const text = quill.getText().trim();
      const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
      const chars = text.length;
      const paras = text ? text.split(/\n+/).map(p => p.trim()).filter(Boolean).length : 0;

      if (wordCountEl) wordCountEl.textContent = toBn(words);
      if (charCountEl) charCountEl.textContent = toBn(chars);
      if (paraCountEl) paraCountEl.textContent = toBn(paras);
    }

    // Safely load and clean existing content preserving soft line breaks and paragraphs
    const jsonEl = document.getElementById('rawPostContentJson');
    const rawEl = document.getElementById('rawPostContent');
    let rawContent = '';
    if (jsonEl && jsonEl.textContent) {
      try {
        rawContent = JSON.parse(jsonEl.textContent);
      } catch (e) {
        rawContent = jsonEl.textContent;
      }
    } else if (rawEl) {
      rawContent = rawEl.value;
    }

    if (rawContent && rawContent.trim()) {
      const cleanHtml = window.cleanArticleHtmlForEditor(rawContent);
      quill.root.innerHTML = cleanHtml;
      syncToInput();
    }

    // Keep form input synchronized on every change
    quill.on('text-change', function() {
      syncToInput();
    });

    // Attach Bangla Spell Checker Assistant (Live Instant Zero-Lag Mode)
    if (window.attachPayastiSpellChecker) {
      window.attachPayastiSpellChecker(quill, { autoScan: true });
    }

    const form = document.getElementById('postEditForm');
    form.addEventListener('submit', function(e) {
      if (window.activePayastiSpellChecker) {
        window.activePayastiSpellChecker.clearHighlights();
      }
      syncToInput();
      const text = quill.getText().trim();
      if (!text || text.length === 0) {
        alert('অনুগ্রহ করে মূল সাহিত্য বা লেখার বিষয়বস্তু লিখুন।');
        e.preventDefault();
        return false;
      }
    });

    syncToInput();
  });
</script>

<%- include('partials/admin_layout_end') %>
