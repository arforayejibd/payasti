<%- include('partials/admin_layout_start', { 
  pageTitle: 'লেখা সম্পাদনা', 
  pageBreadcrumb: 'লেখা এডিট',
  topbarButton: { text: 'সকল লেখায় ফিরে যান', url: '/admin/posts' }
}) %>

<!-- Quill Editor CSS -->
<link rel="stylesheet" href="/vendor/quill/quill.snow.css">
<link rel="stylesheet" href="/css/payasti-spellchecker.css?v=3.5">

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 14px 18px; border-radius: 10px; margin-bottom: 24px; font-size: 16px;">
    ⚠️ <%= error %>
  </div>
<% } %>

<form id="postEditForm" action="/admin/posts/<%= post.id %>/edit" method="POST" enctype="multipart/form-data">
  <div class="admin-editor-layout">
    <!-- বাম পাশের প্রধান কলাম (শিরোনাম ও মূল লেখা) -->
    <div class="admin-editor-main">
      <!-- শিরোনাম -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>লেখার শিরোনাম *</span>
          </div>
          <div>
            <% if (post.status === 'publish') { %>
              <a href="/<%= post.category_slug || 'literature' %>/<%= post.slug %>" target="_blank" class="btn-view-site" style="padding: 4px 10px; font-size: 13px;">
                লাইভ প্রিভিউ &nearr;
              </a>
            <% } %>
          </div>
        </div>
        <div class="admin-card-body">
          <input 
            type="text" 
            name="title" 
            value="<%= post.title %>" 
            class="admin-form-input" 
            required 
            placeholder="লেখার শিরোনাম দিন..." 
            style="font-size: 20px; font-weight: 600; padding: 12px 16px;"
          >
        </div>
      </div>

      <!-- মূল লেখা (WYSIWYG রিচ টেক্সট এডিটর) -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>মূল সাহিত্য / লেখা *</span>
          </div>
        </div>
        <div class="admin-card-body" style="padding: 16px;">
          <div class="payasti-editor-wrapper">
            <div id="quillEditor"></div>
          </div>
          <!-- Safe JSON data block for raw content initialization -->
          <script type="application/json" id="rawPostContentJson"><%- JSON.stringify(post.content || '') %></script>
          <!-- Hidden textarea holding the HTML content for form submission -->
          <textarea name="content" id="postContentInput" style="display: none;"></textarea>
        </div>
      </div>
    </div>

    <!-- ডান পাশের সাইডবার কলাম (মেটাডাটা ও অ্যাকশন বক্স) -->
    <div class="admin-editor-sidebar">
      <!-- প্রকাশনা নিয়ন্ত্রণ বক্স -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>প্রকাশনা নিয়ন্ত্রণ</span>
          </div>
          <div>
            <% if (post.status === 'publish') { %>
              <span class="status-badge published">প্রকাশিত</span>
            <% } else if (post.status === 'pending') { %>
              <span class="status-badge pending">পেন্ডিং</span>
            <% } else { %>
              <span class="status-badge" style="background: #f1f5f9; color: #475569;">ড্রাফট</span>
            <% } %>
          </div>
        </div>
        <div class="admin-card-body" style="display: flex; flex-direction: column; gap: 16px;">
          <div class="admin-form-group" style="margin-bottom: 0;">
            <label class="admin-form-label">স্ট্যাটাস</label>
            <select name="status" class="admin-form-select" required>
              <option value="publish" <%= post.status === 'publish' ? 'selected' : '' %>>প্রকাশিত (Publish)</option>
              <option value="pending" <%= post.status === 'pending' ? 'selected' : '' %>>পেন্ডিং (Pending Review)</option>
              <option value="draft" <%= post.status === 'draft' ? 'selected' : '' %>>ড্রাফট (Draft)</option>
            </select>
          </div>

          <div style="padding: 10px 0; border-top: 1px solid var(--admin-border); border-bottom: 1px solid var(--admin-border);">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 16px; font-weight: 500;">
              <input type="checkbox" name="is_featured" value="1" <%= post.is_featured ? 'checked' : '' %> style="width: 20px; height: 20px; accent-color: var(--admin-primary);">
              <span>প্রধান ফিচারে প্রদর্শন করুন</span>
            </label>
          </div>

          <div style="display: flex; flex-direction: column; gap: 10px; padding-top: 4px;">
            <button type="submit" class="btn-new-action" style="width: 100%; justify-content: center; padding: 12px; font-size: 17px;">
              পরিবর্তন সংরক্ষণ করুন
            </button>
            <a href="/admin/posts" class="btn-view-site" style="width: 100%; justify-content: center; padding: 10px; font-size: 16px;">
              বাতিল করুন
            </a>
          </div>
        </div>
      </div>

      <!-- সাহিত্য বিভাগ -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>সাহিত্য বিভাগ *</span>
          </div>
        </div>
        <div class="admin-card-body">
          <select name="category_id" class="admin-form-select" required style="width: 100%;">
            <% if (categories && categories.length) { 
                 const rootCats = categories.filter(c => !c.parent_id || c.parent_id === 0);
                 rootCats.forEach(c => {
                   const children = categories.filter(child => child.parent_id === c.id);
            %>
              <option value="<%= c.id %>" <%= post.category_id == c.id ? 'selected' : '' %> style="font-weight: 700;">
                <%= c.name %>
              </option>
              <% children.forEach(child => { %>
                <option value="<%= child.id %>" <%= (post.category_id == child.id || post.subcategory_id == child.id) ? 'selected' : '' %>>
                  &nbsp;&nbsp;&nbsp;— <%= child.name %>
                </option>
              <% }) %>
            <%   });
               } %>
          </select>
        </div>
      </div>

      <!-- লেখক নির্বাচন -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>লেখক নির্বাচন *</span>
          </div>
        </div>
        <div class="admin-card-body">
          <select name="author_id" class="admin-form-select" required style="width: 100%;">
            <% if (authors && authors.length) { %>
              <% authors.forEach(a => { %>
                <option value="<%= a.id %>" <%= post.author_id == a.id ? 'selected' : '' %>>
                  <%= a.display_name %> (@<%= a.username %>)
                </option>
              <% }) %>
            <% } %>
          </select>
        </div>
      </div>

      <!-- ফিচার্ড ছবি -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>ফিচার্ড ছবি</span>
          </div>
        </div>
        <div class="admin-card-body">
          <div class="payasti-image-dropzone" data-name="featured_image" data-initial-url="<%= post.featured_image || '' %>" data-prompt="ফিচার্ড ছবি ড্র্যাগ করে ছাড়ুন অথবা ক্লিক করুন" data-hint="ক্লিক করে মিডিয়া লাইব্রেরি থেকে ছবি বাছুন"></div>
        </div>
      </div>
    </div>
  </div>
</form>

<!-- Quill Editor JS & Initialization -->
<script src="/vendor/quill/quill.min.js"></script>
<script src="/js/payasti-quill.js?v=2.0"></script>
<script src="/js/payasti-spellchecker.js?v=5.2"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const quill = window.createPayastiEditor('#quillEditor', {
      placeholder: 'সম্পূর্ণ সাহিত্যকর্ম, কবিতা, প্রবন্ধ বা গল্প এখানে লিখুন...'
    });

    const contentInput = document.getElementById('postContentInput');

    function getSanitizedHtml() {
      let html = quill.root.innerHTML;
      if (html) {
        html = html.replace(/<span class="payasti-spell-error[^"]*"[^>]*>([\s\S]*?)<\/span>/gi, '$1');
      }
      return html;
    }

    function syncToInput() {
      if (contentInput) {
        contentInput.value = getSanitizedHtml();
      }
    }

    // Safely load and clean existing content preserving soft line breaks and paragraphs
    const jsonEl = document.getElementById('rawPostContentJson');
    const rawEl = document.getElementById('rawPostContent');
    let rawContent = '';
    if (jsonEl && jsonEl.textContent) {
      try {
        rawContent = JSON.parse(jsonEl.textContent);
      } catch (e) {
        rawContent = jsonEl.textContent;
      }
    } else if (rawEl) {
      rawContent = rawEl.value;
    }

    if (rawContent && rawContent.trim()) {
      const cleanHtml = window.cleanArticleHtmlForEditor(rawContent);
      quill.root.innerHTML = cleanHtml;
      syncToInput();
    }

    // Keep form input synchronized on every change
    quill.on('text-change', function() {
      syncToInput();
    });

    // Attach Bangla Spell Checker Assistant (On-Demand Mode for instant zero-lag editing)
    if (window.attachPayastiSpellChecker) {
      window.attachPayastiSpellChecker(quill, { autoScan: false });
    }

    const form = document.getElementById('postEditForm');
    form.addEventListener('submit', function(e) {
      if (window.activePayastiSpellChecker) {
        window.activePayastiSpellChecker.clearHighlights();
      }
      syncToInput();
      const text = quill.getText().trim();
      if (!text || text.length === 0) {
        alert('অনুগ্রহ করে মূল সাহিত্য বা লেখার বিষয়বস্তু লিখুন।');
        e.preventDefault();
        return false;
      }
    });
  });
</script>

<%- include('partials/admin_layout_end') %>
