<%- include('partials/admin_layout_start', { 
  pageTitle: 'Admin Dashboard', 
  pageBreadcrumb: 'Dashboard',
  topbarButton: { text: '+ Add New Post', url: '/admin/posts/new' }
}) %>

<!-- KPI Metric Cards Grid -->
<div class="admin-stats-grid">
  <!-- 1. Published Reviews & Articles -->
  <div class="admin-stat-card success">
    <div class="stat-info">
      <span class="stat-label">Total Published Posts</span>
      <span class="stat-number"><%= stats.published %></span>
      <a href="/admin/posts" class="stat-link">
        View All Posts &rarr;
      </a>
    </div>
    <div class="stat-icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
    </div>
  </div>

  <!-- 2. Categories & Topics -->
  <div class="admin-stat-card info">
    <div class="stat-info">
      <span class="stat-label">Total Categories</span>
      <span class="stat-number"><%= stats.categories %></span>
      <a href="/admin/categories" class="stat-link">
        Manage Categories &rarr;
      </a>
    </div>
    <div class="stat-icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
    </div>
  </div>

  <!-- 3. Tags -->
  <div class="admin-stat-card warning">
    <div class="stat-info">
      <span class="stat-label">Total Tags</span>
      <span class="stat-number"><%= stats.tags %></span>
      <a href="/admin/tags" class="stat-link">
        View Tags &rarr;
      </a>
    </div>
    <div class="stat-icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
        <line x1="7" y1="7" x2="7.01" y2="7"></line>
      </svg>
    </div>
  </div>

  <!-- 4. Total Views / Impressions -->
  <div class="admin-stat-card purple">
    <div class="stat-info">
      <span class="stat-label">Total Article Views</span>
      <span class="stat-number"><%= Number(stats.totalViews || 0).toLocaleString() %></span>
      <a href="/" target="_blank" class="stat-link">
        Visit Live Site &rarr;
      </a>
    </div>
    <div class="stat-icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    </div>
  </div>
</div>

<!-- Published Reviews & Articles Card -->
<div class="admin-card" style="margin-top: 24px;">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-primary);">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
      <span>Recent Published Posts</span>
      <span class="admin-card-badge"><%= recentPublished.length %> items</span>
    </div>
    <div>
      <a href="/admin/posts" class="stat-link" style="color: var(--admin-primary); font-size: 15px; font-weight: 700;">
        View All Posts &rarr;
      </a>
    </div>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title & Excerpt</th>
          <th>Category</th>
          <th>Published Date</th>
          <th>Views</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentPublished && recentPublished.length > 0) { %>
          <% recentPublished.forEach(p => { %>
            <tr>
              <td>
                <div class="post-title-cell" style="font-weight: 700;">
                  <a href="/post/<%= encodeURIComponent(p.slug) %>" target="_blank" style="color: inherit; text-decoration: none;">
                    <%= p.title %>
                  </a>
                </div>
                <% if (p.excerpt) { %>
                  <div style="font-size: 14px; color: var(--admin-text-sub); margin-top: 4px; max-width: 380px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= p.excerpt %>
                  </div>
                <% } %>
              </td>
              <td>
                <span class="category-pill"><%= p.category_name || 'General' %></span>
              </td>
              <td style="white-space: nowrap; color: var(--admin-text-muted); font-size: 14px;">
                <%= new Date(p.published_at || p.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
              </td>
              <td style="white-space: nowrap; font-weight: 700; color: #068200;">
                👁️ <%= Number(p.views || 0).toLocaleString() %>
              </td>
              <td>
                <div class="actions-group" style="justify-content: flex-end; gap: 8px;">
                  <a href="/admin/posts/<%= p.id %>/edit" class="btn-table-action" style="background: #eaf5e9; color: #075603;" title="Edit Post">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    Edit
                  </a>
                  <a href="/post/<%= encodeURIComponent(p.slug) %>" target="_blank" class="btn-table-action" style="background: #f8fafc; color: #334155;" title="View Post">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    View
                  </a>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5">
              <div class="admin-empty-state">
                <div class="empty-icon">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                  </svg>
                </div>
                <div class="empty-title">No posts available</div>
                <div class="empty-desc">Click "+ Add New Post" to publish a new top 10 review or article.</div>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin_layout_end') %>
