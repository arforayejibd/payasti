<%- include('partials/header') %>

<main class="page-main-content">
  <div class="site-container category-page-container" style="padding-top: 30px; padding-bottom: 40px;">
    <!-- Category Main Title -->
    <h1 class="category-main-title">
      <%= (typeof activeSubCategory !== 'undefined' && activeSubCategory) ? activeSubCategory.name : category.name %>
    </h1>

    <!-- Subcategory Tabs Bar -->
    <% if (subcategories && subcategories.length) { 
         const currentParent = (typeof parentCategory !== 'undefined' && parentCategory) ? parentCategory : category;
    %>
      <div class="subcategory-tabs-bar">
        <a href="/section/<%= encodeURIComponent(currentParent.slug) %>" class="subcat-tab-link <%= !activeSubSlug ? 'active' : '' %>">
          সকল <%= currentParent.name %>
        </a>
        <% subcategories.forEach(sub => { 
             const isActive = activeSubSlug && (activeSubSlug === sub.slug || decodeURIComponent(activeSubSlug) === sub.slug);
        %>
          <a href="/section/<%= encodeURIComponent(currentParent.slug) %>/<%= encodeURIComponent(sub.slug) %>" class="subcat-tab-link <%= isActive ? 'active' : '' %>">
            <%= sub.name %>
          </a>
        <% }) %>
      </div>
    <% } %>

    <!-- Posts 4-Column Grid -->
    <div class="posts-grid-4" style="margin-top: 24px;">
      <% if (posts && posts.length) { %>
        <% posts.forEach(post => { %>
          <%- include('partials/post_card', { post: post, isSelected: false }) %>
        <% }) %>
      <% } else { %>
        <p class="no-posts-msg" style="grid-column: 1 / -1; text-align: center; color: #888; padding: 60px 0;">এই বিভাগে বর্তমানে কোনো প্রকাশিত লেখা নেই।</p>
      <% } %>
    </div>

    <!-- Pagination -->
    <%- include('partials/pagination', { pagination: pagination }) %>
  </div>
</main>

<%- include('partials/footer') %>
