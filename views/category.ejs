<%- include('partials/header') %>

<main class="page-main-content">
  <div class="ct-section-inner-wrap section-inner-container" style="padding-top: 30px; padding-bottom: 20px;">
    <!-- Category Main Title (#headline-4-91) -->
    <h1 class="category-main-title" id="headline-4-91"><%= category.name %></h1>

    <!-- Subcategory Tabs Bar (#div_block-767-3860) -->
    <% if (subcategories && subcategories.length) { %>
      <div class="subcategory-tabs-bar" id="div_block-767-3860">
        <a href="/category/<%= encodeURIComponent(category.slug) %>" class="subcat-tab-link <%= !activeSubSlug ? 'active' : '' %>">
          সকল <%= category.name %>
        </a>
        <% subcategories.forEach(sub => { 
             const isActive = activeSubSlug && (activeSubSlug === sub.slug || decodeURIComponent(activeSubSlug) === sub.slug);
        %>
          <a href="<%= sub.url %>" class="subcat-tab-link <%= isActive ? 'active' : '' %>">
            <%= sub.name %>
          </a>
        <% }) %>
      </div>
    <% } %>

    <!-- Posts 4-Column Grid -->
    <div class="posts-grid-4 latest-posts-grid" id="_dynamic_list-778-3860" style="margin-top: 20px;">
      <% if (posts && posts.length) { %>
        <% posts.forEach(post => { %>
          <%- include('partials/post_card', { post: post, isSelected: false }) %>
        <% }) %>
      <% } else { %>
        <p class="no-posts-msg" style="grid-column: 1 / -1; text-align: center; color: #888; padding: 60px 0;">এই বিভাগে বর্তমানে কোনো প্রকাশিত লেখা নেই।</p>
      <% } %>
    </div>

    <!-- Pagination -->
    <%- include('partials/pagination', { pagination: pagination }) %>
  </div>
</main>

<%- include('partials/footer') %>
