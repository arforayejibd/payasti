<%- include('partials/header') %>

<main class="page-main-content">
  <!-- 1. Books Section (#section-1124-2678) -->
  <section class="site-section books-section" id="section-1124-2678">
    <div class="ct-section-inner-wrap section-inner-container">
      <div class="books-section-heading" id="div_block-271-4047">
        <div class="books-heading-title" id="text_block-274-4047">পয়স্তি প্রকাশন-এর প্রকাশিত বইসমূহ</div>
        <div class="carousel-header-controls">
          <button type="button" class="carousel-btn" id="homeBookSlidePrev" aria-label="পূর্ববর্তী বই" title="পূর্ববর্তী বই">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="carousel-btn" id="homeBookSlideNext" aria-label="পরবর্তী বই" title="পরবর্তী বই">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <a href="https://payastiprokashon.com.bd/books" target="_blank" rel="noopener noreferrer" class="books-heading-link" id="text_block-276-4047">সকল বই »</a>
        </div>
      </div>

      <div class="books-carousel-wrapper">
        <button type="button" class="carousel-float-arrow prev" id="homeBookFloatPrev" aria-label="পূর্ববর্তী বই" title="পূর্ববর্তী বই">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>

        <div class="books-carousel-track" id="homeBooksCarouselTrack">
          <% if (books && books.length) { %>
            <% books.forEach(book => { %>
              <div class="carousel-book-card-item">
                <%- include('partials/book_card', { book: book }) %>
              </div>
            <% }) %>
          <% } %>
        </div>

        <button type="button" class="carousel-float-arrow next" id="homeBookFloatNext" aria-label="পরবর্তী বই" title="পরবর্তী বই">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- 2. Selected Literature (#section-2-3916) -->
  <% if (featuredPosts && featuredPosts.length) { %>
    <section class="site-section selected-section" id="section-2-3916">
      <div class="ct-section-inner-wrap section-inner-container">
        <div class="selected-section-heading" id="div_block-274-3916">
          <div class="selected-heading-title" id="text_block-4-3916">নির্বাচিত সাহিত্য</div>
          <a href="/topic/selected" class="selected-heading-link" id="text_block-277-3916">নির্বাচিত সকল লেখা »</a>
        </div>

        <div class="posts-grid-4 selected-posts-grid" id="_dynamic_list-6-3916">
          <% featuredPosts.forEach(post => { %>
            <%- include('partials/post_card', { post: post, isSelected: true }) %>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- 3. Latest Literature (#section-279-3916) -->
  <section class="site-section latest-section" id="section-279-3916">
    <div class="ct-section-inner-wrap section-inner-container">
      <div class="latest-section-heading" id="div_block-280-3916">
        <div class="latest-heading-title" id="text_block-281-3916">সর্বশেষ সাহিত্য</div>
      </div>

      <div class="posts-grid-4 latest-posts-grid" id="_dynamic_list-284-3916">
        <% if (latestPosts && latestPosts.length) { %>
          <% latestPosts.forEach(post => { %>
            <%- include('partials/post_card', { post: post, isSelected: false }) %>
          <% }) %>
        <% } else { %>
          <p class="no-posts-msg" style="grid-column: 1 / -1; text-align: center; color: #888; padding: 40px 0;">কোনো লেখা পাওয়া যায়নি।</p>
        <% } %>
      </div>
    </div>
  </section>
</main>

<script>
  (function() {
    const track = document.getElementById('homeBooksCarouselTrack');
    if (!track) return;

    const prevBtns = [document.getElementById('homeBookSlidePrev'), document.getElementById('homeBookFloatPrev')].filter(Boolean);
    const nextBtns = [document.getElementById('homeBookSlideNext'), document.getElementById('homeBookFloatNext')].filter(Boolean);

    // Return the exact width of a single card plus gap (20px)
    function getSingleCardStep() {
      const firstItem = track.querySelector('.carousel-book-card-item');
      if (!firstItem) return 250;
      const rect = firstItem.getBoundingClientRect();
      return Math.round(rect.width) + 20;
    }

    function updateNavState() {
      const maxScroll = track.scrollWidth - track.clientWidth;
      const atStart = track.scrollLeft <= 5;
      const atEnd = track.scrollLeft >= maxScroll - 5;

      prevBtns.forEach(btn => btn.disabled = atStart);
      nextBtns.forEach(btn => btn.disabled = atEnd);
    }

    let autoSlideTimer = null;
    function startAutoSlide() {
      stopAutoSlide();
      autoSlideTimer = setInterval(() => {
        const maxScroll = track.scrollWidth - track.clientWidth;
        const step = getSingleCardStep();
        if (track.scrollLeft >= maxScroll - 15) {
          // Reached the end: loop back to beginning
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          // Advance strictly one card at a time
          track.scrollBy({ left: step, behavior: 'smooth' });
        }
      }, 3000); // Auto-scroll every 3 seconds
    }

    function stopAutoSlide() {
      if (autoSlideTimer) {
        clearInterval(autoSlideTimer);
        autoSlideTimer = null;
      }
    }

    function restartAutoSlide() {
      stopAutoSlide();
      startAutoSlide();
    }

    prevBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const step = getSingleCardStep();
        track.scrollBy({ left: -step, behavior: 'smooth' });
        restartAutoSlide();
      });
    });

    nextBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const maxScroll = track.scrollWidth - track.clientWidth;
        const step = getSingleCardStep();
        if (track.scrollLeft >= maxScroll - 15) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: step, behavior: 'smooth' });
        }
        restartAutoSlide();
      });
    });

    const booksSection = track.closest('.books-section');
    if (booksSection) {
      booksSection.addEventListener('mouseenter', stopAutoSlide);
      booksSection.addEventListener('mouseleave', startAutoSlide);
      booksSection.addEventListener('touchstart', stopAutoSlide, { passive: true });
      booksSection.addEventListener('touchend', () => {
        setTimeout(startAutoSlide, 2000);
      }, { passive: true });
    }

    track.addEventListener('scroll', () => {
      window.requestAnimationFrame(updateNavState);
    }, { passive: true });

    window.addEventListener('resize', () => {
      updateNavState();
    });

    // Initialize
    setTimeout(() => {
      updateNavState();
      startAutoSlide();
    }, 100);
  })();
</script>

<%- include('partials/footer') %>
