<aside class="dashboard-sidebar">
  <div class="dashboard-sidebar-header">
    <div class="sidebar-author-profile">
      <div class="sidebar-avatar-wrap">
        <% if (user && user.avatar) { %>
          <img src="<%= user.avatar %>" alt="<%= user.display_name %>" class="sidebar-avatar-img">
        <% } else { %>
          <div class="sidebar-logo-circle">
            <%= (user && user.display_name) ? user.display_name.charAt(0) : 'প' %>
          </div>
        <% } %>
      </div>
      <div class="sidebar-author-name">
        <%= (user && user.display_name) ? user.display_name : 'পয়স্তি লেখক' %>
      </div>
      <div>
        <span class="sidebar-author-role">
          <% if (user && user.role === 'admin') { %>
            এডমিন
          <% } else if (user && user.role === 'editor') { %>
            সম্পাদক
          <% } else { %>
            সম্মানিত লেখক
          <% } %>
        </span>
      </div>
    </div>
  </div>

  <ul class="sidebar-nav">
    <!-- Admin Shortcut (Only for admin or editor) -->
    <% if (user && (user.role === 'admin' || user.role === 'editor')) { %>
      <li style="margin-bottom: 12px;">
        <a href="/admin" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: #075603; color: #ffffff; border-radius: 8px; font-size: 14px; font-weight: 600; text-decoration: none; box-shadow: 0 2px 6px rgba(7, 86, 3, 0.25);">
          <span style="display: flex; align-items: center; gap: 8px;">🛡️ এডমিন প্যানেল</span>
          <span>&rarr;</span>
        </a>
      </li>
    <% } %>

    <li class="sidebar-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'dashboard' ? 'active' : '' %>">
      <a href="/author/dashboard">
        <span class="sidebar-nav-icon">📊</span>
        ড্যাশবোর্ড
      </a>
    </li>

    <li class="sidebar-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'new_post' ? 'active' : '' %>">
      <a href="/author/new-post">
        <span class="sidebar-nav-icon">✍️</span>
        নতুন পোস্ট
      </a>
    </li>

    <li class="sidebar-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'my_posts' ? 'active' : '' %>">
      <a href="/author/my-posts">
        <span class="sidebar-nav-icon">📑</span>
        আমার সব পোস্ট
      </a>
    </li>

    <li class="sidebar-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'profile' ? 'active' : '' %>">
      <a href="/author/profile">
        <span class="sidebar-nav-icon">👤</span>
        প্রোফাইল
      </a>
    </li>

    <li class="sidebar-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'spelling' ? 'active' : '' %>">
      <a href="/spelling-rules" target="_blank">
        <span class="sidebar-nav-icon">✔️</span>
        বানান শুদ্ধিকরণ
      </a>
    </li>

    <li class="sidebar-nav-item">
      <a href="/" target="_blank">
        <span class="sidebar-nav-icon">🌐</span>
        মূল ওয়েবসাইট
      </a>
    </li>
  </ul>

  <div class="sidebar-logout-btn">
    <a href="/logout">
      <span>🚪</span>
      লগ আউট
    </a>
  </div>
</aside>
