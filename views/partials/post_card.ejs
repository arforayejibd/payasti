<article class="post-card <%= typeof isSelected !== 'undefined' && isSelected ? 'post-card--featured' : 'post-card--latest' %>">
  <div class="post-card-body">
    <!-- Author Row -->
    <div class="post-card-author-row">
      <div class="post-card-avatar-wrap">
        <a href="/author/<%= encodeURIComponent(post.author_slug || '') %>" class="post-card-avatar-link">
          <% if (post.author_avatar) { %>
            <img src="<%= post.author_avatar %>" alt="<%= post.author_name %>" class="post-card-avatar-img" loading="lazy">
          <% } else { %>
            <div class="post-card-avatar-placeholder">
              <%= post.author_name ? post.author_name.charAt(0) : 'প' %>
            </div>
          <% } %>
        </a>
      </div>
      <div class="post-card-titles-wrap">
        <a href="/author/<%= encodeURIComponent(post.author_slug || '') %>" class="post-card-author-name">
          <%= post.author_name %>
        </a>
        <a href="/post/<%= encodeURIComponent(post.slug || '') %>" class="post-card-title" title="<%= post.title %>">
          <%= post.title %>
        </a>
      </div>
    </div>

    <!-- Excerpt -->
    <a href="/post/<%= encodeURIComponent(post.slug || '') %>" class="post-card-excerpt-link">
      <div class="post-card-excerpt"><%- formatCardExcerpt(post.content || post.excerpt) %></div>
    </a>
  </div>

  <!-- Meta Footer -->
  <div class="post-card-footer">
    <div class="post-card-category">
      <a href="/category/<%= encodeURIComponent(post.category_slug || '') %>" class="post-card-category-link">
        <%= post.category_name || 'অন্য সাহিত্য' %>
      </a>
    </div>
    <time class="post-card-date">
      <%= formatBengaliDate(post.published_at || post.created_at) %>
    </time>
  </div>
</article>
