<article class="post-card-item <%= typeof isSelected !== 'undefined' && isSelected ? 'post-card-selected' : 'post-card-latest' %>" data-id="<%= typeof isSelected !== 'undefined' && isSelected ? 'div_block-7-3916' : 'div_block-285-3916' %>">
  <div class="post-card-content-wrap" data-id="<%= typeof isSelected !== 'undefined' && isSelected ? 'div_block-710-2678' : 'div_block-1123-2678' %>">
    <!-- Author Row -->
    <div class="post-card-author-row" data-id="<%= typeof isSelected !== 'undefined' && isSelected ? 'div_block-10-3916' : 'div_block-286-3916' %>">
      <div class="post-author-avatar-box" data-id="<%= typeof isSelected !== 'undefined' && isSelected ? 'div_block-19-3916' : 'div_block-287-3916' %>">
        <a href="/author/<%= encodeURIComponent(post.author_slug || '') %>" class="post-avatar-link">
          <% if (post.author_avatar) { %>
            <img src="<%= post.author_avatar %>" alt="<%= post.author_name %>" class="post-author-avatar-img" loading="lazy">
          <% } else { %>
            <div class="post-author-avatar-placeholder">
              <%= post.author_name ? post.author_name.charAt(0) : 'প' %>
            </div>
          <% } %>
        </a>
      </div>
      <div class="post-author-info-box" data-id="<%= typeof isSelected !== 'undefined' && isSelected ? 'div_block-152-3916' : 'div_block-290-3916' %>">
        <a href="/author/<%= encodeURIComponent(post.author_slug || '') %>" class="post-author-name-link" data-id="<%= typeof isSelected !== 'undefined' && isSelected ? 'code_block-113-3916' : 'code_block-292-3916' %>">
          <%= post.author_name %>
        </a>
        <a href="/post/<%= encodeURIComponent(post.slug || '') %>" class="post-title-link" title="<%= post.title %>" data-id="<%= typeof isSelected !== 'undefined' && isSelected ? 'code_block-127-3916' : 'code_block-294-3916' %>">
          <%= post.title %>
        </a>
      </div>
    </div>

    <!-- Excerpt -->
    <a href="/post/<%= encodeURIComponent(post.slug || '') %>" class="post-excerpt-link">
      <div class="post-excerpt-text" data-id="<%= typeof isSelected !== 'undefined' && isSelected ? 'code_block-181-3916' : 'code_block-1128-2678' %>"><%- formatCardExcerpt(post.excerpt || post.content) %></div>
    </a>
  </div>

  <!-- Meta Footer -->
  <div class="post-card-meta-row" data-id="<%= typeof isSelected !== 'undefined' && isSelected ? 'div_block-244-3916' : 'div_block-297-3916' %>">
    <div class="post-meta-category" data-id="<%= typeof isSelected !== 'undefined' && isSelected ? 'text_block-250-3916' : 'text_block-298-3916' %>">
      <a href="/category/<%= encodeURIComponent(post.category_slug || '') %>" class="post-category-link">
        <%= post.category_name || 'অন্য সাহিত্য' %>
      </a>
    </div>
    <div class="post-meta-date" data-id="<%= typeof isSelected !== 'undefined' && isSelected ? 'text_block-262-3916' : 'text_block-300-3916' %>">
      <%= formatBengaliDate(post.published_at || post.created_at) %>
    </div>
  </div>
</article>
