<%- include('partials/header') %>

<main class="container" style="padding: 80px 16px; text-align: center;">
  <div style="max-width: 500px; margin: 0 auto; background: #ffffff; padding: 40px; border-radius: 8px; border: 1px solid #e5e7eb; box-shadow: var(--shadow-sm);">
    <div style="font-size: 48px; color: var(--primary); margin-bottom: 12px;">⚠️</div>
    <h1 style="font-size: 22px; font-weight: 700; color: #111; margin-bottom: 8px;"><%= title %></h1>
    <p style="font-size: 14px; color: #666; margin-bottom: 24px; line-height: 1.6;"><%= message %></p>
    <a href="/" class="btn-primary-action" style="padding: 10px 24px;">প্রচ্ছদে ফিরে যান</a>
  </div>
</main>

<%- include('partials/footer') %>
