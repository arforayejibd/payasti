<%- include('partials/header') %>

<main class="page-main-content">
  <section class="site-section authors-hero-section">
    <div class="site-container">
      <div class="authors-intro-card">
        <h1 class="page-title authors-page-title">পয়স্তিতে যারা লিখেছেন</h1>
        <p class="authors-intro-desc">
          পয়স্তি গর্বের সাথে উপস্থাপন করছে প্রতিভাবান লেখকের একটি বিশাল দল, যারা তাঁদের জ্ঞান এবং অভিজ্ঞতার মাধ্যমে পয়স্তিকে সমৃদ্ধ করছেন। আমাদের লেখকগণ সাহিত্যে অত্যন্ত দক্ষ এবং মানসম্পন্ন লেখালেখি করেন। প্রতিটি লেখকের উচ্চমানের কবিতা, গল্প, প্রবন্ধসহ বিভিন্ন ধরনের সাহিত্য পয়স্তিতে প্রকাশ করা হয়।
        </p>
      </div>
    </div>
  </section>

  <section class="site-section authors-list-section">
    <div class="site-container">
      <div class="author-search-bar">
        <form class="author-search-form" action="/লেখক-তালিকা/" method="get">
          <input class="author-search-input" type="text" name="author_search" id="author_search" placeholder="লেখকের নাম লিখুন..." value="<%= searchQuery || '' %>">
          <button type="submit" class="author-search-btn">অনুসন্ধান</button>
        </form>
        <span class="author-count-badge">
          মোট লেখক: <%= toBengaliNumber(totalAuthorsOverall) %> জন
        </span>
      </div>

      <% if (authors && authors.length) { %>
        <div class="authors-grid">
          <% authors.forEach(author => { %>
            <div class="author-card">
              <a href="/author/<%= encodeURIComponent(author.nicename || author.username) %>/" class="author-card-avatar-wrap">
                <% if (author.avatar) { %>
                  <img src="<%= author.avatar %>" alt="<%= author.display_name %>" class="author-card-avatar-img">
                <% } else { %>
                  <div class="author-card-avatar-placeholder">
                    <%= author.display_name ? author.display_name.charAt(0) : 'প' %>
                  </div>
                <% } %>
              </a>
              <div class="author-meta">
                <h3 class="author-card-name">
                  <a href="/author/<%= encodeURIComponent(author.nicename || author.username) %>/">
                    <%= author.display_name %>
                  </a>
                </h3>
                <% if (author.recentPosts && author.recentPosts.length) { %>
                  <ul class="author-recent-posts">
                    <% author.recentPosts.forEach(post => { %>
                      <li>
                        <a href="/post/<%= encodeURIComponent(post.slug) %>" title="<%= post.title %>">
                          <%= post.title %>
                        </a>
                      </li>
                    <% }) %>
                  </ul>
                <% } else { %>
                  <p class="author-no-posts">কোনো সাম্প্রতিক লেখা নেই</p>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="no-authors-found">
          <p>"<%= searchQuery %>" নামের কোনো লেখক খুঁজে পাওয়া যায়নি।</p>
        </div>
      <% } %>

      <% if (pagination && pagination.totalPages > 1) { %>
        <div style="margin-top: 40px;">
          <%- include('partials/pagination', { pagination: pagination }) %>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
