<%- include('partials/author_layout_start', { 
  pageTitle: 'লেখক ড্যাশবোর্ড', 
  pageBreadcrumb: 'ড্যাশবোর্ড', 
  activeMenu: 'dashboard', 
  user: user, 
  seo: seo
}) %>

<!-- 1. Notice Ribbon (only shown when admin publishes an active notice with content) -->
<% if (typeof notices !== 'undefined' && notices && notices.length > 0 && notices[0].content && notices[0].content.trim()) { %>
  <div class="author-notice-ribbon">
    <div class="notice-ribbon-left">
      <span class="notice-ribbon-tag"><%= notices[0].title || 'বিজ্ঞপ্তি' %></span>
      <span><%= notices[0].content %></span>
    </div>
    <% if (notices[0].link) { %>
      <a href="<%= notices[0].link %>" class="notice-ribbon-link">বিস্তারিত দেখুন &rarr;</a>
    <% } %>
  </div>
<% } %>

<!-- 2. Streamlined Author Literary Hero Card -->
<div class="author-hero-card">
  <div class="author-hero-content">
    <div class="author-hero-main-wrap">
      <div class="author-hero-profile">
        <% 
          const uViews = Number(stats ? stats.totalViews : 0);
          const uPosts = Number(stats ? stats.approved : 0);
          const uBadge = typeof getAuthorTopBadge === 'function' ? getAuthorTopBadge(uViews, uPosts) : null;
        %>
        <%- include('../partials/author_avatar_badge', { 
          avatar: user && user.avatar ? user.avatar : '/images/default-avatar.png', 
          name: user && user.display_name ? user.display_name : 'লেখক', 
          views: uViews, 
          posts: uPosts, 
          size: 'lg',
          wrapClass: 'author-hero-avatar-wrap'
        }) %>
        <div class="author-hero-info">
          <div class="author-hero-greeting">
            <span class="hero-greeting-tag">✨ <%= typeof greeting !== 'undefined' ? greeting : 'স্বাগতম' %></span>
            <% if (uBadge) { %>
              <%- include('../partials/author_badge_tag', { views: uViews, posts: uPosts }) %>
            <% } %>
          </div>
          <h1 class="author-hero-name">
            <%= user && user.display_name ? user.display_name : 'সম্মানিত লেখক' %>
          </h1>
        </div>
      </div>

      <!-- Compact Next Milestone Progress Bar (Below Avatar & Name Row) -->
      <% if (typeof nextMilestone !== 'undefined' && nextMilestone) { %>
        <% let progressPercent = Math.min(100, Math.round((nextMilestone.current / nextMilestone.target) * 100)); %>
        <div class="hero-milestone-pill" title="পরবর্তী সম্মাননা অর্জনের অগ্রগতি">
          <span class="milestone-label">🎯 পরবর্তী পদক: <strong><%= nextMilestone.title %></strong> (<%= toBengaliNumber(nextMilestone.current) %>/<%= toBengaliNumber(nextMilestone.target) %>)</span>
          <div class="hero-milestone-progress">
            <div class="hero-milestone-fill" style="width: <%= progressPercent %>%;"></div>
          </div>
        </div>
      <% } %>

      <div class="author-hero-meta-row">
        <% if (typeof publicProfileUrl !== 'undefined') { %>
          <a href="<%= publicProfileUrl %>" target="_blank" class="author-hero-public-link" title="পাঠকরা আপনার প্রোফাইল যেভাবে দেখেন">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            <span>পাবলিক প্রোফাইল দেখুন ↗</span>
          </a>
        <% } %>
        <span class="author-hero-meta-sep">•</span>
        <span class="author-hero-duration">
          পয়স্তিতে সাহিত্যচর্চা: <strong><%= stats.duration %></strong>
        </span>
      </div>
    </div>
    <div class="author-hero-actions">
      <a href="/author/new-post" class="hero-btn-primary" title="নতুন সাহিত্য রচনা জমা দিন">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
        <span>নতুন লেখা জমা দিন</span>
      </a>
      <a href="/author/my-posts" class="hero-btn-secondary" title="আপনার সকল সাহিত্য দেখুন">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
        <span>আমার লেখাসমূহ</span>
      </a>
    </div>
  </div>
</div>

<!-- 3. Clean 4-Card Writer Performance Stats Grid -->
<div class="author-stats-grid-4">
  <!-- Stat 1: Published Posts -->
  <a href="/author/my-posts?status=publish" class="interactive-stat-card" title="অনুমোদিত ও প্রকাশিত সাহিত্য">
    <div class="stat-icon-box stat-icon-green">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      </svg>
    </div>
    <div class="stat-meta">
      <div class="stat-val"><%= toBengaliNumber(stats.approved) %><span class="stat-unit">টি</span></div>
      <div class="stat-lbl">প্রকাশিত সাহিত্য</div>
    </div>
  </a>

  <!-- Stat 2: Pending Review -->
  <a href="/author/my-posts?status=pending" class="interactive-stat-card" title="সম্পাদকীয় পর্যালোচনায় থাকা সাহিত্য">
    <div class="stat-icon-box stat-icon-amber">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
    </div>
    <div class="stat-meta">
      <div class="stat-val"><%= toBengaliNumber(stats.pending) %><span class="stat-unit">টি</span></div>
      <div class="stat-lbl">পর্যালোচনায় রয়েছে</div>
    </div>
  </a>

  <!-- Stat 3: Drafts -->
  <a href="/author/my-posts?status=draft" class="interactive-stat-card" title="অপ্রকাশিত খসড়া সাহিত্য">
    <div class="stat-icon-box stat-icon-purple">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
      </svg>
    </div>
    <div class="stat-meta">
      <div class="stat-val"><%= toBengaliNumber(stats.draft) %><span class="stat-unit">টি</span></div>
      <div class="stat-lbl">খসড়া সাহিত্য</div>
    </div>
  </a>

  <!-- Stat 4: Total Views & Readership -->
  <div class="interactive-stat-card" style="cursor: default;" title="আপনার সকল লেখার সম্মিলিত পাঠসংখ্যা">
    <div class="stat-icon-box stat-icon-blue">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    </div>
    <div class="stat-meta">
      <div class="stat-val"><%= toBengaliNumber(stats.totalViews) %></div>
      <div class="stat-lbl">
        মোট পাঠক ও ভিউ
        <% if (stats.totalComments > 0) { %>
          <span style="font-size: 13px; color: var(--admin-primary); margin-left: 4px;">• 💬 <%= toBengaliNumber(stats.totalComments) %></span>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- 4. Two-Column Writer's Studio Layout -->
<% 
  const currentRecentPosts = typeof recentPosts !== 'undefined' ? recentPosts : [];
  const currentTopPosts = typeof topPosts !== 'undefined' ? topPosts : [];
  const currentComments = typeof recentComments !== 'undefined' ? recentComments : [];
  const currentCategoryStats = typeof categoryStats !== 'undefined' ? categoryStats : [];
%>

<div class="author-dashboard-grid-2">
  <!-- ================= LEFT COLUMN: Primary Workspace & Writings Stream ================= -->
  <div style="display: flex; flex-direction: column; gap: 24px;">
    
    <!-- 1. My Recent Writings & Editorial Status -->
    <div class="author-recent-works-card">
      <div class="admin-card-header" style="border-bottom: 1px solid var(--admin-border);">
        <div class="admin-card-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color: var(--admin-primary);">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
          <span>আমার সাম্প্রতিক সাহিত্য ও স্ট্যাটাস</span>
          <% if (currentRecentPosts && currentRecentPosts.length > 0) { %>
            <span class="admin-card-badge"><%= toBengaliNumber(currentRecentPosts.length) %> টি</span>
          <% } %>
        </div>
        <a href="/author/my-posts" style="font-size: 14.5px; font-weight: 600; color: var(--admin-primary); text-decoration: none;">
          সকল সাহিত্য &rarr;
        </a>
      </div>

      <div class="author-works-stream">
        <% if (currentRecentPosts && currentRecentPosts.length > 0) { %>
          <% currentRecentPosts.forEach(post => { %>
            <div class="author-work-item">
              <div class="work-item-top">
                <div class="work-item-meta">
                  <span class="work-cat-chip"><%= post.category_name || 'অন্য সাহিত্য' %></span>
                  
                  <% if (post.status === 'publish') { %>
                    <span class="work-status-badge publish">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      প্রকাশিত
                    </span>
                    <span class="work-views-badge" title="মোট পাঠক সংখ্যা">
                      👁️ <%= toBengaliNumber(post.views || 0) %> ভিউ
                    </span>
                  <% } else if (post.status === 'pending') { %>
                    <span class="work-status-badge pending">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      পর্যালোচনায়
                    </span>
                  <% } else { %>
                    <span class="work-status-badge draft">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                      খসড়া
                    </span>
                  <% } %>
                </div>

                <div class="work-item-date">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  <span><%= formatBengaliDate(post.published_at || post.created_at) %></span>
                </div>
              </div>

              <a href="<%= post.status === 'publish' ? '/post/' + encodeURIComponent(post.slug) : '/author/post/' + post.id + '/edit' %>" 
                 class="work-item-title" 
                 target="<%= post.status === 'publish' ? '_blank' : '_self' %>"
                 title="<%= post.title %>">
                <%= post.title %>
              </a>

              <% if (post.excerpt) { %>
                <p class="work-item-excerpt"><%= post.excerpt %></p>
              <% } else if (post.content) { %>
                <p class="work-item-excerpt"><%= post.content.replace(/<[^>]+>/g, ' ').substring(0, 130) %>...</p>
              <% } %>

              <div class="work-item-bottom">
                <div style="font-size: 13.5px; color: var(--admin-text-muted);">
                  <% if (post.status === 'publish') { %>
                    <span style="color: #10b981; font-weight: 600;">● লাইভ আর্কাইভে পাঠকদের জন্য উন্মুক্ত</span>
                  <% } else if (post.status === 'pending') { %>
                    <span style="color: #f59e0b; font-weight: 600;">● সম্পাদক মণ্ডলীর পর্যালোচনায় রয়েছে</span>
                  <% } else { %>
                    <span style="color: #8b5cf6; font-weight: 600;">● অপ্রকাশিত খসড়া হিসেবে সংরক্ষিত</span>
                  <% } %>
                </div>

                <div class="work-item-actions">
                  <% if (post.status === 'publish') { %>
                    <a href="/post/<%= encodeURIComponent(post.slug) %>" target="_blank" class="work-btn" title="লাইভ পেজ দেখুন">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                      <span>দেখুন ↗</span>
                    </a>
                  <% } %>
                  <a href="/author/post/<%= post.id %>/edit" class="work-btn" title="সম্পাদনা করুন">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    <span>সম্পাদনা</span>
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="admin-empty-state" style="padding: 48px 20px;">
            <div class="empty-icon" style="background: rgba(16, 185, 129, 0.12); color: #10b981; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
              ✍️
            </div>
            <div class="empty-title" style="font-size: 21px; font-weight: 700; color: var(--admin-text-main); margin-bottom: 6px;">আপনার সাহিত্যিক যাত্রা শুরু করুন 🍃</div>
            <div class="empty-desc" style="font-size: 15px; color: var(--admin-text-muted); max-width: 420px; margin: 0 auto 18px;">পয়স্তি সাহিত্য ম্যাগাজিনে আপনার একটি নতুন কবিতা, গল্প বা প্রবন্ধ প্রকাশ করুন।</div>
            <a href="/author/new-post" class="hero-btn-primary" style="display: inline-flex; font-size: 16px; padding: 9px 20px;">
              নতুন লেখা রচনা করুন &rarr;
            </a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- 2. Compact Literary Scratchpad (Writer's Notebook) -->
    <div class="author-mini-scratchpad">
      <div class="mini-scratch-header">
        <div class="mini-scratch-title">
          <span>💡 লেখকের নোটবুক ও তাত্ক্ষণিক সাহিত্য ভাবনা</span>
        </div>
        <span class="scratchpad-status" id="scratchpadStatus">সংরক্ষিত ✓</span>
      </div>
      
      <textarea id="authorScratchpad" class="scratchpad-textarea" style="min-height: 110px; font-size: 18px;" placeholder="আপনার তাৎক্ষণিক ভাবনা, কবিতার পঙ্‌ক্তি বা লেখার খসড়া এখানে লিখে রাখুন... (স্বয়ংক্রিয়ভাবে সংরক্ষিত থাকবে)"></textarea>
      
      <div class="scratchpad-footer">
        <div class="scratchpad-actions">
          <button type="button" class="scratchpad-btn" id="btnCopyScratchpad" title="কপিবোর্ডে কপি করুন">
            📋 কপি
          </button>
          <button type="button" class="scratchpad-btn" id="btnClearScratchpad" title="নোট মুছুন">
            মুছুন
          </button>
        </div>
        <button type="button" class="scratchpad-btn primary" id="btnTransferToPost" title="এই নোটটি নতুন লেখার এডিটরে নিয়ে যান">
          ✍️ নতুন লেখায় পাঠান &raquo;
        </button>
      </div>
    </div>

  </div>

  <!-- ================= RIGHT COLUMN: Performance & Reader Connection ================= -->
  <div style="display: flex; flex-direction: column; gap: 24px;">

    <!-- 1. Top Read Writings with One-Click Social Share -->
    <div class="admin-card" style="margin-bottom: 0;">
      <div class="admin-card-header">
        <div class="admin-card-title">
          <span>🏆 সর্বাধিক পঠিত সাহিত্য</span>
        </div>
        <a href="/author/my-posts" style="font-size: 14px; color: var(--admin-primary); font-weight: 600; text-decoration: none;">
          সকল লেখা &raquo;
        </a>
      </div>

      <div class="admin-card-body" style="padding: 0;">
        <% if (currentTopPosts && currentTopPosts.length) { %>
          <div style="display: flex; flex-direction: column;">
            <% currentTopPosts.forEach((post, index) => { %>
              <% const postUrl = 'https://payasti.com/post/' + encodeURIComponent(post.slug); %>
              <div class="top-writing-row">
                <!-- Rank Badge -->
                <div class="rank-badge rank-<%= index === 0 ? '1' : (index === 1 ? '2' : (index === 2 ? '3' : 'other')) %>">
                  <%= toBengaliNumber(index + 1) %>
                </div>

                <!-- Main Info -->
                <div class="writing-main-col">
                  <a href="/post/<%= encodeURIComponent(post.slug) %>" target="_blank" class="writing-post-title" title="<%= post.title %>">
                    <%= post.title %>
                  </a>
                  <div class="writing-meta-row">
                    <% if (post.category_name) { %>
                      <span class="writing-cat-tag"><%= post.category_name %></span>
                    <% } %>
                    <span><%= formatBengaliDate(post.published_at) %></span>
                  </div>
                </div>

                <!-- Actions: Views + Social Share -->
                <div class="writing-actions-col">
                  <span class="writing-views-pill" title="মোট ভিউ সংখ্যা">
                    <%= toBengaliNumber(post.views) %> ভিউ
                  </span>

                  <!-- Facebook Share Button -->
                  <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(postUrl) %>" target="_blank" rel="noopener noreferrer" class="social-share-btn" title="ফেসবুকে শেয়ার করুন">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                  </a>

                  <!-- Copy Link Button -->
                  <button type="button" class="social-share-btn copy" onclick="copyPostLink('<%= postUrl %>')" title="লিংক কপি করুন">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                  </button>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="admin-empty-state" style="padding: 28px 12px;">
            <div style="font-size: 26px; margin-bottom: 6px;">📖</div>
            <div class="empty-title" style="font-size: 16px;">পঠিত লেখার তালিকা এখনো খালি</div>
            <div class="empty-desc" style="font-size: 13.5px;">আপনার লেখা প্রকাশিত হলে এখানে পাঠকপ্রিয়তার তালিকা দেখতে পাবেন।</div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- 2. Recent Reader Feedback / Comments -->
    <div class="admin-card" style="margin-bottom: 0;">
      <div class="admin-card-header">
        <div class="admin-card-title">
          <span>💬 পাঠকদের সাম্প্রতিক প্রতিক্রিয়া</span>
        </div>
        <% if (stats.totalComments > 0) { %>
          <span class="admin-badge admin-badge-published" style="font-size: 13px;">
            মোট <%= toBengaliNumber(stats.totalComments) %> টি
          </span>
        <% } %>
      </div>

      <div class="admin-card-body" style="padding: 0;">
        <% if (currentComments && currentComments.length > 0) { %>
          <% currentComments.forEach(comment => { %>
            <div class="recent-comment-item">
              <div class="comment-meta-header">
                <span class="commenter-name">
                  👤 <%= comment.author_name || 'পাঠক' %>
                </span>
                <span class="comment-date">
                  <%= formatBengaliDate(comment.created_at) %>
                </span>
              </div>
              <div class="comment-snippet">
                “<%= comment.content %>”
              </div>
              <div class="comment-target-post">
                লেখা: <a href="/post/<%= encodeURIComponent(comment.post_slug) %>" target="_blank"><%= comment.post_title %></a>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div style="padding: 24px 20px; text-align: center; color: var(--admin-text-muted);">
            <div style="font-size: 26px; margin-bottom: 4px;">💌</div>
            <div style="font-size: 15px; font-weight: 600; color: var(--admin-text-main); margin-bottom: 4px;">এখনো কোনো নতুন মন্তব্য নেই</div>
            <div style="font-size: 13px; line-height: 1.5; max-width: 300px; margin: 0 auto;">
              আপনার প্রকাশিত লেখাগুলো পাঠকদের সাথে শেয়ার করুন যাতে পাঠকরা মতামত জানাতে পারেন।
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- 3. Category Breakdown & Readership Performance (if exists) -->
    <% if (currentCategoryStats && currentCategoryStats.length > 1) { %>
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <span>📊 সাহিত্য বিভাগ বিশ্লেষণ</span>
          </div>
          <span class="admin-badge admin-badge-published"><%= toBengaliNumber(currentCategoryStats.length) %> টি বিভাগ</span>
        </div>
        <div class="admin-card-body" style="padding: 16px 20px;">
          <div class="category-analytics-list">
            <% 
              const maxCatViews = Math.max(...currentCategoryStats.map(c => c.total_views || 0), 1);
            %>
            <% currentCategoryStats.forEach(cat => { %>
              <% 
                const catPercent = Math.min(100, Math.round(((cat.total_views || 0) / maxCatViews) * 100));
              %>
              <div class="cat-stat-row" style="margin-bottom: 12px;">
                <div class="cat-stat-header" style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 4px;">
                  <span style="font-weight: 600; color: var(--admin-text-main);"><%= cat.category_name || 'অন্যান্য' %></span>
                  <span style="color: var(--admin-text-muted);"><%= toBengaliNumber(cat.post_count) %>টি • 👁️ <%= toBengaliNumber(cat.total_views) %></span>
                </div>
                <div class="cat-progress-track" style="height: 5px; background: var(--admin-border); border-radius: 9999px; overflow: hidden;">
                  <div class="cat-progress-fill" style="width: <%= catPercent %>%; height: 100%; background: var(--admin-primary); border-radius: 9999px;"></div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% } %>

    <!-- 4. Subtle Daily Inspiration Quote -->
    <% if (typeof dailyQuote !== 'undefined' && dailyQuote) { %>
      <div style="background: var(--admin-card-bg); border: 1px dashed var(--admin-border); border-radius: 12px; padding: 16px 18px;">
        <div style="font-size: 15px; font-style: italic; color: var(--admin-text-main); line-height: 1.5; margin-bottom: 6px;">
          “<%= dailyQuote.quote %>”
        </div>
        <div style="font-size: 13px; color: var(--admin-primary); font-weight: 600; text-align: right;">
          — <%= dailyQuote.author %>
        </div>
      </div>
    <% } %>

  </div>
</div>

<!-- Floating Toast Notification for Link Copy -->
<div id="dashboardToast" class="dashboard-toast">
  লিংক কপি করা হয়েছে! ✓
</div>

<script>
  (function() {
    // 1. Scratchpad Storage & Auto-save
    const scratchpad = document.getElementById('authorScratchpad');
    const statusElem = document.getElementById('scratchpadStatus');
    const storageKey = 'payasti_author_scratchpad_<%= user && user.id ? user.id : 0 %>';

    if (scratchpad) {
      const saved = localStorage.getItem(storageKey);
      if (saved) scratchpad.value = saved;

      let saveTimeout;
      scratchpad.addEventListener('input', function() {
        if (statusElem) statusElem.textContent = 'টাইপ করছেন...';
        clearTimeout(saveTimeout);
        saveTimeout = setTimeout(function() {
          localStorage.setItem(storageKey, scratchpad.value);
          if (statusElem) statusElem.textContent = 'সংরক্ষিত ✓';
        }, 500);
      });
    }

    // 2. Scratchpad Copy
    const btnCopy = document.getElementById('btnCopyScratchpad');
    if (btnCopy && scratchpad) {
      btnCopy.addEventListener('click', function() {
        if (!scratchpad.value.trim()) return;
        navigator.clipboard.writeText(scratchpad.value).then(function() {
          showToast('নোট কপিবোর্ডে কপি হয়েছে! ✓');
        });
      });
    }

    // 3. Scratchpad Clear
    const btnClear = document.getElementById('btnClearScratchpad');
    if (btnClear && scratchpad) {
      btnClear.addEventListener('click', function() {
        if (confirm('আপনি কি নিশ্চিত যে এই নোটটি মুছে ফেলতে চান?')) {
          scratchpad.value = '';
          localStorage.removeItem(storageKey);
          if (statusElem) statusElem.textContent = 'মুছে ফেলা হয়েছে';
        }
      });
    }

    // 4. Transfer to New Post Editor
    const btnTransfer = document.getElementById('btnTransferToPost');
    if (btnTransfer && scratchpad) {
      btnTransfer.addEventListener('click', function() {
        const text = scratchpad.value.trim();
        if (!text) {
          alert('অনুগ্রহ করে প্রথমে কিছু লিখুন।');
          return;
        }
        sessionStorage.setItem('payasti_transfer_post_content', text);
        window.location.href = '/author/new-post';
      });
    }

    // 5. Toast notification helper
    window.showToast = function(msg) {
      const toast = document.getElementById('dashboardToast');
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(function() {
        toast.classList.remove('show');
      }, 2500);
    };

    // 6. Copy Post Link
    window.copyPostLink = function(url) {
      navigator.clipboard.writeText(url).then(function() {
        showToast('লেখার লিংক কপি করা হয়েছে! ✓');
      }).catch(function() {
        const temp = document.createElement('input');
        temp.value = url;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand('copy');
        document.body.removeChild(temp);
        showToast('লেখার লিংক কপি করা হয়েছে! ✓');
      });
    };
  })();
</script>

<%- include('partials/author_layout_end') %>
