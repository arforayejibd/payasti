<%- include('partials/author_layout_start', { 
  pageTitle: 'নতুন লেখা জমা দিন', 
  pageBreadcrumb: 'নতুন পোস্ট', 
  activeMenu: 'new_post', 
  user: user, 
  seo: seo,
  topbarButton: { text: 'সকল লেখায় ফিরে যান', url: '/author/my-posts' }
}) %>

<!-- Quill Rich Text Editor Styles -->
<link rel="stylesheet" href="/vendor/quill/quill.snow.css">

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background: #fef2f2; border: 1.5px solid #fecaca; color: #b91c1c; padding: 14px 20px; border-radius: 8px; margin-bottom: 20px; font-size: 15px; font-weight: 500;">
    ⚠️ <%= error %>
  </div>
<% } %>

<% if (typeof success !== 'undefined' && success) { %>
  <div style="background: #f0fdf4; border: 1.5px solid #bbf7d0; color: #15803d; padding: 14px 20px; border-radius: 8px; margin-bottom: 20px; font-size: 15px; font-weight: 500;">
    ✅ <%= success %>
  </div>
<% } %>

<form action="/author/new-post" method="POST" enctype="multipart/form-data" id="postForm">
  <!-- 2-Column Responsive Layout Matching Admin Panel -->
  <div class="admin-editor-layout">
    
    <!-- বাম পাশের মূল কলাম (শিরোনাম, এডিটর ও সারাংশ) -->
    <div class="admin-editor-main">
      <!-- শিরোনাম বক্স -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-primary);">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span>লেখার শিরোনাম *</span>
          </div>
        </div>
        <div class="admin-card-body">
          <input 
            type="text" 
            name="title" 
            id="postTitleInput"
            class="admin-form-input" 
            required 
            placeholder="এখানে সুন্দর একটি শিরোনাম লিখুন..." 
            style="font-size: 18px; font-weight: 600; padding: 12px 16px;"
          >
        </div>
      </div>

      <!-- মূল লেখা (কুইল রিচ টেক্সট এডিটর) -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
          <div class="admin-card-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-primary);">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            <span>মূল সাহিত্য / লেখা *</span>
          </div>

          <button type="button" id="toggleSpellingGuide" class="btn-view-site" style="padding: 5px 12px; font-size: 13px;">
            📖 বাংলা বানান সহায়িকা
          </button>
        </div>

        <div class="admin-card-body" style="padding: 16px;">
          <!-- Quick Spelling Rules Accordion Guide -->
          <div id="spellingGuideBox" class="spelling-guide-box" style="display: none; margin-bottom: 14px;">
            <strong>📌 দ্রুত বানান সহায়িকা:</strong>
            <ul style="margin: 8px 0 0 20px; padding: 0;">
              <li>রেফ (র্)-এর পর ব্যঞ্জনবর্ণের দ্বিত্ব হবে না (যেমন: <em>কর্ম, সূর্য, অর্জন</em>; কর্ম্ম বা সূর্য্য নয়)।</li>
              <li>সকল বিদেশি শব্দে সর্বদা ‘স’ ও হ্রস্ব-ইকার ‘ি’ হবে ( যেমন: <em>স্টেশন, কর্নিশ, জানুয়ারি</em>)।</li>
              <li>‘ণ/ন’ নিয়ম: ট-বর্গে মূর্ধন্য ‘ণ’ (<em>ঘণ্টা, বণ্টন</em>) এবং ত-বর্গে দন্ত্য ‘ন’ (<em>শান্ত, গ্রন্থ</em>)।</li>
              <li>সাধু ও চলিত ভাষার মিশ্রণ (গুরুচণ্ডালী দোষ) পরিহার করুন।</li>
            </ul>
          </div>

          <!-- Quill Editor Container -->
          <div class="payasti-editor-wrapper">
            <div id="quillEditor" style="min-height: 380px;"></div>
          </div>
          <!-- Hidden input holding the HTML content for form submission -->
          <input type="hidden" name="content" id="postContentInput">

          <!-- Live Word Count & Reading Time Stats -->
          <div class="writing-stats-bar" style="margin-top: 10px;">
            <div class="stat-pill">
              <span>শব্দ সংখ্যা:</span>
              <strong id="statWordCount">০</strong>
            </div>
            <div class="stat-pill">
              <span>অক্ষর:</span>
              <strong id="statCharCount">০</strong>
            </div>
            <div class="stat-pill">
              <span>আনুমানিক পাঠসময়:</span>
              <strong id="statReadingTime">১ মিনিট</strong>
            </div>
            <div class="stat-pill draft-status" id="draftStatusPill" style="margin-left: auto;">
              <span id="draftStatusText">খসড়া প্রস্তুত</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ডান পাশের সাইডবার কলাম (অ্যাকশন ও মেটাডাটা) -->
    <div class="admin-editor-sidebar">
      <!-- প্রকাশনা নিয়ন্ত্রণ বক্স -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-primary);">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>প্রকাশনা নিয়ন্ত্রণ</span>
          </div>
        </div>
        <div class="admin-card-body" style="display: flex; flex-direction: column; gap: 14px;">
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; font-size: 13px; color: #475569; line-height: 1.5;">
            ℹ️ আপনার জমা দেওয়া লেখাটি পর্যালোচনার জন্য সম্পাদকের টেবিলে জমা হবে এবং অনুমোদনের পর প্রকাশিত হবে।
          </div>

          <button type="submit" class="btn-new-action" style="width: 100%; justify-content: center; padding: 12px 18px; font-size: 16px;">
            🚀 লেখা জমা দিন
          </button>
          <a href="/author/my-posts" class="btn-view-site" style="width: 100%; justify-content: center; padding: 10px; font-size: 15px; text-decoration: none;">
            বাতিল করুন
          </a>
        </div>
      </div>

      <!-- সাহিত্য বিভাগ -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-primary);">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>সাহিত্য বিভাগ *</span>
          </div>
        </div>
        <div class="admin-card-body">
          <select name="category_id" class="admin-form-select" required style="width: 100%;">
            <option value="">-- বিভাগ নির্বাচন করুন --</option>
            <% if (categories && categories.length) { 
                 const rootCats = categories.filter(c => !c.parent_id || c.parent_id === 0);
                 rootCats.forEach(cat => {
                   const children = categories.filter(c => c.parent_id === cat.id);
            %>
              <option value="<%= cat.id %>" style="font-weight: 700;"><%= cat.name %></option>
              <% children.forEach(child => { %>
                <option value="<%= child.id %>">&nbsp;&nbsp;&nbsp;— <%= child.name %></option>
              <% }) %>
            <%   });
               } %>
          </select>
        </div>
      </div>

      <!-- প্রচ্ছদ / ফিচার্ড ছবি (মিডিয়া মডাল ড্রপজোন) -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-primary);">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span>প্রচ্ছদ ছবি (ঐচ্ছিক)</span>
          </div>
        </div>
        <div class="admin-card-body">
          <div class="payasti-image-dropzone" data-name="featured_image" data-prompt="প্রচ্ছদ ছবি ড্র্যাগ করে ছাড়ুন অথবা ক্লিক করুন" data-hint="ক্লিক করে মিডিয়া লাইব্রেরি থেকে ছবি বাছুন"></div>
        </div>
      </div>

      <!-- ট্যাগসমূহ -->
      <div class="admin-card" style="margin-bottom: 0;">
        <div class="admin-card-header">
          <div class="admin-card-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-primary);">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
            <span>ট্যাগসমূহ</span>
          </div>
        </div>
        <div class="admin-card-body">
          <input 
            type="text" 
            name="tags" 
            id="postTagsInput"
            class="admin-form-input" 
            placeholder="কবিতা, আধুনিক, প্রেম (কমা দিয়ে লিখুন)"
          >
          <span style="font-size: 13px; color: var(--admin-text-sub); display: block; margin-top: 6px;">
            একাধিক ট্যাগ কমা (,) দিয়ে আলাদা করুন
          </span>
        </div>
      </div>

    </div>
  </div>
</form>

<!-- Quill Editor Scripts -->
<script src="/vendor/quill/quill.min.js"></script>
<script src="/js/payasti-quill.js"></script>

<script>
  (function () {
    const STORAGE_KEY = 'payasti_author_draft_new_post';

    const quill = window.createPayastiEditor('#quillEditor', {
      placeholder: 'সম্পূর্ণ সাহিত্যকর্ম, কবিতা, প্রবন্ধ বা গল্প এখানে লিখুন...'
    });

    const form = document.getElementById('postForm');
    const titleInput = document.getElementById('postTitleInput');
    const tagsInput = document.getElementById('postTagsInput');
    const contentInput = document.getElementById('postContentInput');
    const wordCountEl = document.getElementById('statWordCount');
    const charCountEl = document.getElementById('statCharCount');
    const readingTimeEl = document.getElementById('statReadingTime');
    const draftStatusText = document.getElementById('draftStatusText');
    const toggleSpellingBtn = document.getElementById('toggleSpellingGuide');
    const spellingBox = document.getElementById('spellingGuideBox');

    function toBn(num) {
      const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      return String(num).replace(/\d/g, d => bnDigits[d]);
    }

    if (toggleSpellingBtn && spellingBox) {
      toggleSpellingBtn.addEventListener('click', () => {
        spellingBox.style.display = spellingBox.style.display === 'none' ? 'block' : 'none';
      });
    }

    function updateWritingStats() {
      const text = quill.getText().trim();
      const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
      const chars = text.length;
      const readingMinutes = Math.max(1, Math.ceil(words / 150));

      if (wordCountEl) wordCountEl.textContent = toBn(words);
      if (charCountEl) charCountEl.textContent = toBn(chars);
      if (readingTimeEl) readingTimeEl.textContent = `${toBn(readingMinutes)} মিনিট`;
    }

    let saveTimeout = null;
    function autoSaveDraft() {
      if (draftStatusText) draftStatusText.textContent = 'সংরক্ষণ হচ্ছে...';
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(() => {
        try {
          const draftData = {
            title: titleInput ? titleInput.value : '',
            content: quill.root.innerHTML,
            tags: tagsInput ? tagsInput.value : '',
            timestamp: Date.now()
          };
          localStorage.setItem(STORAGE_KEY, JSON.stringify(draftData));
          if (draftStatusText) {
            const timeStr = new Date().toLocaleTimeString('bn-BD', { hour: '2-digit', minute: '2-digit' });
            draftStatusText.textContent = `খসড়া সংরক্ষিত (${timeStr})`;
          }
        } catch (e) {}
      }, 1000);
    }

    function checkDraftRestore() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) return;
        const draft = JSON.parse(saved);
        if (draft && draft.content && draft.content.trim() !== '<p><br></p>') {
          const diffMinutes = Math.round((Date.now() - draft.timestamp) / 60000);
          if (confirm(`আপনার একটি পূর্ববর্তী অসম্পূর্ণ খসড়া পাওয়া গেছে (${toBn(diffMinutes)} মিনিট আগের)। আপনি কি তা পুনরুদ্ধার করতে চান?`)) {
            if (titleInput && draft.title) titleInput.value = draft.title;
            if (tagsInput && draft.tags) tagsInput.value = draft.tags;
            quill.root.innerHTML = draft.content;
            updateWritingStats();
          }
        }
      } catch (e) {}
    }

    quill.on('text-change', () => {
      updateWritingStats();
      autoSaveDraft();
    });

    if (titleInput) titleInput.addEventListener('input', autoSaveDraft);
    if (tagsInput) tagsInput.addEventListener('input', autoSaveDraft);

    if (form) {
      form.addEventListener('submit', (e) => {
        const text = quill.getText().trim();
        const html = quill.root.innerHTML;
        if (!text || text.length === 0) {
          alert('অনুগ্রহ করে মূল সাহিত্য বা লেখার বিষয়বস্তু লিখুন।');
          e.preventDefault();
          return false;
        }
        contentInput.value = html;
        localStorage.removeItem(STORAGE_KEY);
      });
    }

    updateWritingStats();
    checkDraftRestore();
  })();
</script>

<%- include('partials/author_layout_end') %>
