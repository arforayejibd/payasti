<%- include('partials/author_layout_start', { 
  pageTitle: 'আমার সাহিত্যকর্ম ও লেখাসমূহ', 
  pageBreadcrumb: 'সকল লেখা', 
  activeMenu: 'my_posts', 
  user: user, 
  seo: seo,
  topbarButton: { text: '+ নতুন লেখা লিখুন', url: '/author/new-post' }
}) %>

<!-- Status Filter Tabs Card -->
<div class="admin-card" style="margin-bottom: 20px;">
  <div class="admin-card-body" style="padding: 12px 18px;">
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      <a href="/author/my-posts?status=all" class="admin-tab-link <%= statusFilter === 'all' ? 'active' : '' %>" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 600; <%= statusFilter === 'all' ? 'background: #075603; color: #ffffff;' : 'background: #f1f5f9; color: #475569;' %>">
        <span>সব লেখা</span>
        <span style="font-size: 12px; background: rgba(0,0,0,0.12); padding: 1px 6px; border-radius: 10px;"><%= toBengaliNumber(counts.all) %></span>
      </a>
      <a href="/author/my-posts?status=publish" class="admin-tab-link <%= statusFilter === 'publish' ? 'active' : '' %>" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 600; <%= statusFilter === 'publish' ? 'background: #075603; color: #ffffff;' : 'background: #f1f5f9; color: #475569;' %>">
        <span>প্রকাশিত</span>
        <span style="font-size: 12px; background: rgba(0,0,0,0.12); padding: 1px 6px; border-radius: 10px;"><%= toBengaliNumber(counts.publish) %></span>
      </a>
      <a href="/author/my-posts?status=pending" class="admin-tab-link <%= statusFilter === 'pending' ? 'active' : '' %>" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 600; <%= statusFilter === 'pending' ? 'background: #075603; color: #ffffff;' : 'background: #f1f5f9; color: #475569;' %>">
        <span>পেন্ডিং রিভিউ</span>
        <span style="font-size: 12px; background: rgba(0,0,0,0.12); padding: 1px 6px; border-radius: 10px;"><%= toBengaliNumber(counts.pending) %></span>
      </a>
      <a href="/author/my-posts?status=draft" class="admin-tab-link <%= statusFilter === 'draft' ? 'active' : '' %>" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 600; <%= statusFilter === 'draft' ? 'background: #075603; color: #ffffff;' : 'background: #f1f5f9; color: #475569;' %>">
        <span>খসড়া</span>
        <span style="font-size: 12px; background: rgba(0,0,0,0.12); padding: 1px 6px; border-radius: 10px;"><%= toBengaliNumber(counts.draft) %></span>
      </a>
    </div>
  </div>
</div>

<!-- Posts Table Card -->
<div class="admin-card">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-primary);">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
      </svg>
      <span>লেখার তালিকা</span>
      <span class="admin-card-badge">
        <%= statusFilter === 'publish' ? 'প্রকাশিত' : (statusFilter === 'pending' ? 'পেন্ডিং' : (statusFilter === 'draft' ? 'খসড়া' : 'সর্বমোট')) %> 
        <%= toBengaliNumber(posts ? posts.length : 0) %> টি
      </span>
    </div>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width: 50px;">ছবি</th>
          <th>শিরোনাম ও সারসংক্ষেপ</th>
          <th>বিভাগ</th>
          <th>পাঠসংখ্যা</th>
          <th>স্ট্যাটাস</th>
          <th>তারিখ</th>
          <th style="text-align: right; min-width: 100px;">অ্যাকশন</th>
        </tr>
      </thead>
      <tbody>
        <% if (posts && posts.length > 0) { %>
          <% posts.forEach(p => { %>
            <tr>
              <td>
                <% if (p.featured_image) { %>
                  <img src="<%= p.featured_image %>" alt="" style="width: 44px; height: 44px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;">
                <% } else { %>
                  <div style="width: 44px; height: 44px; border-radius: 8px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 18px;">
                    📝
                  </div>
                <% } %>
              </td>
              <td>
                <div class="post-title-cell" style="font-weight: 600; font-size: 16px; color: #0f172a;">
                  <%= p.title %>
                </div>
                <% if (p.excerpt) { %>
                  <div style="font-size: 13px; color: #64748b; margin-top: 4px; max-width: 380px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= p.excerpt %>
                  </div>
                <% } %>
              </td>
              <td>
                <span class="admin-badge admin-badge-category" style="font-size: 13px;">
                  <%= p.category_name || 'অন্য সাহিত্য' %>
                </span>
              </td>
              <td>
                <div style="display: flex; align-items: center; gap: 4px; font-size: 14px; font-weight: 600; color: #075603;">
                  <span>👁️</span>
                  <span><%= toBengaliNumber(p.views || 0) %> বার</span>
                </div>
              </td>
              <td>
                <% if (p.status === 'publish') { %>
                  <span class="admin-badge admin-badge-published">প্রকাশিত</span>
                <% } else if (p.status === 'pending') { %>
                  <span class="admin-badge admin-badge-pending">পেন্ডিং রিভিউ</span>
                <% } else { %>
                  <span class="admin-badge admin-badge-draft">খসড়া</span>
                <% } %>
              </td>
              <td>
                <span style="font-size: 13px; color: #64748b;">
                  <%= formatBengaliDate(p.published_at || p.created_at) %>
                </span>
              </td>
              <td style="text-align: right;">
                <% if (p.status === 'publish') { %>
                  <a href="/post/<%= encodeURIComponent(p.slug) %>" target="_blank" class="btn-table-action btn-view-post" style="text-decoration: none; padding: 4px 10px; font-size: 13px;">
                    পড়ুন &raquo;
                  </a>
                <% } else { %>
                  <span style="font-size: 13px; color: #94a3b8;">অপেক্ষমাণ</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7">
              <div class="admin-empty-state" style="padding: 40px 10px;">
                <div class="empty-icon">📑</div>
                <div class="empty-title">কোনো লেখা পাওয়া যায়নি</div>
                <div class="empty-desc" style="margin-bottom: 14px;">আপনি নতুন কোনো লেখা জমা দেননি বা এই ফিল্টারে কোনো লেখা নেই।</div>
                <a href="/author/new-post" class="btn-new-action">+ নতুন লেখা লিখুন</a>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/author_layout_end') %>
