<%- include('partials/author_layout_start', { 
  pageTitle: 'আমার সাহিত্যকর্ম ও লেখাসমূহ', 
  pageBreadcrumb: 'সকল লেখা', 
  activeMenu: 'my_posts', 
  user: user, 
  seo: seo
}) %>

<!-- Status Filter Tabs Card -->
<div class="admin-card" style="margin-bottom: 24px;">
  <div class="admin-card-body" style="padding: 14px 20px;">
    <div class="admin-tabs-container">
      <a href="/author/my-posts?status=all" class="admin-tab-link <%= statusFilter === 'all' ? 'active' : '' %>">
        <span>সব লেখা</span>
        <span class="admin-tab-count"><%= toBengaliNumber(counts.all) %></span>
      </a>
      <a href="/author/my-posts?status=publish" class="admin-tab-link <%= statusFilter === 'publish' ? 'active' : '' %>">
        <span>প্রকাশিত</span>
        <span class="admin-tab-count"><%= toBengaliNumber(counts.publish) %></span>
      </a>
      <a href="/author/my-posts?status=pending" class="admin-tab-link <%= statusFilter === 'pending' ? 'active' : '' %>">
        <span>পেন্ডিং রিভিউ</span>
        <span class="admin-tab-count"><%= toBengaliNumber(counts.pending) %></span>
      </a>
      <a href="/author/my-posts?status=draft" class="admin-tab-link <%= statusFilter === 'draft' ? 'active' : '' %>">
        <span>খসড়া</span>
        <span class="admin-tab-count"><%= toBengaliNumber(counts.draft) %></span>
      </a>
    </div>
  </div>
</div>

<!-- Posts Table Card -->
<div class="admin-card">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-primary);">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
      </svg>
      <span>লেখার তালিকা</span>
      <span class="admin-card-badge">
        <%= statusFilter === 'publish' ? 'প্রকাশিত' : (statusFilter === 'pending' ? 'পেন্ডিং' : (statusFilter === 'draft' ? 'খসড়া' : 'সর্বমোট')) %> 
        <%= toBengaliNumber(posts ? posts.length : 0) %> টি
      </span>
    </div>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width: 70px;">ছবি</th>
          <th>শিরোনাম ও সারসংক্ষেপ</th>
          <th>বিভাগ</th>
          <th>পাঠসংখ্যা</th>
          <th>স্ট্যাটাস</th>
          <th>তারিখ</th>
          <th style="text-align: right; min-width: 120px;">অ্যাকশন</th>
        </tr>
      </thead>
      <tbody>
        <% if (posts && posts.length > 0) { %>
          <% posts.forEach(p => { %>
            <tr>
              <td>
                <% if (p.featured_image) { %>
                  <img src="<%= p.featured_image %>" alt="" class="table-featured-thumb">
                <% } else { %>
                  <div class="table-thumb-placeholder">
                    📝
                  </div>
                <% } %>
              </td>
              <td>
                <div class="post-title-cell">
                  <% if (p.status === 'publish') { %>
                    <a href="/post/<%= encodeURIComponent(p.slug) %>" target="_blank">
                      <%= p.title %>
                    </a>
                  <% } else { %>
                    <span class="post-title-text"><%= p.title %></span>
                  <% } %>
                </div>
                <% if (p.excerpt) { %>
                  <div class="post-excerpt-cell">
                    <%= p.excerpt %>
                  </div>
                <% } %>
              </td>
              <td>
                <span class="admin-badge admin-badge-category">
                  <%= p.category_name || 'অন্য সাহিত্য' %>
                </span>
              </td>
              <td>
                <div class="post-views-cell">
                  <span>👁️</span>
                  <span><%= toBengaliNumber(p.views || 0) %></span>
                </div>
              </td>
              <td>
                <% if (p.status === 'publish') { %>
                  <span class="admin-badge admin-badge-published">✓ প্রকাশিত</span>
                <% } else if (p.status === 'pending') { %>
                  <span class="admin-badge admin-badge-pending">⏳ পেন্ডিং রিভিউ</span>
                <% } else { %>
                  <span class="admin-badge admin-badge-draft">📝 খসড়া</span>
                <% } %>
              </td>
              <td>
                <span class="post-date-cell">
                  <%= formatBengaliDate(p.published_at || p.created_at) %>
                </span>
              </td>
              <td style="text-align: right;">
                <% if (p.status === 'publish') { %>
                  <a href="/post/<%= encodeURIComponent(p.slug) %>" target="_blank" class="btn-table-action btn-view-post">
                    পড়ুন &raquo;
                  </a>
                <% } else { %>
                  <span class="post-status-waiting">অপেক্ষমাণ</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7">
              <div class="admin-empty-state" style="padding: 50px 20px;">
                <div class="empty-icon">📑</div>
                <div class="empty-title">কোনো লেখা পাওয়া যায়নি</div>
                <div class="empty-desc" style="margin-bottom: 20px;">আপনি নতুন কোনো লেখা জমা দেননি বা এই ফিল্টারে কোনো লেখা নেই।</div>
                <a href="/author/new-post" class="btn-new-action">+ নতুন লেখা লিখুন</a>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/author_layout_end') %>
