<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof seo !== 'undefined' && seo.title ? seo.title : 'পয়স্তি লেখক প্যানেল' %></title>
  
  <link rel="icon" href="/images/favicon-32x32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <meta name="theme-color" content="#0d1512">
  <meta name="robots" content="noindex, nofollow">

  <!-- Performance Resource Hints & Font Preload -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="/fonts/8029Payasti_uni.woff2" as="font" type="font/woff2" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Dedicated Admin & Dashboard Stylesheet -->
  <link rel="stylesheet" href="/css/admin.css?v=6.6">
  <link rel="stylesheet" href="/css/dashboard.css?v=6.7">

  <!-- Immediate Global Site Theme Engine (Synced with main site) -->
  <script>
    function applyThemeToDOM(theme) {
      document.documentElement.classList.remove('theme-sepia', 'theme-dark');
      if (document.body) {
        document.body.classList.remove('theme-sepia', 'theme-dark');
      }
      if (theme === 'sepia') {
        document.documentElement.classList.add('theme-sepia');
        if (document.body) document.body.classList.add('theme-sepia');
      } else if (theme === 'dark') {
        document.documentElement.classList.add('theme-dark');
        if (document.body) document.body.classList.add('theme-dark');
      }

      var def = document.querySelector('.theme-icon-default');
      var sep = document.querySelector('.theme-icon-sepia');
      var dar = document.querySelector('.theme-icon-dark');
      if (def) def.style.display = (theme === 'default') ? 'inline-flex' : 'none';
      if (sep) sep.style.display = (theme === 'sepia') ? 'inline-flex' : 'none';
      if (dar) dar.style.display = (theme === 'dark') ? 'inline-flex' : 'none';
    }

    (function() {
      try {
        var theme = localStorage.getItem('payasti_site_theme') || 'default';
        if (theme === 'sepia') {
          document.documentElement.classList.add('theme-sepia');
        } else if (theme === 'dark') {
          document.documentElement.classList.add('theme-dark');
        }
      } catch (e) {}
    })();

    function toggleSiteTheme() {
      var themes = ['default', 'sepia', 'dark'];
      var current = 'default';
      if (document.documentElement.classList.contains('theme-sepia')) current = 'sepia';
      else if (document.documentElement.classList.contains('theme-dark')) current = 'dark';

      var next = themes[(themes.indexOf(current) + 1) % themes.length];
      applyThemeToDOM(next);
      try { localStorage.setItem('payasti_site_theme', next); } catch (e) {}
    }

    document.addEventListener('DOMContentLoaded', function() {
      var theme = localStorage.getItem('payasti_site_theme') || 'default';
      applyThemeToDOM(theme);
    });
  </script>
</head>
<body class="admin-body">

<div class="admin-layout">
  <!-- Mobile Sidebar Overlay Backdrop -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- Dedicated Author Sidebar -->
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="admin-sidebar-header">
      <a href="/author/dashboard" class="admin-brand-link" title="পয়স্তি ম্যাগাজিন">
        <img src="/images/Payasti-logo.png" alt="পয়স্তি ম্যাগাজিন" class="admin-brand-logo">
      </a>
      <button type="button" class="admin-sidebar-close" id="adminSidebarClose" aria-label="সাইডবার বন্ধ করুন" title="মেনু বন্ধ করুন">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- লেখক প্যানেল সাইডবার মেনু -->
    <ul class="admin-sidebar-nav">
      <!-- ১. ড্যাশবোর্ড -->
      <li class="admin-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'dashboard' ? 'active' : '' %>">
        <a href="/author/dashboard">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>ড্যাশবোর্ড</span>
          </div>
        </a>
      </li>

      <!-- ২. পোস্টসমূহ (সাবমেনু: সকল লেখা, নতুন লেখা, পেন্ডিং, প্রকাশিত) -->
      <% 
        const isPostGroup = typeof activeMenu !== 'undefined' && (activeMenu === 'my_posts' || activeMenu === 'new_post');
      %>
      <li class="admin-nav-item has-submenu <%= isPostGroup ? 'open' : '' %>">
        <a href="javascript:void(0)" class="menu-toggle" role="button" aria-expanded="<%= isPostGroup ? 'true' : 'false' %>">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>সাহিত্যকর্ম ও পোস্ট</span>
          </div>
          <svg class="submenu-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <ul class="admin-submenu">
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'my_posts' && (typeof statusFilter === 'undefined' || statusFilter === 'all') ? 'active' : '' %>">
            <a href="/author/my-posts">সকল লেখা</a>
          </li>
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'new_post' ? 'active' : '' %>">
            <a href="/author/new-post">নতুন লেখা লিখুন</a>
          </li>
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'my_posts' && typeof statusFilter !== 'undefined' && statusFilter === 'pending' ? 'active' : '' %>">
            <a href="/author/my-posts?status=pending">পেন্ডিং রিভিউ</a>
          </li>
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'my_posts' && typeof statusFilter !== 'undefined' && statusFilter === 'publish' ? 'active' : '' %>">
            <a href="/author/my-posts?status=publish">প্রকাশিত সাহিত্য</a>
          </li>
        </ul>
      </li>

      <!-- ৩. এডমিন শর্টকাট (যদি এডমিন বা এডিটর হন) -->
      <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'editor')) { %>
        <li class="admin-nav-section-title" style="margin-top: 14px;">মডারেশন অ্যাক্সেস</li>
        <li class="admin-nav-item">
          <a href="/admin">
            <div class="admin-nav-left">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>এডমিন প্যানেল</span>
            </div>
            <span style="font-size: 15px;">&rarr;</span>
          </a>
        </li>
      <% } %>
    </ul>
  </aside>

  <!-- Main Wrapper -->
  <div class="admin-main-wrapper">
    <!-- Topbar -->
    <header class="admin-topbar">
      <div class="admin-topbar-left">
        <button class="admin-mobile-toggle" id="adminSidebarToggle" aria-label="মেনু খুলুন">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div class="admin-page-title-group">
          <div class="admin-breadcrumbs">
            <a href="/author/dashboard">পয়স্তি লেখক</a>
            <span>/</span>
            <span><%= typeof pageBreadcrumb !== 'undefined' ? pageBreadcrumb : 'ড্যাশবোর্ড' %></span>
          </div>
          <h1 class="admin-page-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'লেখক প্যানেল' %></h1>
        </div>
      </div>

      <div class="admin-topbar-actions">
        <!-- Theme Switcher Button -->
        <button type="button" class="btn-theme-toggle" onclick="toggleSiteTheme()" title="থিম পরিবর্তন করুন (লাইট / সেপিয়া / ডার্ক)" aria-label="থিম পরিবর্তন">
          <!-- Light Mode Icon (Sun) -->
          <svg class="theme-icon theme-icon-default" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <!-- Sepia Mode Icon (Book/Coffee) -->
          <svg class="theme-icon theme-icon-sepia" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <!-- Dark Mode Icon (Moon) -->
          <svg class="theme-icon theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <!-- Globe Icon for View Website -->
        <a href="/" target="_blank" class="btn-topbar-icon btn-topbar-globe" title="মূল ওয়েবসাইট দেখুন" aria-label="মূল ওয়েবসাইট দেখুন">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </a>

        <!-- User Profile Pill (Avatar & Name) -->
        <a href="/author/profile" class="topbar-user-profile" title="প্রোফাইল সম্পাদন">
          <% if (typeof user !== 'undefined' && user && user.avatar) { %>
            <img src="<%= user.avatar %>" alt="<%= user.display_name %>" class="topbar-avatar-img">
          <% } else { %>
            <div class="topbar-avatar-circle">
              <%= typeof user !== 'undefined' && user && user.display_name ? user.display_name.charAt(0) : 'প' %>
            </div>
          <% } %>
          <span class="topbar-user-name"><%= typeof user !== 'undefined' && user && user.display_name ? user.display_name : 'লেখক' %></span>
        </a>

        <!-- Logout Action Button -->
        <a href="/logout" class="btn-topbar-icon btn-topbar-logout" title="লগআউট করুন" aria-label="লগআউট">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
      </div>
    </header>

    <!-- Page Content Container -->
    <main class="admin-content">
