<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof seo !== 'undefined' && seo.title ? seo.title : 'পয়স্তি লেখক প্যানেল' %></title>
  
  <link rel="icon" href="/images/favicon-32x32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <meta name="theme-color" content="#0d1512">
  <meta name="robots" content="noindex, nofollow">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Dedicated Admin & Dashboard Stylesheet -->
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="admin-body">

<div class="admin-layout">
  <!-- Mobile Sidebar Overlay Backdrop -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- Dedicated Author Sidebar -->
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="admin-sidebar-header">
      <a href="/author/dashboard" class="admin-brand-link">
        <img src="/images/Payasti-logo.png" alt="পয়স্তি" class="admin-brand-logo">
        <div class="admin-brand-info">
          <span class="admin-brand-name">পয়স্তি ম্যাগাজিন</span>
          <span class="admin-brand-badge" style="background: rgba(6, 130, 0, 0.2); color: #86efac; border-color: rgba(134, 239, 172, 0.3);">লেখক প্যানেল</span>
        </div>
      </a>
    </div>

    <!-- লেখক প্যানেল সাইডবার মেনু -->
    <ul class="admin-sidebar-nav">
      <!-- ১. ড্যাশবোর্ড -->
      <li class="admin-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'dashboard' ? 'active' : '' %>">
        <a href="/author/dashboard">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>ড্যাশবোর্ড</span>
          </div>
        </a>
      </li>

      <!-- ২. পোস্টসমূহ (সাবমেনু: সকল লেখা, নতুন লেখা, পেন্ডিং, প্রকাশিত) -->
      <% 
        const isPostGroup = typeof activeMenu !== 'undefined' && (activeMenu === 'my_posts' || activeMenu === 'new_post');
      %>
      <li class="admin-nav-item has-submenu <%= isPostGroup ? 'open' : '' %>">
        <a href="/author/my-posts" class="menu-toggle">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>সাহিত্যকর্ম ও পোস্ট</span>
          </div>
          <svg class="submenu-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <ul class="admin-submenu">
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'my_posts' && (typeof statusFilter === 'undefined' || statusFilter === 'all') ? 'active' : '' %>">
            <a href="/author/my-posts">সকল লেখা</a>
          </li>
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'new_post' ? 'active' : '' %>">
            <a href="/author/new-post">নতুন লেখা লিখুন</a>
          </li>
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'my_posts' && typeof statusFilter !== 'undefined' && statusFilter === 'pending' ? 'active' : '' %>">
            <a href="/author/my-posts?status=pending">পেন্ডিং রিভিউ</a>
          </li>
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'my_posts' && typeof statusFilter !== 'undefined' && statusFilter === 'publish' ? 'active' : '' %>">
            <a href="/author/my-posts?status=publish">প্রকাশিত সাহিত্য</a>
          </li>
        </ul>
      </li>

      <!-- ৩. প্রোফাইল -->
      <li class="admin-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'profile' ? 'active' : '' %>">
        <a href="/author/profile">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span>প্রোফাইল সম্পাদন</span>
          </div>
        </a>
      </li>

      <!-- ৪. বানান সহায়িকা -->
      <li class="admin-nav-item">
        <a href="/spelling-rules" target="_blank">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
            <span>বানান সহায়িকা</span>
          </div>
          <span style="font-size: 15px; opacity: 0.6;">&nearr;</span>
        </a>
      </li>

      <!-- ৫. এডমিন শর্টকাট (যদি এডমিন বা এডিটর হন) -->
      <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'editor')) { %>
        <li class="admin-nav-section-title" style="margin-top: 14px;">মডারেশন অ্যাক্সেস</li>
        <li class="admin-nav-item">
          <a href="/admin" style="background: rgba(7, 86, 3, 0.35); border: 1px solid rgba(134, 239, 172, 0.2);">
            <div class="admin-nav-left">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span style="font-weight: 700; color: #86efac;">এডমিন প্যানেল</span>
            </div>
            <span style="font-size: 15px; color: #86efac;">&rarr;</span>
          </a>
        </li>
      <% } %>

      <li class="admin-nav-section-title" style="margin-top: 14px;">সাইট অ্যাকশন</li>

      <li class="admin-nav-item">
        <a href="/" target="_blank" rel="noopener">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>ওয়েবসাইট দেখুন</span>
          </div>
          <span style="font-size: 15px; opacity: 0.6;">&nearr;</span>
        </a>
      </li>
    </ul>

    <!-- Author User Info & Logout -->
    <div class="admin-sidebar-footer">
      <div class="admin-user-pill">
        <div class="admin-user-left">
          <% if (typeof user !== 'undefined' && user && user.avatar) { %>
            <img src="<%= user.avatar %>" alt="<%= user.display_name %>" class="admin-avatar">
          <% } else { %>
            <div class="admin-avatar">
              <%= typeof user !== 'undefined' && user && user.display_name ? user.display_name.charAt(0) : 'প' %>
            </div>
          <% } %>
          <div class="admin-user-meta">
            <span class="admin-user-name"><%= typeof user !== 'undefined' && user && user.display_name ? user.display_name : 'সম্মানিত লেখক' %></span>
            <span class="admin-user-role">
              <%= typeof user !== 'undefined' && user && user.role === 'admin' ? '🛡️ এডমিন' : (user && user.role === 'editor' ? '✍️ সম্পাদক' : '🖋️ সম্মানিত লেখক') %>
            </span>
          </div>
        </div>
        <a href="/logout" class="admin-logout-link" title="লগআউট করুন">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
      </div>
    </div>
  </aside>

  <!-- Main Wrapper -->
  <div class="admin-main-wrapper">
    <!-- Topbar -->
    <header class="admin-topbar">
      <div class="admin-topbar-left">
        <button class="admin-mobile-toggle" id="adminSidebarToggle" aria-label="মেনু খুলুন">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div class="admin-page-title-group">
          <div class="admin-breadcrumbs">
            <a href="/author/dashboard">পয়স্তি লেখক</a>
            <span>/</span>
            <span><%= typeof pageBreadcrumb !== 'undefined' ? pageBreadcrumb : 'ড্যাশবোর্ড' %></span>
          </div>
          <h1 class="admin-page-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'লেখক প্যানেল' %></h1>
        </div>
      </div>

      <div class="admin-topbar-actions">
        <a href="/" target="_blank" class="btn-view-site" title="মূল ওয়েবসাইট দেখুন">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>ওয়েবসাইট দেখুন</span>
        </a>

        <% if (typeof topbarButton !== 'undefined' && topbarButton) { %>
          <a href="<%= topbarButton.url %>" class="btn-new-action">
            <%= topbarButton.text %>
          </a>
        <% } else { %>
          <a href="/author/new-post" class="btn-new-action">
            + নতুন লেখা লিখুন
          </a>
        <% } %>
      </div>
    </header>

    <!-- Page Content Container -->
    <main class="admin-content">
