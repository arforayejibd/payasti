<%- include('partials/author_layout_start', { 
  pageTitle: 'প্রোফাইল সম্পাদন', 
  pageBreadcrumb: 'প্রোফাইল', 
  activeMenu: 'profile', 
  user: user, 
  seo: seo
}) %>

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background: #fef2f2; border: 1.5px solid #fecaca; color: #b91c1c; padding: 14px 20px; border-radius: 8px; margin-bottom: 20px; font-size: 15px; font-weight: 500;">
    ⚠️ <%= error %>
  </div>
<% } %>

<% if (typeof success !== 'undefined' && success) { %>
  <div style="background: #f0fdf4; border: 1.5px solid #bbf7d0; color: #15803d; padding: 14px 20px; border-radius: 8px; margin-bottom: 20px; font-size: 15px; font-weight: 500;">
    ✅ <%= success %>
  </div>
<% } %>

<!-- Profile Edit Card Matching Admin Panel -->
<div class="admin-card">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--admin-primary);">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span>আপনার ব্যক্তিগত তথ্য ও লেখক পরিচিতি</span>
    </div>
  </div>

  <div class="admin-card-body">
    <form action="/author/profile" method="POST" enctype="multipart/form-data">
      
      <!-- Avatar Dropzone Area -->
      <div class="admin-form-group">
        <label class="admin-form-label">প্রোফাইল ছবি (Avatar)</label>
        <div class="payasti-image-dropzone" data-name="avatar" data-initial-url="<%= user.avatar || '' %>" data-prompt="অবতার ছবি ড্র্যাগ করে ছাড়ুন অথবা ক্লিক করুন" data-hint="ক্লিক করে মিডিয়া লাইব্রেরি থেকে ছবি বাছুন"></div>
      </div>

      <!-- Basic Info Inputs Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 20px;">
        <div class="admin-form-group">
          <label class="admin-form-label">পূর্ণ নাম *</label>
          <input type="text" name="display_name" class="admin-form-input" value="<%= user.display_name %>" required>
        </div>

        <div class="admin-form-group">
          <label class="admin-form-label">ইমেইল ঠিকানা *</label>
          <input type="email" name="email" class="admin-form-input" value="<%= user.email %>" required>
        </div>
      </div>

      <!-- Bio / Literary Intro -->
      <div class="admin-form-group">
        <label class="admin-form-label">আপনার সংক্ষিপ্ত সাহিত্য পরিচিতি / বায়ো</label>
        <textarea name="bio" class="admin-form-textarea" rows="4" placeholder="আপনার সাহিত্য জীবনের সংক্ষিপ্ত পরিচিতি, পছন্দের বিষয় বা প্রকাশনা সম্পর্কে লিখুন..."><%= user.bio %></textarea>
      </div>

      <!-- Password -->
      <div class="admin-form-group">
        <label class="admin-form-label">নতুন পাসওয়ার্ড <span style="font-weight: 400; color: var(--admin-text-sub);">(পরিবর্তন না করতে চাইলে খালি রাখুন)</span></label>
        <input type="password" name="password" class="admin-form-input" placeholder="নতুন পাসওয়ার্ড দিন">
      </div>

      <!-- Submit Action -->
      <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 20px; border-top: 1px solid var(--admin-border); margin-top: 10px;">
        <a href="/author/dashboard" class="btn-view-site">ড্যাশবোর্ডে ফিরে যান</a>
        <button type="submit" class="btn-new-action" style="padding: 10px 24px; font-size: 16px;">
          তথ্য সংরক্ষণ করুন
        </button>
      </div>

    </form>
  </div>
</div>

<%- include('partials/author_layout_end') %>
