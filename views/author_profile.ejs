<%- include('partials/header') %>

<main class="container">
  <!-- Author Header -->
  <div class="authors-hero-box" style="display: flex; gap: 24px; align-items: center;">
    <div style="width: 90px; height: 90px; border-radius: 50%; overflow: hidden; flex-shrink: 0; background: #e2e8f0; border: 3px solid var(--primary);">
      <% if (author.avatar) { %>
        <img src="<%= author.avatar %>" alt="<%= author.display_name %>" style="width: 100%; height: 100%; object-fit: cover;">
      <% } else { %>
        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 36px; font-weight: 700; color: #64748b;">
          <%= author.display_name ? author.display_name.charAt(0) : 'প' %>
        </div>
      <% } %>
    </div>
    <div>
      <h1 class="authors-hero-title" style="margin-bottom: 6px;"><%= author.display_name %></h1>
      <p style="font-size: 14px; color: #555; line-height: 1.6;">
        <%= author.bio || 'পয়স্তি সাহিত্য ম্যাগাজিনের নিয়মিত লেখক ও সাহিত্য সাধক।' %>
      </p>
      <div style="margin-top: 8px; font-size: 13px; color: var(--primary); font-weight: 600;">
        মোট প্রকাশিত সাহিত্য: <%= toBengaliNumber(pagination.totalItems) %> টি
      </div>
    </div>
  </div>

  <!-- Author Writings Grid -->
  <div class="section-heading-wrap">
    <h2 class="section-title"><%= author.display_name %> এর রচনাসমগ্র</h2>
  </div>

  <div class="posts-grid">
    <% if (posts && posts.length) { %>
      <% posts.forEach(post => { %>
        <article class="post-card">
          <div class="author-info-wrap" style="margin-bottom: 10px;">
            <a href="/post/<%= encodeURIComponent(post.slug) %>" class="post-title-link" title="<%= post.title %>" style="font-size: 16px;">
              <%= post.title %>
            </a>
          </div>
          <div class="post-excerpt">
            <%= post.excerpt %>
          </div>
          <div class="post-card-meta-footer">
            <a href="/category/<%= encodeURIComponent(post.category_slug || '') %>" class="post-category-badge">
              <%= post.category_name || 'সাহিত্য' %>
            </a>
            <time class="post-date">
              <%= formatBengaliDate(post.published_at || post.created_at) %>
            </time>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <p style="grid-column: 1 / -1; text-align: center; color: #888; padding: 40px 0;">কোনো প্রকাশিত লেখা নেই।</p>
    <% } %>
  </div>

  <!-- Pagination -->
  <%- include('partials/pagination', { pagination: pagination }) %>
</main>

<%- include('partials/footer') %>
