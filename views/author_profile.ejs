<%- include('partials/header') %>

<main class="page-main-content">
  <div class="site-container" style="padding-top: 30px; padding-bottom: 60px;">
    <!-- Author Header -->
    <div class="authors-hero-box" style="display: flex; gap: 24px; align-items: center; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 28px; box-shadow: 0 4px 16px rgba(0,0,0,0.03); margin-bottom: 36px;">
      <div style="width: 90px; height: 90px; border-radius: 50%; overflow: hidden; flex-shrink: 0; background: var(--bg-secondary); border: 3px solid var(--accent-primary);">
        <% if (author.avatar) { %>
          <img src="<%= author.avatar %>" alt="<%= author.display_name %>" style="width: 100%; height: 100%; object-fit: cover;">
        <% } else { %>
          <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 36px; font-weight: 700; color: var(--text-muted);">
            <%= author.display_name ? author.display_name.charAt(0) : 'প' %>
          </div>
        <% } %>
      </div>
      <div>
        <h1 class="authors-hero-title" style="margin: 0 0 8px 0; font-size: 26px; font-weight: 700; color: var(--text-primary);"><%= author.display_name %></h1>
        <p style="font-size: 15px; color: var(--text-secondary); line-height: 1.7; margin: 0;">
          <%= author.bio || 'পয়স্তি সাহিত্য ম্যাগাজিনের নিয়মিত লেখক ও সাহিত্য সাধক।' %>
        </p>
        <div style="margin-top: 10px; font-size: 14px; color: var(--accent-primary); font-weight: 600;">
          মোট প্রকাশিত সাহিত্য: <%= toBengaliNumber(pagination.totalItems) %> টি
        </div>
      </div>
    </div>

    <!-- Author Writings Grid -->
    <div class="section-heading-bar" style="margin-bottom: 24px;">
      <h2 class="section-title" style="margin: 0; font-size: 22px; color: var(--text-primary);"><%= author.display_name %> এর রচনাসমগ্র</h2>
    </div>

    <div class="posts-grid-4">
      <% if (posts && posts.length) { %>
        <% posts.forEach(post => { %>
          <%- include('partials/post_card', { post: post, styleVariant: 'featured' }) %>
        <% }) %>
      <% } else { %>
        <p style="grid-column: 1 / -1; text-align: center; color: var(--text-muted); padding: 40px 0;">কোনো প্রকাশিত লেখা নেই।</p>
      <% } %>
    </div>

    <!-- Pagination -->
    <% if (pagination && pagination.totalPages > 1) { %>
      <div style="margin-top: 40px;">
        <%- include('partials/pagination', { pagination: pagination }) %>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
