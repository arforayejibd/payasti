<%- include('partials/admin_layout_start', { 
  pageTitle: 'লেখক তথ্য সম্পাদনা', 
  pageBreadcrumb: 'লেখক এডিট',
  topbarButton: { text: '&larr; সকল লেখকে ফিরে যান', url: '/admin/users' }
}) %>

<div class="admin-card" style="max-width: 760px; margin: 0 auto;">
  <div class="admin-card-header">
    <div class="admin-card-title">
      <span>সম্পাদনা: <%= targetUser.display_name %> (@<%= targetUser.username %>)</span>
    </div>
    <div>
      <% if (targetUser.role === 'admin') { %>
        <span class="status-badge" style="background: #fef2f2; color: #dc2626;">এডমিন</span>
      <% } else if (targetUser.role === 'editor') { %>
        <span class="status-badge" style="background: #eff6ff; color: #2563eb;">সম্পাদক</span>
      <% } else { %>
        <span class="status-badge" style="background: #f0fdf4; color: #16a34a;">লেখক</span>
      <% } %>
    </div>
  </div>

  <div class="admin-card-body">
    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/users/<%= targetUser.id %>/edit" method="POST" enctype="multipart/form-data">
      <div class="admin-form-grid">
        <!-- Display Name -->
        <div class="admin-form-group">
          <label class="admin-form-label">পূর্ণ নাম *</label>
          <input type="text" name="display_name" value="<%= targetUser.display_name %>" class="admin-form-input" required>
        </div>

        <!-- Username (Readonly) -->
        <div class="admin-form-group">
          <label class="admin-form-label">ইউজারনেম (অপরিবর্তনীয়)</label>
          <input type="text" value="<%= targetUser.username %>" class="admin-form-input" disabled style="background: #f1f5f9; color: #64748b; cursor: not-allowed;">
        </div>
      </div>

      <div class="admin-form-grid">
        <!-- Email -->
        <div class="admin-form-group">
          <label class="admin-form-label">ইমেইল ঠিকানা *</label>
          <input type="email" name="email" value="<%= targetUser.email %>" class="admin-form-input" required>
        </div>

        <!-- Role -->
        <div class="admin-form-group">
          <label class="admin-form-label">রোল / পদবী নির্ধারণ *</label>
          <select name="role" class="admin-form-select" required>
            <option value="author" <%= targetUser.role === 'author' ? 'selected' : '' %>>সম্মানিত লেখক (Author)</option>
            <option value="editor" <%= targetUser.role === 'editor' ? 'selected' : '' %>>সহযোগী সম্পাদক (Editor)</option>
            <option value="admin" <%= targetUser.role === 'admin' ? 'selected' : '' %>>প্রধান এডমিন (Administrator)</option>
          </select>
        </div>
      </div>

      <!-- Password Reset -->
      <div class="admin-form-group">
        <label class="admin-form-label">নতুন পাসওয়ার্ড (পরিবর্তন না করতে চাইলে খালি রাখুন)</label>
        <input type="password" name="new_password" class="admin-form-input" placeholder="নতুন পাসওয়ার্ড দিন (ঐচ্ছিক)">
      </div>

      <!-- Avatar -->
      <div class="admin-form-group">
        <label class="admin-form-label">প্রোফাইল ছবি (Avatar)</label>
        <div class="payasti-image-dropzone" data-name="avatar" data-initial-url="<%= targetUser.avatar || '' %>" data-prompt="অবতার ছবি ড্র্যাগ করে ছাড়ুন" data-hint="ক্লিক করে মিডিয়া লাইব্রেরি থেকে ছবি বাছুন"></div>
      </div>

      <!-- Bio -->
      <div class="admin-form-group">
        <label class="admin-form-label">সংক্ষিপ্ত লেখক পরিচিতি / বায়ো</label>
        <textarea name="bio" class="admin-form-textarea" rows="4"><%= targetUser.bio %></textarea>
      </div>

      <!-- Actions -->
      <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 20px; border-top: 1px solid var(--admin-border);">
        <a href="/admin/users" class="btn-view-site" style="padding: 10px 20px; font-size: 16px;">বাতিল করুন</a>
        <button type="submit" class="btn-new-action" style="padding: 11px 30px; font-size: 17px;">
          তথ্য আপডেট করুন
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/admin_layout_end') %>
