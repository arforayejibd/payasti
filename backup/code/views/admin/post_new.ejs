<%- include('partials/admin_layout_start', { 
  pageTitle: 'নতুন পোস্ট তৈরি', 
  pageBreadcrumb: 'নতুন পোস্ট',
  activeMenu: 'new_post',
  topbarButton: { text: 'সকল পোস্টে ফিরে যান', url: '/admin/posts' }
}) %>

<!-- Official WordPress Gutenberg Core Styles -->
<link rel="stylesheet" href="/vendor/gutenberg/components.css">
<link rel="stylesheet" href="/vendor/gutenberg/block-editor.css">
<link rel="stylesheet" href="/vendor/gutenberg/core.css">
<link rel="stylesheet" href="/vendor/gutenberg/isolated-block-editor.css">
<link rel="stylesheet" href="/css/wp-gutenberg-editor.css?v=3.0">

<% if (typeof error !== 'undefined' && error) { %>
  <div style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 14px 18px; border-radius: 10px; margin-bottom: 24px; font-size: 16px;">
    ⚠️ <%= error %>
  </div>
<% } %>

<form id="postForm" action="/admin/posts/new" method="POST" enctype="multipart/form-data" class="wp-gutenberg-container">
  
  <!-- 1. Sticky WordPress Top Header Bar -->
  <div class="wp-editor-top-bar">
    <div class="wp-top-left">
      <div id="wpGutenbergToolsSlot">
        <!-- Gutenberg Inserter (+), Undo, Redo tools dock here -->
      </div>

      <!-- Quick Review Inserters Toolbar -->
      <div class="wp-review-quick-tools">
        <button type="button" class="wp-tool-btn" onclick="window.insertProsConsBlock();" title="সুবিধা ও অসুবিধা বক্স যোগ করুন">
          <span>⚖️ সুবিধা/অসুবিধা</span>
        </button>
        <button type="button" class="wp-tool-btn" onclick="window.insertProductCardBlock();" title="প্রোডাক্ট রিভিউ কার্ড যোগ করুন">
          <span>📦 প্রোডাক্ট বক্স</span>
        </button>
        <button type="button" class="wp-tool-btn" onclick="window.insertRatingBlock();" title="স্টার রেটিং স্কোর যোগ করুন">
          <span>⭐ রেটিং</span>
        </button>
        <button type="button" class="wp-tool-btn" onclick="window.insertComparisonTableBlock();" title="তুলনামূলক টেবিল যোগ করুন">
          <span>📊 টেবিল</span>
        </button>
      </div>
    </div>

    <div class="wp-top-right">
      <button type="button" class="wp-btn-secondary" onclick="document.getElementById('statusSelect').value='draft'; document.getElementById('postForm').submit();">
        ড্রাফট সংরক্ষণ
      </button>

      <button type="submit" class="wp-btn-publish" id="btnPublishPost">
        <span>পোস্ট প্রকাশ করুন</span>
      </button>
    </div>
  </div>

  <!-- 2. Main 2-Column Layout (Canvas + Sidebar) -->
  <div class="wp-editor-grid">
    
    <!-- Left Column: Document Canvas -->
    <div class="wp-canvas-card">
      <!-- Large WordPress Title -->
      <input 
        type="text" 
        name="title" 
        id="postTitleInput"
        class="wp-title-input" 
        required 
        placeholder="Add title" 
        autocomplete="off"
      >

      <!-- Live Permalink Preview -->
      <div class="wp-permalink-preview">
        <span>স্থায়ী লিংক (Permalink):</span>
        <span class="wp-permalink-url" id="wpPermalinkUrl">/post/post-title</span>
      </div>

      <!-- Gutenberg Writing Flow -->
      <div class="gutenberg-mount-container">
        <textarea name="content" id="postContentInput" style="display: none;"></textarea>
      </div>

      <!-- Realtime Word Count & Status Footer -->
      <div class="wp-editor-footer-status">
        <div class="wp-status-stats">
          <span class="wp-status-stat-item">📝 মোট শব্দ: <strong id="wpWordCount">০</strong></span>
          <span class="wp-status-stat-item">⏱️ পড়ার সময়: <strong id="wpReadingTime">১</strong> মিনিট</span>
        </div>
        <div>
          <span style="color: #059669; font-weight: 600;">⚡ WordPress Gutenberg Canvas</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Document Settings Sidebar -->
    <div class="wp-inspector-sidebar">
      
      <!-- Panel 1: স্ট্যাটাস ও দৃশ্যমানতা -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>স্ট্যাটাস ও দৃশ্যমানতা</span>
        </div>
        <div class="wp-inspector-body">
          <div class="wp-form-group">
            <label class="wp-label">প্রকাশনা স্ট্যাটাস</label>
            <select name="status" id="statusSelect" class="wp-select">
              <option value="publish" selected>সরাসরি প্রকাশিত (Publish)</option>
              <option value="draft">ড্রাফট (Draft)</option>
              <option value="pending">রিভিউ পেন্ডিং (Pending)</option>
            </select>
          </div>

          <!-- Rating Enable / Disable Option -->
          <div class="wp-form-group">
            <label class="wp-checkbox-label" style="margin-bottom: 6px;">
              <input type="checkbox" name="enable_rating" id="enableRatingCheckbox" value="1" onchange="document.getElementById('ratingScoreFieldWrap').style.display = this.checked ? 'block' : 'none';">
              <span>⭐ এই পোস্টে রেটিং যুক্ত করুন</span>
            </label>
            <div id="ratingScoreFieldWrap" style="display: none; margin-top: 8px; padding: 10px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
              <label class="wp-label" style="font-size: 13px; margin-bottom: 4px;">রেটিং স্কোর (১.০ - ৫.০)</label>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 18px; color: #f59e0b;">★</span>
                <input type="number" name="rating_score" id="ratingScoreInput" class="wp-input" step="0.1" min="1.0" max="5.0" value="4.8" placeholder="যেমন: 4.8" style="font-weight: 700; width: 110px;">
                <span style="font-size: 13px; color: #64748b;">/ ৫.০</span>
              </div>
              <span style="font-size: 11.5px; color: #64748b; margin-top: 4px; display: block;">পোস্টে প্রদর্শিত সামগ্রিক রিভিউ রেটিং স্কোর।</span>
            </div>
          </div>

          <div class="wp-form-group">
            <label class="wp-checkbox-label">
              <input type="checkbox" name="is_featured" value="1">
              <span>প্রধান ফিচারে প্রদর্শন করুন</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Panel 2: ক্যাটাগরি -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>ক্যাটাগরি / বিভাগ *</span>
        </div>
        <div class="wp-inspector-body">
          <select name="category_id" class="wp-select" required size="6" style="height: auto;">
            <% if (categories && categories.length) { 
                 const rootCats = categories.filter(c => !c.parent_id || c.parent_id === 0);
                 rootCats.forEach(c => {
                   const children = categories.filter(child => child.parent_id === c.id);
            %>
              <option value="<%= c.id %>" style="font-weight: 700;"><%= c.name %></option>
              <% children.forEach(child => { %>
                <option value="<%= child.id %>">&nbsp;&nbsp;— <%= child.name %></option>
              <% }) %>
            <%   });
               } %>
          </select>
        </div>
      </div>

      <!-- Panel 3: ফিচার্ড ছবি -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>ফিচার্ড ছবি</span>
        </div>
        <div class="wp-inspector-body">
          <div class="payasti-image-dropzone" data-name="featured_image" data-prompt="ফিচার্ড ছবি ড্র্যাগ করে ছাড়ুন অথবা ক্লিক করুন" data-hint="ক্লিক করে মিডিয়া লাইব্রেরি থেকে ছবি বাছুন"></div>
        </div>
      </div>

      <!-- Panel 4: সারাংশ -->
      <div class="wp-inspector-card">
        <div class="wp-inspector-header">
          <span>উদ্ধৃতি / সারাংশ</span>
        </div>
        <div class="wp-inspector-body">
          <textarea name="excerpt" class="wp-input" rows="3" placeholder="পোস্টের সংক্ষিপ্ত সারাংশ লিখুন (ঐচ্ছিক)..." style="resize: vertical;"></textarea>
        </div>
      </div>

    </div>
  </div>

</form>

<!-- Official WordPress Gutenberg JS Dependencies (Local Fast Loading) -->
<script src="/vendor/gutenberg/react.min.js"></script>
<script src="/vendor/gutenberg/react-dom.min.js"></script>
<script src="/vendor/gutenberg/isolated-block-editor.js"></script>
<script src="/js/wp-smart-clipboard.js?v=2.5"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const textarea = document.getElementById('postContentInput');
    
    // Initialize Media Library hook
    if (window.initGutenbergMediaLibrary) {
      window.initGutenbergMediaLibrary();
    }

    // Attach Official WordPress Gutenberg Block Editor
    if (window.wp && window.wp.attachEditor) {
      window.wp.attachEditor(textarea, {
        iso: {
          moreMenu: false,
          toolbar: {
            inserter: true,
            undo: true,
            inspector: false,
            navigation: false,
            documentInspector: false,
            selectorTool: false
          }
        },
        editor: {
          hasFixedToolbar: false,
          hasInlineToolbar: true,
          mediaUpload: window.handleGutenbergMediaUpload
        }
      });

      // Safely dock Gutenberg tools into top header slot
      let attempts = 0;
      const dockInterval = setInterval(function() {
        attempts++;
        const tools = document.querySelector('.editor-document-tools') || document.querySelector('.edit-post-header__toolbar');
        const slot = document.getElementById('wpGutenbergToolsSlot');
        if (tools && slot && !slot.contains(tools)) {
          slot.appendChild(tools);
          clearInterval(dockInterval);
        }
        if (attempts > 30) clearInterval(dockInterval);
      }, 50);
    }

    // Initialize WordPress Smart Paste & Handlers
    if (window.setupWordPressSmartPaste) {
      window.setupWordPressSmartPaste('postTitleInput', 'postContentInput');
    }

    // Form Submission & Content Sync
    const form = document.getElementById('postForm');
    const submitBtn = document.getElementById('btnPublishPost');
    
    form.addEventListener('submit', function(e) {
      const title = document.getElementById('postTitleInput').value.trim();
      if (!title) {
        if (window.showToast) {
          window.showToast('⚠️ অনুগ্রহ করে পোস্টের শিরোনাম যোগ করুন।', 'error');
        } else {
          alert('অনুগ্রহ করে পোস্টের শিরোনাম যোগ করুন।');
        }
        document.getElementById('postTitleInput').focus();
        e.preventDefault();
        return false;
      }

      // Sync latest blocks to textarea before submission
      if (window.wp && window.wp.data) {
        try {
          const select = window.wp.data.select('core/block-editor');
          if (select && select.getBlocks && window.wp.blocks && window.wp.blocks.serialize) {
            const blocks = select.getBlocks();
            if (blocks && blocks.length > 0) {
              textarea.value = window.wp.blocks.serialize(blocks);
            }
          }
        } catch (err) {
          console.warn('Block serialization check:', err);
        }
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>সংরক্ষণ হচ্ছে... ⏳</span>';
      }
    });
  });
</script>

<%- include('partials/admin_layout_end') %>