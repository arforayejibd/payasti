<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof seo !== 'undefined' && seo.title ? seo.title : 'পয়স্তি এডমিন ড্যাশবোর্ড' %></title>
  
  <link rel="icon" href="/images/favicon-32x32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <meta name="theme-color" content="#0d1512">
  <meta name="robots" content="noindex, nofollow">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Dedicated Admin Stylesheet -->
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">

<div class="admin-layout">
  <!-- Mobile Sidebar Overlay Backdrop -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- Dedicated Admin Sidebar -->
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="admin-sidebar-header">
      <a href="/admin" class="admin-brand-link">
        <img src="/images/Payasti-logo.png" alt="পয়স্তি" class="admin-brand-logo">
        <div class="admin-brand-info">
          <span class="admin-brand-name">পয়স্তি ম্যাগাজিন</span>
          <span class="admin-brand-badge">মডারেশন এডমিন</span>
        </div>
      </a>
    </div>

    <!-- ৭টি মূল মেনু (সম্পূর্ণ বাংলায়) -->
    <ul class="admin-sidebar-nav">
      <!-- ১. ড্যাশবোর্ড -->
      <li class="admin-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'admin_dashboard' ? 'active' : '' %>">
        <a href="/admin">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>ড্যাশবোর্ড</span>
          </div>
        </a>
      </li>

      <!-- ২. পোস্ট (সাবমেনু: সকল লেখা, নতুন পোস্ট, পেন্ডিং, ক্যাটাগরি, ট্যাগ) -->
      <% 
        const isPostsGroup = typeof activeMenu !== 'undefined' && (
          activeMenu === 'all_posts' || 
          activeMenu === 'new_post' || 
          activeMenu === 'pending_posts' || 
          activeMenu === 'posts_categories' || 
          activeMenu === 'posts_tags'
        );
      %>
      <li class="admin-nav-item has-submenu <%= isPostsGroup ? 'open' : '' %>">
        <a href="javascript:void(0)" class="menu-toggle" role="button" aria-expanded="<%= isPostsGroup ? 'true' : 'false' %>">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>পোস্ট</span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <% if (typeof adminPendingCount !== 'undefined' && adminPendingCount > 0) { %>
              <span class="admin-nav-badge"><%= toBengaliNumber(adminPendingCount) %></span>
            <% } %>
            <svg class="submenu-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </a>
        <ul class="admin-submenu">
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'all_posts' ? 'active' : '' %>">
            <a href="/admin/posts">সকল লেখা</a>
          </li>
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'new_post' ? 'active' : '' %>">
            <a href="/admin/posts/new">নতুন পোস্ট</a>
          </li>
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'pending_posts' ? 'active' : '' %>">
            <a href="/admin/pending">
              <span>পেন্ডিং অনুমোদন</span>
              <% if (typeof adminPendingCount !== 'undefined' && adminPendingCount > 0) { %>
                <span class="admin-nav-badge" style="font-size: 13px; padding: 2px 7px;"><%= toBengaliNumber(adminPendingCount) %></span>
              <% } %>
            </a>
          </li>
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'posts_categories' ? 'active' : '' %>">
            <a href="/admin/categories">ক্যাটাগরি</a>
          </li>
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'posts_tags' ? 'active' : '' %>">
            <a href="/admin/tags">ট্যাগ</a>
          </li>
        </ul>
      </li>

      <!-- ৩. মিডিয়া -->
      <li class="admin-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'media' ? 'active' : '' %>">
        <a href="/admin/media">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span>মিডিয়া</span>
          </div>
        </a>
      </li>

      <!-- ৪. মন্তব্য -->
      <li class="admin-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'comments' ? 'active' : '' %>">
        <a href="/admin/comments">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>মন্তব্য</span>
          </div>
        </a>
      </li>

      <!-- ৫. বই সম্ভার (সাবমেনু: সকল বই, নতুন বই) -->
      <% 
        const isBooksGroup = typeof activeMenu !== 'undefined' && activeMenu === 'manage_books';
      %>
      <li class="admin-nav-item has-submenu <%= isBooksGroup ? 'open' : '' %>">
        <a href="javascript:void(0)" class="menu-toggle" role="button" aria-expanded="<%= isBooksGroup ? 'true' : 'false' %>">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <span>বই</span>
          </div>
          <svg class="submenu-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <ul class="admin-submenu">
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'manage_books' ? 'active' : '' %>">
            <a href="/admin/books">সকল বই</a>
          </li>
          <li class="admin-submenu-item">
            <a href="/admin/books#add-book">নতুন বই যোগ করুন</a>
          </li>
        </ul>
      </li>

      <!-- ৬. ইউজার ও লেখক (সাবমেনু: সকল ইউজার, নতুন লেখক, প্রোফাইল) -->
      <% 
        const isUsersGroup = typeof activeMenu !== 'undefined' && (activeMenu === 'manage_users' || activeMenu === 'user_profile');
      %>
      <li class="admin-nav-item has-submenu <%= isUsersGroup ? 'open' : '' %>">
        <a href="javascript:void(0)" class="menu-toggle" role="button" aria-expanded="<%= isUsersGroup ? 'true' : 'false' %>">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span>ইউজার</span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <% if (typeof adminPendingUsersCount !== 'undefined' && adminPendingUsersCount > 0) { %>
              <span class="admin-nav-badge"><%= toBengaliNumber(adminPendingUsersCount) %></span>
            <% } %>
            <svg class="submenu-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </a>
        <ul class="admin-submenu">
          <li class="admin-submenu-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'manage_users' ? 'active' : '' %>">
            <a href="/admin/users">সকল ইউজার</a>
          </li>
          <li class="admin-submenu-item">
            <a href="/admin/users?status=pending_approval">
              <span>পেন্ডিং অনুমোদন</span>
              <% if (typeof adminPendingUsersCount !== 'undefined' && adminPendingUsersCount > 0) { %>
                <span class="admin-nav-badge" style="font-size: 13px; padding: 2px 7px;"><%= toBengaliNumber(adminPendingUsersCount) %></span>
              <% } %>
            </a>
          </li>
          <li class="admin-submenu-item">
            <a href="/admin/users/new">নতুন লেখক</a>
          </li>
          <% if (typeof user !== 'undefined' && user) { %>
            <li class="admin-submenu-item">
              <a href="/admin/users/<%= user.id %>/edit">আপনার প্রোফাইল</a>
            </li>
          <% } %>
        </ul>
      </li>

      <!-- ৭. মেনু ব্যবস্থাপনা -->
      <li class="admin-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'menu' ? 'active' : '' %>">
        <a href="/admin/menu">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <span>মেনু</span>
          </div>
        </a>
      </li>

      <!-- ৮. সেটিংস -->
      <li class="admin-nav-item <%= typeof activeMenu !== 'undefined' && activeMenu === 'settings' ? 'active' : '' %>">
        <a href="/admin/settings">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span>সেটিংস</span>
          </div>
        </a>
      </li>

      <li class="admin-nav-section-title" style="margin-top: 14px;">সাইট অ্যাকশন</li>

      <li class="admin-nav-item">
        <a href="/" target="_blank" rel="noopener">
          <div class="admin-nav-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>ওয়েবসাইট দেখুন</span>
          </div>
          <span style="font-size: 15px; opacity: 0.6;">&nearr;</span>
        </a>
      </li>
    </ul>

    <!-- Admin User Info & Logout -->
    <div class="admin-sidebar-footer">
      <div class="admin-user-pill">
        <div class="admin-user-left">
          <% if (typeof user !== 'undefined' && user && user.avatar) { %>
            <img src="<%= user.avatar %>" alt="<%= user.display_name %>" class="admin-avatar">
          <% } else { %>
            <div class="admin-avatar">
              <%= typeof user !== 'undefined' && user && user.display_name ? user.display_name.charAt(0) : 'প' %>
            </div>
          <% } %>
          <div class="admin-user-meta">
            <span class="admin-user-name"><%= typeof user !== 'undefined' && user && user.display_name ? user.display_name : 'অ্যাডমিনিস্ট্রেটর' %></span>
            <span class="admin-user-role">
              <%= typeof user !== 'undefined' && user && user.role === 'admin' ? '🛡️ প্রধান এডমিন' : 'মডারেটর' %>
            </span>
          </div>
        </div>
        <a href="/logout" class="admin-logout-link" title="লগআউট করুন">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
      </div>
    </div>
  </aside>

  <!-- Main Wrapper -->
  <div class="admin-main-wrapper">
    <!-- Topbar -->
    <header class="admin-topbar">
      <div class="admin-topbar-left">
        <button class="admin-mobile-toggle" id="adminSidebarToggle" aria-label="মেনু খুলুন">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div class="admin-page-title-group">
          <div class="admin-breadcrumbs">
            <a href="/admin">পয়স্তি এডমিন</a>
            <span>/</span>
            <span><%= typeof pageBreadcrumb !== 'undefined' ? pageBreadcrumb : 'মডারেশন প্যানেল' %></span>
          </div>
          <h1 class="admin-page-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'এডমিন ড্যাশবোর্ড' %></h1>
        </div>
      </div>

      <div class="admin-topbar-actions">
        <a href="/" target="_blank" class="btn-view-site" title="মূল ওয়েবসাইট দেখুন">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>ওয়েবসাইট দেখুন</span>
        </a>

        <% if (typeof topbarButton !== 'undefined' && topbarButton) { %>
          <a href="<%= topbarButton.url %>" class="btn-new-action">
            <%= topbarButton.text %>
          </a>
        <% } %>
      </div>
    </header>

    <!-- Page Content Container -->
    <main class="admin-content">
