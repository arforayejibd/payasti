<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= seo && seo.title ? seo.title : 'পাসওয়ার্ড পুনরুদ্ধার | পয়স্তি ম্যাগাজিন' %></title>
  
  <link rel="icon" href="/images/favicon-32x32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <meta name="theme-color" content="#075603">
  <meta name="robots" content="noindex, nofollow">

  <!-- Google Fonts & Custom Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    @font-face {
      font-family: 'Kalpurush';
      src: url('/fonts/kalpurush.woff2') format('woff2');
      font-display: swap;
    }
    @font-face {
      font-family: 'payasti_uni';
      src: url('/fonts/kalpurush.woff2') format('woff2');
      font-display: swap;
    }

    :root {
      --primary: #068200;
      --primary-hover: #056800;
      --primary-light: #f0ffef;
      --accent: #068200;
      --text-main: #1f2937;
      --text-muted: #6b7280;
      --border-color: #e5e7eb;
      --bg-color: #f9fafb;
      --card-bg: #ffffff;
      --font-family: 'Kalpurush', 'payasti_uni', 'Hind Siliguri', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: var(--font-family);
      font-feature-settings: "ss01" 1;
      -webkit-font-feature-settings: "ss01" 1;
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 10% 20%, #f0f7ef 0%, #fcfdfc 45%, #eaf4e9 95%);
      color: var(--text-main);
      padding: 24px 16px;
      position: relative;
      overflow-x: hidden;
      font-size: 18px;
    }

    body::before {
      content: '';
      position: absolute;
      width: 450px;
      height: 450px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(7, 86, 3, 0.07) 0%, rgba(255,255,255,0) 70%);
      top: -100px;
      right: -100px;
      z-index: 0;
      pointer-events: none;
    }

    body::after {
      content: '';
      position: absolute;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(6, 130, 0, 0.05) 0%, rgba(255,255,255,0) 70%);
      bottom: -100px;
      left: -100px;
      z-index: 0;
      pointer-events: none;
    }

    .auth-container {
      width: 100%;
      max-width: 480px;
      position: relative;
      z-index: 1;
      animation: fadeIn 0.4s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .brand-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .brand-logo-link {
      display: inline-block;
      text-decoration: none;
      transition: transform 0.2s ease;
    }

    .brand-logo-link:hover {
      transform: scale(1.02);
    }

    .brand-logo {
      height: 64px;
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 2px 8px rgba(7, 86, 3, 0.12));
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      padding: 4px 14px;
      background: rgba(7, 86, 3, 0.08);
      color: var(--primary);
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.2px;
      border: 1px solid rgba(7, 86, 3, 0.15);
    }

    .auth-card {
      background: var(--card-bg);
      border-radius: 18px;
      padding: 38px 32px;
      box-shadow: 0 10px 35px -5px rgba(0, 0, 0, 0.07), 0 0 0 1px rgba(7, 86, 3, 0.08);
      backdrop-filter: blur(8px);
    }

    .card-title-group {
      text-align: center;
      margin-bottom: 26px;
    }

    .card-title {
      font-size: 27px;
      font-weight: 700;
      color: #111827;
      margin-bottom: 8px;
      letter-spacing: -0.3px;
    }

    .card-subtitle {
      font-size: 17px;
      color: var(--text-muted);
      line-height: 1.55;
    }

    .alert-error {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #b91c1c;
      padding: 14px 16px;
      border-radius: 10px;
      font-size: 16px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      gap: 10px;
      line-height: 1.4;
    }

    .alert-error svg {
      flex-shrink: 0;
      width: 18px;
      height: 18px;
    }

    .alert-success {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #15803d;
      padding: 16px 18px;
      border-radius: 10px;
      font-size: 16px;
      margin-bottom: 24px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      line-height: 1.5;
    }

    .alert-success svg {
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      margin-top: 2px;
    }

    .form-group {
      margin-bottom: 22px;
    }

    .form-label {
      display: block;
      font-size: 18px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 8px;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon {
      position: absolute;
      left: 14px;
      width: 20px;
      height: 20px;
      color: #9ca3af;
      pointer-events: none;
      transition: color 0.2s;
    }

    .form-control {
      width: 100%;
      height: 50px;
      padding: 10px 14px 10px 44px;
      border: 1.5px solid var(--border-color);
      border-radius: 10px;
      font-size: 18px;
      color: var(--text-main);
      background-color: #f9fafb;
      transition: all 0.2s ease;
      outline: none;
    }

    .form-control:focus {
      border-color: var(--primary);
      background-color: #ffffff;
      box-shadow: 0 0 0 3.5px rgba(7, 86, 3, 0.12);
    }

    .form-control:focus + .input-icon,
    .form-control:focus ~ .input-icon {
      color: var(--primary);
    }

    .form-control::placeholder {
      color: #9ca3af;
      font-size: 16px;
    }

    .btn-submit {
      width: 100%;
      height: 50px;
      background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      font-size: 19px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(7, 86, 3, 0.25);
      transition: all 0.25s ease;
      margin-top: 8px;
    }

    .btn-submit:hover {
      background: linear-gradient(135deg, var(--primary-hover) 0%, #056a00 100%);
      box-shadow: 0 6px 18px rgba(7, 86, 3, 0.35);
      transform: translateY(-1px);
    }

    .btn-submit:active {
      transform: translateY(0);
      box-shadow: 0 2px 8px rgba(7, 86, 3, 0.2);
    }

    .btn-submit svg {
      width: 20px;
      height: 20px;
      transition: transform 0.2s;
    }

    .btn-submit:hover svg {
      transform: translateX(3px);
    }

    .auth-card-footer {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #f3f4f6;
      text-align: center;
      font-size: 17px;
      color: var(--text-muted);
    }

    .auth-card-footer a {
      color: var(--primary);
      font-weight: 600;
      text-decoration: none;
      transition: color 0.2s;
    }

    .auth-card-footer a:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .back-home-wrap {
      text-align: center;
      margin-top: 24px;
    }

    .back-home-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #4b5563;
      text-decoration: none;
      font-size: 16px;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.6);
      border: 1px solid rgba(0, 0, 0, 0.05);
      transition: all 0.2s ease;
    }

    .back-home-link:hover {
      color: var(--primary);
      background: #ffffff;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      transform: translateY(-1px);
    }

    .back-home-link svg {
      width: 16px;
      height: 16px;
      transition: transform 0.2s ease;
    }

    .back-home-link:hover svg {
      transform: translateX(-3px);
    }

    .copyright-note {
      text-align: center;
      margin-top: 28px;
      font-size: 15px;
      color: #9ca3af;
      line-height: 1.5;
    }

    @media (max-width: 480px) {
      .auth-card {
        padding: 28px 20px;
        border-radius: 14px;
      }
      .brand-logo {
        height: 54px;
      }
      .card-title {
        font-size: 24px;
      }
      .card-subtitle {
        font-size: 16px;
      }
      .form-label {
        font-size: 17px;
      }
      .form-control {
        font-size: 17px;
      }
      .btn-submit {
        font-size: 18px;
      }
    }
  </style>
</head>
<body>

  <div class="auth-container">
    <!-- Brand Header -->
    <div class="brand-header">
      <a href="/" class="brand-logo-link" title="পয়স্তি হোমপেজ">
        <img src="/images/Payasti-logo.png" alt="পয়স্তি ম্যাগাজিন" class="brand-logo">
      </a>
      <div>
        <span class="brand-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          অ্যাকাউন্ট নিরাপত্তা ও পুনরুদ্ধার
        </span>
      </div>
    </div>

    <!-- Card -->
    <div class="auth-card">
      <div class="card-title-group">
        <h1 class="card-title">পাসওয়ার্ড পুনরুদ্ধার</h1>
        <p class="card-subtitle">আপনার নিবন্ধিত ইউজারনেম বা ইমেইল দিন। আমরা পাসওয়ার্ড রিসেট করার লিংক পাঠাব।</p>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert-success" role="alert">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <div><%= success %></div>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error" role="alert">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/forgot-password" method="POST">
        <div class="form-group">
          <label class="form-label" for="identity">ইউজারনেম বা ইমেইল ঠিকানা</label>
          <div class="input-wrapper">
            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <input 
              type="text" 
              id="identity"
              name="identity" 
              class="form-control" 
              required 
              autofocus
              value="<%= typeof identity !== 'undefined' ? identity : '' %>"
              placeholder="আপনার ইউজারনেম বা ইমেইল দিন"
            >
          </div>
        </div>

        <button type="submit" class="btn-submit">
          <span>রিসেট লিংক পাঠান</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </form>

      <div class="auth-card-footer">
        পাসওয়ার্ড মনে পড়েছে? 
        <a href="/login">← অ্যাকাউন্টে লগইন করুন</a>
      </div>
    </div>

    <!-- Back to Website -->
    <div class="back-home-wrap">
      <a href="/" class="back-home-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>মূল ওয়েবসাইটে ফিরে যান</span>
      </a>
    </div>

    <div class="copyright-note">
      পয়স্তি সাহিত্য ম্যাগাজিন — সাহিত্য ও চিন্তার সম্মিলন
    </div>
  </div>

</body>
</html>
