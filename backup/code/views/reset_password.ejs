<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= seo && seo.title ? seo.title : 'নতুন পাসওয়ার্ড নির্ধারণ | পয়স্তি ম্যাগাজিন' %></title>
  
  <link rel="icon" href="/images/favicon-32x32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <meta name="theme-color" content="#075603">
  <meta name="robots" content="noindex, nofollow">

  <!-- Google Fonts & Custom Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    @font-face {
      font-family: 'Kalpurush';
      src: url('/fonts/kalpurush.woff2') format('woff2');
      font-display: swap;
    }
    @font-face {
      font-family: 'payasti_uni';
      src: url('/fonts/kalpurush.woff2') format('woff2');
      font-display: swap;
    }
    :root {
      --primary: #068200;
      --primary-hover: #056800;
      --primary-light: #f0ffef;
      --accent: #068200;
      --text-main: #1f2937;
      --text-muted: #6b7280;
      --border-color: #e5e7eb;
      --bg-color: #f9fafb;
      --card-bg: #ffffff;
      --font-family: 'Kalpurush', 'payasti_uni', 'Hind Siliguri', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: var(--font-family);
      font-feature-settings: "ss01" 1;
      -webkit-font-feature-settings: "ss01" 1;
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 10% 20%, #f0f7ef 0%, #fcfdfc 45%, #eaf4e9 95%);
      color: var(--text-main);
      padding: 24px 16px;
      position: relative;
      overflow-x: hidden;
      font-size: 18px;
    }

    body::before {
      content: '';
      position: absolute;
      width: 450px;
      height: 450px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(7, 86, 3, 0.07) 0%, rgba(255,255,255,0) 70%);
      top: -100px;
      right: -100px;
      z-index: 0;
      pointer-events: none;
    }

    body::after {
      content: '';
      position: absolute;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(6, 130, 0, 0.05) 0%, rgba(255,255,255,0) 70%);
      bottom: -100px;
      left: -100px;
      z-index: 0;
      pointer-events: none;
    }

    .auth-container {
      width: 100%;
      max-width: 480px;
      position: relative;
      z-index: 1;
      animation: fadeIn 0.4s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .brand-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .brand-logo-link {
      display: inline-block;
      text-decoration: none;
      transition: transform 0.2s ease;
    }

    .brand-logo-link:hover {
      transform: scale(1.02);
    }

    .brand-logo {
      height: 64px;
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 2px 8px rgba(7, 86, 3, 0.12));
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      padding: 4px 14px;
      background: rgba(7, 86, 3, 0.08);
      color: var(--primary);
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.2px;
      border: 1px solid rgba(7, 86, 3, 0.15);
    }

    .auth-card {
      background: var(--card-bg);
      border-radius: 18px;
      padding: 38px 32px;
      box-shadow: 0 10px 35px -5px rgba(0, 0, 0, 0.07), 0 0 0 1px rgba(7, 86, 3, 0.08);
      backdrop-filter: blur(8px);
    }

    .card-title-group {
      text-align: center;
      margin-bottom: 26px;
    }

    .card-title {
      font-size: 27px;
      font-weight: 700;
      color: #111827;
      margin-bottom: 8px;
      letter-spacing: -0.3px;
    }

    .card-subtitle {
      font-size: 17px;
      color: var(--text-muted);
      line-height: 1.55;
    }

    .alert-error {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #b91c1c;
      padding: 14px 16px;
      border-radius: 10px;
      font-size: 16px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      gap: 10px;
      line-height: 1.4;
    }

    .alert-error svg {
      flex-shrink: 0;
      width: 18px;
      height: 18px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-size: 18px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 8px;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon {
      position: absolute;
      left: 14px;
      width: 20px;
      height: 20px;
      color: #9ca3af;
      pointer-events: none;
      transition: color 0.2s;
    }

    .form-control {
      width: 100%;
      height: 50px;
      padding: 10px 48px 10px 44px;
      border: 1.5px solid var(--border-color);
      border-radius: 10px;
      font-size: 18px;
      color: var(--text-main);
      background-color: #f9fafb;
      transition: all 0.2s ease;
      outline: none;
    }

    .form-control:focus {
      border-color: var(--primary);
      background-color: #ffffff;
      box-shadow: 0 0 0 3.5px rgba(7, 86, 3, 0.12);
    }

    .form-control:focus + .input-icon,
    .form-control:focus ~ .input-icon {
      color: var(--primary);
    }

    .password-toggle {
      position: absolute;
      right: 14px;
      background: none;
      border: none;
      color: #9ca3af;
      cursor: pointer;
      padding: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s;
    }

    .password-toggle:hover {
      color: #4b5563;
    }

    .btn-submit {
      width: 100%;
      height: 50px;
      background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      font-size: 19px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(7, 86, 3, 0.25);
      transition: all 0.25s ease;
      margin-top: 10px;
    }

    .btn-submit:hover {
      background: linear-gradient(135deg, var(--primary-hover) 0%, #056a00 100%);
      box-shadow: 0 6px 18px rgba(7, 86, 3, 0.35);
      transform: translateY(-1px);
    }

    .btn-submit:active {
      transform: translateY(0);
      box-shadow: 0 2px 8px rgba(7, 86, 3, 0.2);
    }

    .btn-submit svg {
      width: 20px;
      height: 20px;
      transition: transform 0.2s;
    }

    .btn-submit:hover svg {
      transform: translateX(3px);
    }

    .invalid-token-box {
      text-align: center;
      padding: 10px 0;
    }

    .invalid-token-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 16px;
      color: #dc2626;
      background: #fee2e2;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .invalid-token-icon svg {
      width: 32px;
      height: 32px;
    }

    .auth-card-footer {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #f3f4f6;
      text-align: center;
      font-size: 17px;
      color: var(--text-muted);
    }

    .auth-card-footer a {
      color: var(--primary);
      font-weight: 600;
      text-decoration: none;
      transition: color 0.2s;
    }

    .auth-card-footer a:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .back-home-wrap {
      text-align: center;
      margin-top: 24px;
    }

    .back-home-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #4b5563;
      text-decoration: none;
      font-size: 16px;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.6);
      border: 1px solid rgba(0, 0, 0, 0.05);
      transition: all 0.2s ease;
    }

    .back-home-link:hover {
      color: var(--primary);
      background: #ffffff;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      transform: translateY(-1px);
    }

    .back-home-link svg {
      width: 16px;
      height: 16px;
      transition: transform 0.2s ease;
    }

    .copyright-note {
      text-align: center;
      margin-top: 28px;
      font-size: 15px;
      color: #9ca3af;
      line-height: 1.5;
    }

    @media (max-width: 480px) {
      .auth-card {
        padding: 28px 20px;
        border-radius: 14px;
      }
      .card-title {
        font-size: 24px;
      }
      .card-subtitle {
        font-size: 16px;
      }
      .form-label {
        font-size: 17px;
      }
      .form-control {
        font-size: 17px;
      }
      .btn-submit {
        font-size: 18px;
      }
    }
  </style>
</head>
<body>

  <div class="auth-container">
    <!-- Brand Header -->
    <div class="brand-header">
      <a href="/" class="brand-logo-link" title="পয়স্তি হোমপেজ">
        <img src="/images/Payasti-logo.png" alt="পয়স্তি ম্যাগাজিন" class="brand-logo">
      </a>
      <div>
        <span class="brand-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          নতুন পাসওয়ার্ড তৈরি
        </span>
      </div>
    </div>

    <!-- Card -->
    <div class="auth-card">
      <% if (!validToken) { %>
        <!-- Invalid or Expired Token State -->
        <div class="invalid-token-box">
          <div class="invalid-token-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <h1 class="card-title" style="font-size: 24px; color: #b91c1c;">লিংকটি কার্যকর নয়</h1>
          <p class="card-subtitle" style="margin: 10px 0 24px;">
            <%= typeof error !== 'undefined' && error ? error : 'পাসওয়ার্ড রিসেট লিংকটি মেয়াদোত্তীর্ণ বা পূর্বে ব্যবহৃত হয়েছে।' %>
          </p>

          <a href="/forgot-password" class="btn-submit" style="text-decoration: none;">
            <span>নতুন রিসেট লিংক পাঠান</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        </div>
      <% } else { %>
        <!-- Valid Token Form -->
        <div class="card-title-group">
          <h1 class="card-title">নতুন পাসওয়ার্ড দিন</h1>
          <p class="card-subtitle">আপনার অ্যাকাউন্টের জন্য নতুন ও শক্তিশালী পাসওয়ার্ড নির্ধারণ করুন।</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert-error" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/reset-password" method="POST">
          <input type="hidden" name="token" value="<%= token %>">

          <div class="form-group">
            <label class="form-label" for="password">নতুন পাসওয়ার্ড</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <input 
                type="password" 
                id="password"
                name="password" 
                class="form-control" 
                required 
                minlength="6"
                placeholder="কমপক্ষে ৬টি অক্ষর দিন"
              >
              <button type="button" class="password-toggle" id="togglePasswordBtn1" aria-label="পাসওয়ার্ড দেখুন বা লুকান">
                <svg id="eyeIcon1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="confirm_password">পাসওয়ার্ড নিশ্চিত করুন</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <input 
                type="password" 
                id="confirm_password"
                name="confirm_password" 
                class="form-control" 
                required 
                minlength="6"
                placeholder="একই পাসওয়ার্ড পুনরায় লিখুন"
              >
              <button type="button" class="password-toggle" id="togglePasswordBtn2" aria-label="পাসওয়ার্ড দেখুন বা লুকান">
                <svg id="eyeIcon2" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" class="btn-submit">
            <span>পাসওয়ার্ড পরিবর্তন করুন</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </form>
      <% } %>

      <div class="auth-card-footer">
        লগইন করতে চান? 
        <a href="/login">← অ্যাকাউন্টে ফিরে যান</a>
      </div>
    </div>

    <!-- Back to Website -->
    <div class="back-home-wrap">
      <a href="/" class="back-home-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>মূল ওয়েবসাইটে ফিরে যান</span>
      </a>
    </div>

    <div class="copyright-note">
      পয়স্তি সাহিত্য ম্যাগাজিন — সাহিত্য ও চিন্তার সম্মিলন
    </div>
  </div>

  <script>
    function setupToggle(btnId, inputId, iconId) {
      const btn = document.getElementById(btnId);
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);
      if (!btn || !input || !icon) return;

      btn.addEventListener('click', function() {
        const isPassword = input.getAttribute('type') === 'password';
        input.setAttribute('type', isPassword ? 'text' : 'password');
        if (isPassword) {
          icon.innerHTML = `
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
            <line x1="1" y1="1" x2="23" y2="23"></line>
          `;
        } else {
          icon.innerHTML = `
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          `;
        }
      });
    }

    setupToggle('togglePasswordBtn1', 'password', 'eyeIcon1');
    setupToggle('togglePasswordBtn2', 'confirm_password', 'eyeIcon2');
  </script>

</body>
</html>
