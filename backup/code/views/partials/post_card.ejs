<article class="affiliate-post-card">
  <!-- Image Container -->
  <% if (post.featured_image) { %>
    <div class="affiliate-card-media">
      <a href="/post/<%= encodeURIComponent(post.slug || '') %>" style="display: block; width: 100%; height: 100%;">
        <img 
          src="<%= post.featured_image %>" 
          alt="<%= post.title %>" 
          class="affiliate-card-img"
          loading="lazy"
        >
      </a>
      
      <!-- Category Badge Over Image -->
      <% if (post.category_name) { %>
        <a href="/category/<%= encodeURIComponent(post.category_slug || '') %>" class="affiliate-card-cat-badge">
          <%= post.category_name %>
        </a>
      <% } %>
      
      <!-- Star Rating Badge -->
      <% if (Number(post.rating_score || 0) > 0) { %>
        <div class="affiliate-card-score-badge">
          <span>★</span>
          <span><%= toBengaliNumber(parseFloat(post.rating_score).toFixed(1)) %></span>
        </div>
      <% } %>
    </div>
  <% } %>

  <div class="affiliate-card-content">
    <div>
      <% if (!post.featured_image && post.category_name) { %>
        <div style="margin-bottom: 10px;">
          <a href="/category/<%= encodeURIComponent(post.category_slug || '') %>" class="category-pill-item" style="font-size: 13px; padding: 3px 10px;">
            <%= post.category_name %>
          </a>
        </div>
      <% } %>

      <!-- Title -->
      <h3 class="affiliate-card-title">
        <a href="/post/<%= encodeURIComponent(post.slug || '') %>" title="<%= post.title %>">
          <%= post.title %>
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="affiliate-card-excerpt">
        <%- formatCardExcerpt(post.content || post.excerpt, 20, 3) %>
      </p>
    </div>

    <!-- Meta Footer -->
    <div class="affiliate-card-footer">
      <span>
        📅 <%= formatBengaliDate(post.published_at || post.created_at) %>
      </span>

      <a href="/post/<%= encodeURIComponent(post.slug || '') %>" class="affiliate-card-btn">
        <span>বিস্তারিত পড়ুন</span>
        <span>&raquo;</span>
      </a>
    </div>
  </div>
</article>
