<div class="book-card">
  <% const bookLink = book.order_url || `/book/${encodeURIComponent(book.slug)}`; %>
  <a href="<%= bookLink %>" <%= book.order_url ? 'target="_blank" rel="noopener noreferrer"' : '' %> class="book-card-link" title="<%= book.title %>">
    <div class="book-cover-wrap">
      <% if (book.cover_image) { %>
        <img src="<%= book.cover_image %>" alt="<%= book.title %>" class="book-cover-img" loading="lazy">
      <% } else { %>
        <div class="book-cover-placeholder">📖</div>
      <% } %>
    </div>
    <div class="book-card-details">
      <div class="book-card-author"><%= book.author_name %></div>
      <div class="book-card-title"><%= book.title %></div>
      <div class="book-card-pricing">
        <% if (book.regular_price && book.discounted_price && book.regular_price !== book.discounted_price) { %>
          <span class="book-price-regular"><%= book.regular_price %></span>
        <% } %>
        <span class="book-price-final"><%= book.discounted_price || book.regular_price %></span>
      </div>
    </div>
  </a>
</div>
