<%- include('partials/header') %>

<main class="page-main-content single-book-page-bg">
  <div class="site-container" style="max-width: 1040px; margin: 30px auto; padding: 0 16px;">
    
    <!-- Breadcrumb -->
    <nav class="book-breadcrumb" style="margin-bottom: 24px; font-size: 14px; color: var(--text-muted);">
      <a href="/" style="color: var(--text-muted); text-decoration: none;">প্রচ্ছদ</a>
      <span style="margin: 0 8px;">/</span>
      <a href="/books" style="color: var(--text-muted); text-decoration: none;">বই সম্ভার</a>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--text-primary); font-weight: 600;"><%= book.title %></span>
    </nav>

    <div class="single-book-card-wrap" style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 36px 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); display: grid; grid-template-columns: 320px 1fr; gap: 40px; align-items: start;">
      <!-- Book Cover Area -->
      <div class="single-book-cover-wrap" style="text-align: center;">
        <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 10px; padding: 14px; display: inline-block; width: 100%; box-shadow: 0 8px 24px rgba(0,0,0,0.06);">
          <% if (book.cover_image) { %>
            <img src="<%= book.cover_image %>" alt="<%= book.title %>" style="width: 100%; border-radius: 6px; display: block; object-fit: cover;">
          <% } else { %>
            <div style="font-size: 72px; padding: 70px 0; color: var(--text-muted);">📖</div>
          <% } %>
        </div>

        <!-- Social Share for Book -->
        <div style="margin-top: 20px; display: flex; align-items: center; justify-content: center; gap: 10px;">
          <span style="font-size: 13px; color: var(--text-muted);">শেয়ার:</span>
          <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(seo.canonical || '') %>" target="_blank" rel="noopener noreferrer" class="social-share-button social-share-button-fb" title="ফেসবুকে শেয়ার করুন" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: #1877f2; color: #fff;">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" width="13" height="13" fill="currentColor"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
          </a>
          <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(book.title) %>&url=<%= encodeURIComponent(seo.canonical || '') %>" target="_blank" rel="noopener noreferrer" class="social-share-button social-share-button-twitter" title="টুইটারে শেয়ার করুন" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: #000; color: #fff;">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="13" height="13" fill="currentColor"><path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z"/></svg>
          </a>
        </div>
      </div>

      <!-- Book Info & Pricing -->
      <div class="single-book-details">
        <div style="display: inline-block; background: rgba(6, 130, 0, 0.08); color: var(--accent-primary); border: 1px solid rgba(6, 130, 0, 0.2); padding: 5px 14px; border-radius: 20px; font-size: 14.5px; font-weight: 600; margin-bottom: 12px;">
          পয়স্তি প্রকাশন
        </div>
        <h1 style="font-size: 34px; font-weight: 800; color: var(--text-primary); margin: 0 0 10px 0; line-height: 1.3;"><%= book.title %></h1>
        <div style="font-size: 19px; font-weight: 500; color: var(--text-secondary); margin-bottom: 20px;">
          লেখক: <strong style="color: var(--accent-primary); font-weight: 700;"><%= book.author_name %></strong>
        </div>

        <!-- Price Card -->
        <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 10px; padding: 16px 20px; margin-bottom: 24px; display: flex; align-items: baseline; gap: 14px;">
          <% if (book.discounted_price) { %>
            <span style="font-size: 28px; font-weight: 800; color: var(--text-primary);"><%= book.discounted_price %></span>
          <% } %>
          <% if (book.regular_price) { %>
            <span style="font-size: 18px; color: var(--text-muted); text-decoration: line-through;"><%= book.regular_price %></span>
          <% } %>
          <span style="font-size: 14px; color: #16a34a; font-weight: 700; background: #dcfce7; padding: 3px 10px; border-radius: 4px;">সুলভ সাহিত্য সংস্করণ</span>
        </div>

        <!-- Description -->
        <div style="margin-bottom: 28px;">
          <h3 style="font-size: 20px; font-weight: 700; color: var(--text-primary); margin-bottom: 10px;">বইয়ের পরিচিতি:</h3>
          <div style="font-size: 18px; font-weight: 500; color: var(--text-secondary); line-height: 1.95; white-space: pre-line;">
            <%= book.description || `${book.author_name} রচিত '${book.title}' গ্রন্থটি পয়েন্টস্তির বিশেষ নিবেদন। সাহিত্যপ্রেমী পাঠকদের জন্য এটি একটি অনবদ্য প্রকাশনা।` %>
          </div>
        </div>

        <!-- Buy / Order CTA -->
        <div class="book-action-buttons">
          <% if (book.order_url) { %>
            <a href="<%= book.order_url %>" target="_blank" rel="noopener noreferrer" class="btn-primary-order" style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--accent-primary); color: #ffffff; padding: 14px 32px; border-radius: 8px; font-size: 17px; font-weight: 600; text-decoration: none; box-shadow: 0 4px 14px rgba(6,130,0,0.25); transition: all 0.2s ease;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              বইটি অর্ডার করুন
            </a>
          <% } else { %>
            <button type="button" disabled style="background: var(--text-muted); color: #fff; padding: 12px 24px; border: none; border-radius: 8px; font-size: 16px; cursor: not-allowed;">
              শীঘ্রই পাওয়া যাবে
            </button>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Other Books Section -->
  <% if (otherBooks && otherBooks.length) { %>
    <section class="site-section books-section" style="max-width: 1040px; margin: 40px auto 60px; padding: 0 16px;">
      <div class="section-heading-bar" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
        <h2 class="section-title" style="margin: 0; font-size: 22px; color: var(--text-primary);">পয়স্তি প্রকাশনের অন্যান্য বই</h2>
        <a href="/books" class="books-heading-link" style="font-size: 15px; color: var(--accent-primary); text-decoration: none; font-weight: 600;">সকল বই দেখুন »</a>
      </div>
      <div class="books-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px;">
        <% otherBooks.forEach(b => { %>
          <div class="grid-book-card-item">
            <%- include('partials/book_card', { book: b }) %>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</main>

<%- include('partials/footer') %>
