            font-weight: bold;
        }
        .custom-registration-form input[type="text"],
        .custom-registration-form input[type="email"],
        .custom-registration-form input[type="password"] {
            width: 100%;
            padding: 8px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 3px;
        }
        .custom-registration-form input[type="submit"] {
            background: #0073aa;
            color: white;
            border: none;
            padding: 10px 15px;
            cursor: pointer;
            border-radius: 3px;
        }
        .custom-registration-form input[type="submit"]:hover {
            background: #005177;
        }
        .registration-errors {
            color: red;
            margin-bottom: 15px;
        }
        .registration-success {
            color: green;
            margin-bottom: 15px;
            font-weight: bold;
        }
    </style>
